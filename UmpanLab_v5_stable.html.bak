/* release gate: T1 / Golden / Released need sign-off names + dates, Pantone/RAL and zero DFM errors */
const GATED=['T1','Golden','Released'];
function releaseGate(rel){
  const m=rel.meta, miss=[], warn=[], so=m.signoff||{};
  ['drawn','checked','approved'].forEach(r=>{ const e=so[r]||{}, R=r[0].toUpperCase()+r.slice(1);
    if(!String(e.name||'').trim()) miss.push(`${R}: name`); if(!/^\d{4}-\d{2}-\d{2}$/.test(String(e.date||'').trim())) miss.push(`${R}: date (YYYY-MM-DD)`); });
  const pt=String(rel.cw.pantone||'').trim(); if(!pt||/^tbd$/i.test(pt)) miss.push('Pantone / RAL reference');
  const ne=rel.dfm.filter(d=>d[0]==='e').length; if(ne) miss.push(`${ne} DFM error${ne>1?'s':''}`);
  if(rel.pack&&rel.pack.ean.ok===false) miss.push('Valid EAN-13 ('+rel.pack.ean.msg+')');
  if(rel.pack&&rel.pack.ean.ok===null) warn.push('EAN-13 not set');
  if(rel.pack&&rel.pack.checks.some(c=>c[0]==='e'&&/Blister/.test(c[1]))) warn.push('Blister does not fit the card');
  const ok=!miss.length, production=ok&&m.status==='Released';
  return {ok,missing:miss,warn,production,watermark:production?null:`NOT FOR PRODUCTION – ${m.status}${m.status==='Released'&&!ok?' (gate incomplete)':''}`};
}
function bomRows(rel){
  const {p,A,geom,cw,cost,modelCode}=rel, ovr=rel.st.BOMOVR||{}, out=[];
  const made=r=>out.push(Object.assign(r,ovr[r.role]||{},{role:r.role}));
  const half=(role,side,V)=>{ const m=INJ_MAT.rho*V/1000; made({role,cat:'Molded',partNo:`BDY-${modelCode}-${side}`,desc:`Body half, ${side==='L'?'left (−Y)':'right (+Y)'}`,
    spec:`ABS, injection, wall ${fx(p.wallMm,2)} mm, draft ${p.draftDeg}°`,size:`L ${fx(p.L,1)} mm`,finish:'Raw, primed',ratedKg:0,mass_g:+m.toFixed(3),
    supplier:'TBD (molder)',unitCostUSD:+(m/1000*cost.resinUSDkg*(1+cost.runnerPct/100)).toFixed(4),qty:1,inLure:true}); };
  half('bodyL','L',geom.VL); half('bodyR','R',geom.VR);
  const bm=A.mBill; made({role:'bill',cat:'Bill',partNo:`BIL-${modelCode}-${fx(p.billT,1)}`,desc:`Diving bill incl. ${TAB} mm tab`,spec:`${BILL_MATS[p.billMat].n} sheet t=${fx(p.billT,1)} mm`,
    size:`${fx(A.tip+TAB,1)} × ${fx(p.billW,1)} mm`,finish:p.billMat==='pc'?'Clear':'Natural',ratedKg:0,mass_g:+bm.toFixed(3),supplier:'TBD (sheet cutter)',
    unitCostUSD:+(bm/1000*cost.billResinUSDkg+cost.billCutUSD).toFixed(4),qty:1,inLure:true});
  A.hw.forEach(r=>out.push(Object.assign({},r)));
  made({role:'paint',cat:'Finish',partNo:`PNT-${cw.code}`,desc:`Paint + topcoat, colourway ${cw.code} ${cw.name}`,spec:cw.layers,size:`coat ${fx(p.coat,2)} mm`,finish:cw.finish,
    ratedKg:0,mass_g:+A.mCoat.toFixed(3),supplier:'In-house paint line',unitCostUSD:cost['paintL'+cw.complexity],qty:1,inLure:true});
  made({role:'primer',cat:'Consumable',partNo:'PRM-ABS-WHT',desc:'Primer / white base coat for ABS',spec:'1K acrylic primer, ABS adhesion promoter',size:'approx. 0.05 g wet',finish:'',ratedKg:0,mass_g:0,supplier:'TBD (paint)',unitCostUSD:0.008,qty:1,inLure:false});
  made({role:'glue',cat:'Consumable',partNo:'GLU-ABS-SOLV',desc:'Solvent cement for the halves',spec:'ABS solvent cement',size:'approx. 0.02 g',finish:'',ratedKg:0,mass_g:0,supplier:'TBD',unitCostUSD:0.01,qty:1,inLure:false});
  made({role:'billGlue',cat:'Consumable',partNo:'GLU-EPX-2K',desc:'Bill adhesive, slot + tab',spec:'2K epoxy (PC / ABS), 5 min',size:'approx. 0.03 g',finish:'',ratedKg:0,mass_g:0,supplier:'TBD',unitCostUSD:0.006,qty:1,inLure:false});
  made({role:'pkg',cat:'Packaging',partNo:`PKG-BLS-${modelCode}`,desc:'Blister + printed backing card',spec:'PET blister 0.3 mm, 350 gsm card',size:(()=>{ const e=lureEnvelope(rel), k=validatePkg(rel.st.PKG); return `blister ${fx(e.L+5,0)}×${fx(e.H+5,0)}×${fx(e.W+5,0)}, card ${k.cardW}×${k.cardH}`; })(),finish:'',ratedKg:0,mass_g:0,supplier:'TBD (printer)',unitCostUSD:cost.packagingUSD,qty:1,inLure:false});
  const MOQ={Molded:0,Bill:5000,Hook:10000,'Split ring':20000,Wire:5000,Ballast:10000,Eye:20000,Finish:0,Consumable:1,Packaging:5000};
  const LEAD={Molded:45,Bill:21,Hook:30,'Split ring':21,Wire:21,Ballast:21,Eye:14,Finish:7,Consumable:7,Packaging:21};
  out.forEach((r,i)=>{ r.item=i+1; if(r.moq===undefined) r.moq=MOQ[r.cat]??1000; if(r.leadTimeDays===undefined) r.leadTimeDays=LEAD[r.cat]??21;
    const o=ovr[r.role]||{}; if(o.moq!==undefined) r.moq=o.moq; if(o.leadTimeDays!==undefined) r.leadTimeDays=o.leadTimeDays; r.extUSD=(+r.unitCostUSD||0)*(+r.qty||0); });
  return out;
}
function mouldingUSD(c){ return (+c.machineUSDh||0)*(+c.cycleS||0)/3600/Math.max(1,Math.round(+c.cavities||1)); }
/* per-unit variable cost (incl. moulding machine time) + margin -> FOB ex tooling; tooling is a separate one-off NRE line */
function costing(rel){
  const c=Object.assign({},COST_DEFAULTS,rel.cost), B=rel.bom, sum=f=>B.filter(f).reduce((s,r)=>s+r.extUSD,0);
  const mould=mouldingUSD(c);
  const lines=[['Body halves (ABS + runner)',sum(r=>r.role==='bodyL'||r.role==='bodyR')],[`Moulding: ${fx(c.machineUSDh,0)} USD/h × ${fx(c.cycleS,0)} s ÷ ${Math.round(c.cavities)} cav.`,mould],['Bill (sheet + cutting)',sum(r=>r.role==='bill')],
    ['Hardware (hooks, rings, wire, ballast, eyes)',sum(r=>['hookB','hookT','ring','tieRing','wire','ballast','eyes'].includes(r.role))],
    [`Paint, level ${rel.cw.complexity}`,sum(r=>r.role==='paint')],['Glue, primer, bill adhesive',sum(r=>['glue','primer','billGlue'].includes(r.role))],['Packaging',sum(r=>r.role==='pkg')],
    ['Assembly labour',c.assemblyUSD],['QC / tank test',c.qcUSD]];
  const other=sum(r=>!['bodyL','bodyR','bill','hookB','hookT','ring','tieRing','wire','ballast','eyes','paint','glue','primer','billGlue','pkg'].includes(r.role)); if(other) lines.push(['Other BOM lines',other]);
  const base=lines.reduce((s,l)=>s+l[1],0), scrap=base*c.scrapPct/100; lines.push([`Scrap allowance ${c.scrapPct}%`,scrap]);
  const variable=base+scrap, tooling=c.moldUSD+c.billToolUSD, margin=variable*c.marginPct/100, fobEx=variable+margin;
  const tiers=[1000,3000,5000].map(q=>{ const amort=tooling/q; return {qty:q,variable,margin,fobEx,amort,fobIncl:fobEx+amort,unit:variable+amort,fob:fobEx}; });
  return {lines,mould,variable,margin,fobEx,tooling,tiers,currency:c.currency||'USD',incoterm:c.incoterm||'',rateDate:c.rateDate||'',marginPct:c.marginPct};
}
function qcCriteria(rel){
  const {A,p}=rel, fr=A.vPause*100, tf=Math.max(2,0.25*Math.abs(fr)), dAt=v=>A.depth*clamp(0.72+0.3*v/0.8,0.6,1.08);
  const caps=rel.bom.filter(r=>['hookB','hookT','ring','tieRing'].includes(r.role)&&+r.ratedKg>0).map(r=>+r.ratedKg), proof=caps.length?0.6*Math.min(...caps):0;
  return [
    {key:'weight_g',label:'Weight, ready to fish',target:A.M,lo:A.M-0.3,hi:A.M+0.3,unit:'g',tol:'±0.3',method:'Scale 0.01 g, hooks + rings fitted'},
    {key:'float_rate_cms',label:fr>=0?'Float rate (rise)':'Sink rate (negative)',target:fr,lo:fr-tf,hi:fr+tf,unit:'cm/s',tol:'±'+fx(tf,1),method:'28 °C fresh water, time over 30 cm; + = rising'},
    {key:'depth_05_m',label:'Running depth @ 0.5 m/s',target:dAt(0.5),lo:dAt(0.5)-0.3,hi:dAt(0.5)+0.3,unit:'m',tol:'±0.3',method:`Lake / tow, ${LINES[p.line].n}, depth logger after 20 m`},
    {key:'depth_10_m',label:'Running depth @ 1.0 m/s',target:dAt(1.0),lo:dAt(1.0)-0.3,hi:dAt(1.0)+0.3,unit:'m',tol:'±0.3',method:`Lake / tow, ${LINES[p.line].n}, depth logger after 20 m`},
    {key:'tracking_mm',label:'Tracking deviation over 3 m',target:0,lo:-50,hi:50,unit:'mm',tol:'±50',method:'Straight tow at 0.5 and 1.0 m/s, worst side'},
    {key:'roll_ok',label:'No roll-over / blow-out at 1.0 m/s',type:'bool',target:'Y',unit:'Y/N',tol:'Y',method:'Visual, 10 s at 1.0 m/s'},
    {key:'hook_pull_kg',label:'Hook / ring proof load held 10 s',target:proof,lo:proof,hi:Infinity,unit:'kg',tol:'≥ '+fx(proof,1),method:'Pull gauge on each hanger and the line tie'}];
}
const QC_KEYS=['sample_id','weight_g','float_rate_cms','depth_05_m','depth_10_m','tracking_mm','roll_ok','hook_pull_kg'];
const QC_LOG_KEYS=['lot','date','operator','water_temp_c','line'];
function parseCSV(text){
  const lines=String(text).replace(/^﻿/,'').split(/\r?\n/).filter(l=>l.trim()!==''&&!/^\s*#/.test(l));
  if(!lines.length) return {head:[],rows:[],delim:','};
  const delim=[';','\t',','].map(d=>[d,lines[0].split(d).length]).sort((a,b)=>b[1]-a[1])[0][0];
  const split=l=>{ const out=[]; let cur='', q=false; for(let i=0;i<l.length;i++){ const ch=l[i]; if(q){ if(ch==='"'&&l[i+1]==='"'){cur+='"';i++} else if(ch==='"') q=false; else cur+=ch; } else if(ch==='"') q=true; else if(ch===delim){out.push(cur);cur=''} else cur+=ch; } out.push(cur); return out.map(v=>v.trim()); };
  const head=split(lines[0]).map(h=>h.toLowerCase().replace(/\s+/g,'_'));
  return {head,rows:lines.slice(1).map(split),delim};
}
function qcEvaluate(criteria,text){
  const {head,rows,delim}=parseCSV(text), warn=[]; const col=k=>head.indexOf(k);
  if(col('sample_id')<0) warn.push('No sample_id column; rows are numbered instead.');
  criteria.forEach(c=>{ if(col(c.key)<0) warn.push(`Column ${c.key} missing; not evaluated.`); });
  const num=v=>{ if(v===undefined||v==='') return null; const n=Number(delim===';'?v.replace(',','.'):v); return isFinite(n)?n:NaN; };
  const out=[]; const perKey={};
  rows.forEach((r,i)=>{ const id=col('sample_id')>=0?r[col('sample_id')]:String(i+1); if(/^(target|tol)/i.test(id||'')) return;
    const cells=criteria.map(c=>{ const raw=col(c.key)>=0?r[col(c.key)]:undefined; let v, ok=null;
      if(c.type==='bool'){ const t=String(raw||'').trim().toUpperCase(); v=t; if(['Y','YES','1','TRUE','PASS','OK'].includes(t)) ok=true; else if(['N','NO','0','FALSE','FAIL'].includes(t)) ok=false; }
      else { v=num(raw); if(v===null) ok=null; else if(Number.isNaN(v)){ ok=false; } else ok=v>=c.lo-1e-9&&v<=c.hi+1e-9; }
      if(ok===false) perKey[c.key]=(perKey[c.key]||0)+1; return {key:c.key,v,ok}; });
    const evald=cells.filter(c=>c.ok!==null); out.push({id,cells,pass:evald.length?evald.every(c=>c.ok):null}); });
  const n=out.length, pass=out.filter(r=>r.pass===true).length, fail=out.filter(r=>r.pass===false).length;
  return {rows:out,summary:{n,pass,fail,perKey},warn};
}
function tankTemplateCSV(rel){
  const c=rel.qc, row=(id,f)=>[id,...c.map(f)].join(',');
  const ln=String(LINES[rel.p.line].n).replace(/,/g,' ');
  const lines=[QC_KEYS.concat(QC_LOG_KEYS).join(','), row('TARGET',q=>q.type==='bool'?'Y':fx(q.target,2))+`,,,,28,${ln}`, row('TOL',q=>q.type==='bool'?'Y':(q.hi===Infinity?'min':fx(q.hi-q.target,2)))+',,,,2,'];
  for(let i=1;i<=13;i++) lines.push(['S'+String(i).padStart(2,'0'),...c.map(()=>''),'','','','',''].join(','));
  return lines.join('\n')+'\n';
}
function sectionStations(rel){ const p=rel.p, A=Math.min(0.15,p.fat-0.1), D=0.84; return [['A',A],['B',p.fat],['C',(p.fat+D)/2],['D',D]].map(([n,t])=>({n,t,x:t*p.L})); }
function sectionRing(rad,se,N){ const pts=[]; for(let k=0;k<N;k++){ const a=2*Math.PI*k/N, c=Math.cos(a), s=Math.sin(a); pts.push([rad[2]*sgnpow(c,2/se),(s>=0?rad[0]:rad[1])*sgnpow(s,2/se)]); } return pts; }
function innerRadiiAt(rel,x){ const g=rel.geom, cav=g.cav; if(!cav||x<cav.x0||x>cav.x1) return null; const q=radii(x/rel.p.L,rel.p); return [q[0]-g.wall-g.flange,q[1]-g.wall-g.flange,q[2]-g.wall]; }
/* exact superellipse sections at 25 stations (outer + inner where hollow) */
function sectionsCSV(rel){
  const p=rel.p, out=['station,x_mm,top_mm,bot_mm,halfW_mm,se,surface,pt,angle_deg,y_mm,z_mm'];
  for(let k=0;k<25;k++){ const x=p.L*(k+0.5)/25, q=radii(x/p.L,p), qi=innerRadiiAt(rel,x);
    [['outer',q],['inner',qi]].forEach(([nm,rad])=>{ if(!rad) return; sectionRing(rad,p.se,72).forEach((pt,i)=>out.push([k+1,fx(x,3),fx(rad[0],3),fx(rad[1],3),fx(rad[2],3),p.se,nm,i,i*5,fx(pt[0],4),fx(pt[1],4)].join(','))); }); }
  return out.join('\n')+'\n';
}
/* DFM: wall, plugs, slot, tab containment, draft, pins, ballast, mesh */
function dfmChecks(rel){
  const {p,geom:g,A}=rel, out=[], T=p.billT/2;
  if(!g.cav){ out.push(['e','No hollow cavity fits (radii < wall + 0.3 mm everywhere). Use a thinner wall or a fatter body.']); }
  else {
    out.push(['o',`Cavity x ${fx(g.cav.x0,1)}–${fx(g.cav.x1,1)} mm; solid nose plug ${fx(g.cav.x0,1)} mm, tail plug ${fx(p.L-g.cav.x1,1)} mm (local radius < wall + 0.3 mm or hardware bosses).`]);
    let mw=Infinity, at=0; const ts=stationTs();
    for(let r=g.cav.r0;r<=g.cav.r1;r+=2){ const x=ts[r+1]*p.L, qo=radii(ts[r+1],p), qi=g.cav.inner(r), O=[], I=[];
      for(let c=0;c<=32;c++){ O.push(halfRingYZ(qo,p.se,c)); I.push(halfRingYZ(qi,p.se,c)); }
      I.forEach(pt=>{ for(let c=0;c<32;c++){ const d=ptSegDist(pt[0],pt[1],O[c],O[c+1]); if(d<mw){mw=d;at=x;} } }); }
    out.push([mw<1.2-1e-6?'e':mw<p.wallMm*0.9?'w':'o',`Minimum wall ${fx(mw,2)} mm at x ${fx(at,1)} (nominal ${fx(p.wallMm,2)}; DFM limit 1.2 mm).`]);
  }
  const s=g.slot;
  if(!s) out.push(['e','The bill tab lies outside the body, so no slot can be molded. Move bill root X / Z into the chin.']);
  else if(!g.info.slotOK) out.push(['e','Bill slot: '+g.info.slotMsg+'.']);
  else {
    const th=p.billAng*Math.PI/180, dx=-Math.cos(th), dz=-Math.sin(th), nx=-Math.sin(th), nz=Math.cos(th);
    let pw=Infinity, mouth=0, tot=0, outV=0, totV=0;
    for(let i=0;i<=40;i++){ const u=s.u0+(0-s.u0)*i/40;
      for(const w of [-s.h,0,s.h]){ const Y=bodyHalfWidthAt(p,p.rootX+dx*u+nx*w,p.rootZ+dz*u+nz*w); tot++; if(Y<s.d) mouth++; else if(u<-1.5) pw=Math.min(pw,Y-s.d); }
      for(let v=-g.tabHW;v<=g.tabHW+1e-9;v+=g.tabHW/4) for(const w of [-T,0,T]){ if(u<-TAB) continue; totV++; if(Math.abs(v)>bodyHalfWidthAt(p,p.rootX+dx*u+nx*w,p.rootZ+dz*u+nz*w)) outV++; } }
    out.push([pw<1.0?'w':'o',`Bill slot ${fx(s.width,2)} × ${fx(2*s.d,2)} × ${fx(s.len,1)} mm (billT +0.15, tab +0.2, +0.3 deep); thinnest pocket wall ${isFinite(pw)?fx(pw,2):'—'} mm${pw<1.0?' (< 1.0 mm)':''}.`]);
    const pct=100*outV/Math.max(totV,1);
    out.push([pct>15?'e':pct>3?'w':'o',`Bill tab outside the body skin: ${fx(pct,1)} % of tab volume (tab ${fx(2*g.tabHW,1)} mm wide, sized to 80 % of the local body width).`]);
    if(s.uExit>1.0) out.push(['w',`The bill root sits ${fx(s.uExit,1)} mm inside the body, so the wide part of the bill crosses the body. Move the root to the chin surface.`]);
    out.push(['i','Slot walls are modelled at 0° draft. Toolmaker: ≤ 0.5° on the slot core; the +0.10/+0.20 fit is measured at the parting face.']);
  }
  if(p.pins==='on'){ out.push([g.pins.length<2?'w':'o',g.pins.length?`${g.pins.length} alignment pin${g.pins.length>1?'s':''} Ø${PROD.pinD} × ${PROD.pinH} on L, Ø${PROD.holeD} × ${PROD.pinH+PROD.holeExtra} holes on R at ${g.pins.map(q=>`(${fx(q.x,1)}, ${fx(q.z,1)})`).join(', ')}.`+(g.pins.length<2?' Only one fits; add a boss inside the cavity.':''):'No room for alignment pins in the solid plugs.']); }
  // draft: low-draft zones away from the parting line (analytic surface, pull direction ±Y)
  const sa=Math.sin(Math.max(p.draftDeg,0.05)*Math.PI/180); let maxY=0, where='';
  if(p.draftDeg>0){ const ts=stationTs(), h=0.02;
    for(let i=1;i<NSB-1;i++){ const x=ts[i]*p.L, [a,b]=radii(ts[i],p);
      for(let k=1;k<120;k++){ const z=-b+(a+b)*k/120, Y=bodyHalfWidthAt(p,x,z); if(Y<0.05) continue;
        const Yx=(bodyHalfWidthAt(p,x+h,z)-bodyHalfWidthAt(p,x-h,z))/(2*h), Yz=(bodyHalfWidthAt(p,x,z+h)-bodyHalfWidthAt(p,x,z-h))/(2*h);
        if(1/Math.sqrt(1+Yx*Yx+Yz*Yz)<sa&&Y>maxY){ maxY=Y; where=x<p.L*0.25?'nose':x>p.L*0.75?'tail':'flank'; } } }
    out.push([maxY>0.5?'w':'o',maxY>0.05?`Surface under ${p.draftDeg}° draft reaches ${fx(maxY,2)} mm from the parting plane (${where}). ${maxY>0.5?'Soften the nose/tail or accept a slide.':'Acceptable.'}`:`Outer surface has ≥ ${p.draftDeg}° draft everywhere except the parting line itself.`]); }
  if(p.ballN>0&&g.cav){ let ok=true; const r=p.ballD/2;
    for(let i=0;i<p.ballN&&ok;i++){ const x=A.ballX(i); const qi=innerRadiiAt(rel,x); if(!qi||x-r<g.cav.x0||x+r>g.cav.x1||p.ballZ+r>qi[0]-0.3||p.ballZ-r<-qi[1]+0.3||seHalfWidth(...qi,p.se,p.ballZ)<r+0.3) ok=false; }
    out.push([ok?'o':'e',ok?'Ballast balls fit inside the cavity (0.3 mm clearance).':'Ballast balls intersect the mold wall or plugs. Move them or reduce the size.']); }
  const ck=[g.checkL,g.checkR,g.checkShell];
  out.push([ck.every(c=>c.watertight)?'o':'e',`Mesh check: body_L ${g.checkL.watertight?'watertight':g.checkL.nonManifold+' bad edges'}, body_R ${g.checkR.watertight?'watertight':g.checkR.nonManifold+' bad edges'}, shell ${g.checkShell.watertight?'watertight':g.checkShell.nonManifold+' bad edges'}.`]);
  const bp=ballastPocket(p);
  out.push(['i','TODO (toolmaker): harness channel Ø'+fx(+p.wireGauge+0.2,1)+(bp?` and ballast ${bp.fix==='rattle'?'rattle chamber':'pocket'} Ø${bp.dia} × ${bp.len} long at x ${fx(bp.x,1)}, z ${fx(bp.z,1)}`:'')+' are specified on the drawing but not modelled in the halves.']);
  return out;
}

function profileData(p){
  const N=140, xs=[],tops=[],bots=[],ws=[];
  for(let i=0;i<N;i++){const t=(1-Math.cos(Math.PI*i/(N-1)))/2; const [a,b,w]=radii(t,p); xs.push(t*p.L); tops.push(a); bots.push(b); ws.push(w)}
  return {xs,tops,bots,ws};
}
function billSideCorners(p,B,tip){ // B5: tip = real exposed length from billOutline
  const T=p.billT/2, L=tip==null?p.billLen:tip, pt=(u,s)=>B.root.clone().addScaledVector(B.d,u).addScaledVector(B.n,s);
  return [pt(-TAB,T),pt(L,T),pt(L,-T),pt(-TAB,-T)];
}
/* ============================== design file v2 (pure) ============================== */
function specObject(st){ // product definition only: hashed, diffed, locked on release
  const S=paramSchema(), spec={};
  for(const k in S) if(S[k].sec==='spec') spec[k]=st.P[k];
  spec.production={}; for(const k in S) if(S[k].sec==='prod') spec.production[k]=st.P[k];
  spec.paint={back:st.PAINT.back,side:st.PAINT.side,belly:st.PAINT.belly,head:st.PAINT.head,bars:!!st.PAINT.bars,headOn:!!st.PAINT.headOn};
  spec.colourway=Object.assign({},st.CW);
  spec.bom={overrides:JSON.parse(JSON.stringify(st.BOMOVR||{}))};
  spec.packaging=validatePkg(st.PKG);
  return spec;
}
function simObject(P){ const S=paramSchema(), o={}; for(const k in S) if(S[k].sec==='sim') o[k]=P[k]; return o; }
function canonicalJSON(o){
  if(Array.isArray(o)) return '['+o.map(canonicalJSON).join(',')+']';
  if(o&&typeof o==='object') return '{'+Object.keys(o).sort().filter(k=>o[k]!==undefined).map(k=>JSON.stringify(k)+':'+canonicalJSON(o[k])).join(',')+'}';
  return JSON.stringify(o===undefined?null:o);
}
function sha256js(ascii){ // fallback when crypto.subtle is unavailable (UTF-8 in, hex out)
  ascii=unescape(encodeURIComponent(ascii)); const rr=(v,a)=>(v>>>a)|(v<<(32-a)), mw=Math.pow(2,32); let i,j,res='';
  const words=[], bitLen=ascii.length*8; let hash=[]; const k=[]; let pc=0; const comp={};
  for(let c=2;pc<64;c++){ if(!comp[c]){ for(i=0;i<313;i+=c) comp[i]=c; hash[pc]=(Math.pow(c,.5)*mw)|0; k[pc++]=(Math.pow(c,1/3)*mw)|0; } }
  ascii+='\x80'; while(ascii.length%64-56) ascii+='\x00';
  for(i=0;i<ascii.length;i++){ j=ascii.charCodeAt(i); words[i>>2]|=j<<((3-i)%4)*8; }
  words[words.length]=((bitLen/mw)|0); words[words.length]=bitLen;
  for(j=0;j<words.length;){ const w=words.slice(j,j+=16), old=hash; hash=hash.slice(0,8);
    for(i=0;i<64;i++){ const w15=w[i-15], w2=w[i-2], a=hash[0], e=hash[4];
      const t1=hash[7]+(rr(e,6)^rr(e,11)^rr(e,25))+((e&hash[5])^((~e)&hash[6]))+k[i]+(w[i]=(i<16)?w[i]:(w[i-16]+(rr(w15,7)^rr(w15,18)^(w15>>>3))+w[i-7]+(rr(w2,17)^rr(w2,19)^(w2>>>10)))|0);
      const t2=(rr(a,2)^rr(a,13)^rr(a,22))+((a&hash[1])^(a&hash[2])^(hash[1]&hash[2]));
      hash=[(t1+t2)|0].concat(hash); hash[4]=(hash[4]+t1)|0; }
    for(i=0;i<8;i++) hash[i]=(hash[i]+old[i])|0; }
  for(i=0;i<8;i++) for(j=3;j+1;j--){ const b=(hash[i]>>(j*8))&255; res+=((b<16)?0:'')+b.toString(16); }
  return res;
}
async function sha256Hex(str){
  try{ if(typeof crypto!=='undefined'&&crypto.subtle&&typeof TextEncoder!=='undefined'){ const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(str)); return Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join(''); } }catch(e){}
  return sha256js(str);
}
function specHash(st){ return sha256Hex(canonicalJSON(specObject(st))); }
function flatten(o,pre,out){ out=out||{}; for(const k of Object.keys(o||{})){ const v=o[k], key=pre?pre+'.'+k:k; if(v&&typeof v==='object'&&!Array.isArray(v)) flatten(v,key,out); else out[key]=v; } return out; }
function diffSpec(a,b){ const A=flatten(a), B=flatten(b), keys=[...new Set(Object.keys(A).concat(Object.keys(B)))].sort(), out=[];
  keys.forEach(k=>{ if(JSON.stringify(A[k])!==JSON.stringify(B[k])) out.push(`${k}: ${A[k]===undefined?'—':JSON.stringify(A[k])} → ${B[k]===undefined?'—':JSON.stringify(B[k])}`); }); return out; }
function designV2(st,name,results,hash){
  const meta=Object.assign(JSON.parse(JSON.stringify(st.META)),{modelCode:st.META.family+Math.round(st.P.L)});
  if(results) meta.sku=results.sku; if(hash) meta.specSha256=hash;
  const o={app:'Umpan Lab',version:2,name:name||'',spec:specObject(st),sim:simObject(st.P),costing:Object.assign({},st.COST),meta};
  if(results) o.results=results; return o;
}

/* ============================== drawing (pure): one primitive list -> SVG and jsPDF ==============================
   sheet units mm, origin top-left, y down. primitives: line, poly, circle, text (s = font size mm).
   v5c: ISO 3098 text heights. Every text is at least DT.s (3.5 mm font = 2.5 mm cap height on Helvetica / Arial),
   titles DT.t (5 mm font = 3.6 mm cap), monospace DT.m (4.4 mm font = 2.5 mm cap on Courier).
   Movable labels (leaders, PL, CG/CB, angle, eye, ballast) go through a small collision resolver: they avoid every
   other text box, dimension / section lines (hard) and prefer free space over the part outline (soft). */
const DT={s:3.5,t:5.0,m:4.4,cap:0.716,capM:0.571,lh:1.32};
const HELV_W=(()=>{ const w={}; const set=(chs,v)=>{ for(const c of chs) w[c]=v; };
  set('0123456789',0.556); set(' .,:;!|il\'',0.278); set('ftIjr',0.3); set('-()[]/',0.333); set('*"',0.4); set('abcdeghknopqsuvxyz',0.53); set('JL',0.556); set('wm',0.8);
  set('ABEKPSVXYFTZ',0.667); set('CDHNRU',0.722); set('GOQ',0.778); set('MW',0.9); set('°±×·≤≥–',0.58); set('→←',1.0); set('—@%',0.95); set('Ø',0.78); return w; })();
function txtW(t,s,mono,b){ t=String(t); if(mono) return t.length*0.6*s; let w=0; for(const c of t) w+=HELV_W[c]??0.6; return w*s*(b?1.05:1); }
function fitTxt(t,w,s,mono){ t=String(t); if(txtW(t,s,mono)<=w) return t; let k=t.length; while(k>1&&txtW(t.slice(0,k)+'…',s,mono)>w) k--; return t.slice(0,k)+'…'; }
function wrapTxt(t,w,s,mono){ const out=[]; String(t).split('\n').forEach(par=>{ let line=''; par.split(' ').forEach(word=>{ const c=line?line+' '+word:word; if(txtW(c,s,mono)<=w||!line) line=c; else { out.push(line); line=word; } });
  out.push(line); }); return out.map(l=>fitTxt(l,w,s,mono)); }
/* axis-aligned box of a text primitive (also used by the label tests) */
function textBox(o){
  const w=txtW(o.txt,o.s,o.mono,o.b), h=o.s*(o.mono?DT.capM:DT.cap), k=o.a==='middle'?0.5:o.a==='end'?1:0, d=0.21*o.s;
  const r=(o.rot||0)*Math.PI/180, c=Math.cos(r), sn=Math.sin(r);
  const P=[[-k*w,-h],[(1-k)*w,-h],[(1-k)*w,d],[-k*w,d]].map(([x,y])=>[o.x+x*c-y*sn,o.y+x*sn+y*c]);
  return {x0:Math.min(...P.map(q=>q[0])),y0:Math.min(...P.map(q=>q[1])),x1:Math.max(...P.map(q=>q[0])),y1:Math.max(...P.map(q=>q[1]))};
}
const boxHit=(a,b,m=0)=>a.x0<b.x1+m&&b.x0<a.x1+m&&a.y0<b.y1+m&&b.y0<a.y1+m;
function segHit(a,b,c,d){ const o=(p,q,r)=>(q[0]-p[0])*(r[1]-p[1])-(q[1]-p[1])*(r[0]-p[0]); const d1=o(c,d,a),d2=o(c,d,b),d3=o(a,b,c),d4=o(a,b,d); return d1*d2<0&&d3*d4<0; }
function segBox(a,b,B){ const inside=p=>p[0]>B.x0&&p[0]<B.x1&&p[1]>B.y0&&p[1]<B.y1; if(inside(a)||inside(b)) return true;
  const C=[[B.x0,B.y0],[B.x1,B.y0],[B.x1,B.y1],[B.x0,B.y1]]; for(let i=0;i<4;i++) if(segHit(a,b,C[i],C[(i+1)%4])) return true; return false; }
function sheet(){
  const it=[], add=o=>{ it.push(o); return o; }, hard=[], soft=[], pend=[];
  const reg=(pts,closed,kind)=>{ if(!kind) return; const L=kind==='hard'?hard:soft; for(let i=1;i<pts.length;i++) L.push([pts[i-1],pts[i]]); if(closed&&pts.length>2) L.push([pts[pts.length-1],pts[0]]); };
  const S={it,hard,soft,
    line:(x1,y1,x2,y2,o={})=>{ reg([[x1,y1],[x2,y2]],false,o.avoid); return add({t:'line',x1,y1,x2,y2,w:o.w??0.25,c:o.c||'#000',dash:o.dash||null}); },
    poly:(pts,o={})=>{ reg(pts,o.closed!==false,o.avoid); return add({t:'poly',pts,closed:o.closed!==false,w:o.w??0.35,c:o.c||'#000',fill:o.fill||null,dash:o.dash||null}); },
    circle:(cx,cy,r,o={})=>{ if(o.avoid){ const q=[]; for(let i=0;i<12;i++) q.push([cx+r*Math.cos(i*Math.PI/6),cy+r*Math.sin(i*Math.PI/6)]); reg(q,true,o.avoid); } return add({t:'circle',cx,cy,r,w:o.w??0.25,c:o.c||'#000',fill:o.fill||null,dash:o.dash||null}); },
    text:(x,y,s,txt,o={})=>{ const mono=!!o.mono; s=o.wm?s:Math.max(s||DT.s,mono?DT.m:DT.s);
      return add({t:'text',x,y,s,txt:String(txt),a:o.a||'start',b:!!o.b,c:o.c||'#000',mono,rot:o.rot||0,op:o.op??null,wm:!!o.wm}); },
    rect:(x,y,w,h,o={})=>S.poly([[x,y],[x+w,y],[x+w,y+h],[x,y+h]],o)};
  S.arrow=(x,y,ux,uy)=>{ const l=Math.hypot(ux,uy)||1; ux/=l; uy/=l; const L=2.5, W=0.75; S.poly([[x,y],[x-ux*L-uy*W,y-uy*L+ux*W],[x-ux*L+uy*W,y-uy*L-ux*W]],{fill:'#000',w:0.05}); };
  // linear dimension between feature points P1,P2 measured along unit direction u, dimension line offset along n by off
  S.dim=(P1,P2,u,off,label,o={})=>{ const n=[-u[1],u[0]], len=(P2[0]-P1[0])*u[0]+(P2[1]-P1[1])*u[1];
    const A=[P1[0]+n[0]*off,P1[1]+n[1]*off], B=[A[0]+u[0]*len,A[1]+u[1]*len];
    const ext=(F,D)=>{ const dd=(D[0]-F[0])*n[0]+(D[1]-F[1])*n[1], sg=Math.sign(dd)||1; if(Math.abs(dd)<1.2) return; S.line(F[0]+n[0]*sg*0.8,F[1]+n[1]*sg*0.8,D[0]+n[0]*sg*1.5,D[1]+n[1]*sg*1.5,{w:0.18,avoid:'hard'}); };
    const P2p=[P2[0]+n[0]*((P1[0]-P2[0])*n[0]+(P1[1]-P2[1])*n[1]+off),P2[1]+n[1]*((P1[0]-P2[0])*n[0]+(P1[1]-P2[1])*n[1]+off)];
    ext(P1,A); ext(P2,P2p);
    S.line(A[0],A[1],B[0],B[1],{w:0.18,avoid:'hard'}); const dir=Math.sign(len)||1;
    if(Math.abs(len)>7){ S.arrow(A[0],A[1],-u[0]*dir,-u[1]*dir); S.arrow(B[0],B[1],u[0]*dir,u[1]*dir); }
    else { S.arrow(A[0],A[1],u[0]*dir,u[1]*dir); S.arrow(B[0],B[1],-u[0]*dir,-u[1]*dir); S.line(A[0],A[1],A[0]-u[0]*dir*4,A[1]-u[1]*dir*4,{w:0.18}); S.line(B[0],B[1],B[0]+u[0]*dir*4,B[1]+u[1]*dir*4,{w:0.18}); }
    let ang=Math.atan2(u[1],u[0])*180/Math.PI; if(ang>90.01) ang-=180; if(ang<-90.01) ang+=180;
    const m=[(A[0]+B[0])/2,(A[1]+B[1])/2], up=[Math.sin(ang*Math.PI/180),-Math.cos(ang*Math.PI/180)], s=o.s||DT.s;
    if(o.resolve&&Math.abs(len)<=txtW(label,o.s||DT.s)+5){ S.label(m[0],m[1],label,{dot:false,dirs:o.dirs,region:o.region}); return null; }
    const bx=m[0]+up[0]*1.0+(o.dx||0), by=m[1]+up[1]*1.0+(o.dy||0), ca=Math.cos(ang*Math.PI/180), sa=Math.sin(ang*Math.PI/180), tw=txtW(label,s), L=Math.abs(len);
    // slide along the dimension line (or outside it when the label does not fit) to avoid other texts and the frame
    const sh=L/2+tw/2+5, cands=L>tw+5||o.inside?[0,0.22*L,-0.22*L,0.34*L-tw/4,-(0.34*L-tw/4)].filter((v,i)=>i===0||Math.abs(v)+tw/2<L/2-1):(o.flip?[-sh,sh]:[sh,-sh]);
    const TB=it.filter(q=>q.t==='text'&&!q.wm).map(textBox); let pick=cands[0];
    for(const c of cands){ const B=textBox({x:bx+ca*c,y:by+sa*c,s,txt:label,a:'middle',rot:ang}); if(B.x0>11&&B.y0>11&&B.x1<409&&B.y1<286&&!TB.some(T=>boxHit(B,T,0.5))){ pick=c; break; } }
    return S.text(bx+ca*pick,by+sa*pick,s,label,{a:'middle',rot:ang}); };
  S.hdim=(xa,ya,xb,yb,yd,label,o)=>S.dim([xa,ya],[xb,yb],[1,0],yd-ya,label,o);
  S.vdim=(xa,ya,xb,yb,xd,label,o)=>S.dim([xa,ya],[xb,yb],[0,-1],xd-xa,label,o);
  S.cline=(x1,y1,x2,y2,o={})=>S.line(x1,y1,x2,y2,{w:0.18,dash:[6,1.2,1,1.2],avoid:o.avoid});
  /* movable label with an optional leader: resolved later against every text, hard and soft segment */
  S.label=(ax,ay,txt,o={})=>{ const ring=[-60,-120,-30,-150,0,180,60,120,30,150,-90,90,-15,-165,15,165,-75,-105,75,105], dirs=(o.dirs||[]).concat(ring.filter(d=>!(o.dirs||[]).includes(d)));
    pend.push({ax,ay,txt:String(txt),s:o.s||DT.s,b:!!o.b,c:o.c||'#000',dirs,dists:(o.dists||[5,8,11,15,20,26,33]).concat([40,48]),leader:o.leader!==false,dot:o.dot!==false,region:o.region||null,r0:o.r0||0}); };
  S.resolve=()=>{
    const texts=()=>it.filter(o=>o.t==='text'&&!o.wm).map(textBox);
    pend.splice(0).forEach(L=>{ const TB=texts(); let best=null;
      L.dists.forEach((d,di)=>L.dirs.forEach((ang,ai)=>{ const r=ang*Math.PI/180, c=Math.cos(r), sn=Math.sin(r), px=L.ax+c*d, py=L.ay+sn*d, cap=L.s*DT.cap;
        let a='middle', tx=px, ty=sn<0?py-0.9:py+cap+0.9; if(c>0.35){ a='start'; tx=px+1.0; ty=py+cap/2; } else if(c<-0.35){ a='end'; tx=px-1.0; ty=py+cap/2; }
        const o={x:tx,y:ty,s:L.s,txt:L.txt,a,b:L.b,rot:0}, B=textBox(o), lead=[[L.ax+c*(L.r0+0.5),L.ay+sn*(L.r0+0.5)],[px,py]];
        if(L.region&&(B.x0<L.region[0]||B.y0<L.region[1]||B.x1>L.region[2]||B.y1>L.region[3])) return;
        let pen=0; if(TB.some(T=>boxHit(B,T,1.2))) pen+=1000; if(L.leader&&TB.some(T=>segBox(lead[0],lead[1],T))) pen+=600;
        if(hard.some(([p,q])=>segBox(p,q,B))) pen+=500; if(L.leader&&hard.some(([p,q])=>segHit(lead[0],lead[1],p,q))) pen+=300;
        pen+=4*soft.filter(([p,q])=>segBox(p,q,B)).length; if(L.leader) pen+=0.5*soft.filter(([p,q])=>segHit(lead[0],lead[1],p,q)).length;
        const sc=pen+d*0.6+ai*0.35+di*0.2; if(!best||sc<best.sc) best={sc,o,lead,px,py,c}; }));
      if(!best) return;
      if(L.leader){ if(L.dot) S.circle(L.ax,L.ay,0.4,{fill:'#000',w:0.05}); S.line(best.lead[0][0],best.lead[0][1],best.px,best.py,{w:0.18}); }
      S.text(best.o.x,best.o.y,L.s,L.txt,{a:best.o.a,b:L.b,c:L.c}); });
  };
  S.watermark=(W,H,txt)=>{ if(!txt) return; const s=Math.min(24,0.9*Math.hypot(W,H)/Math.max(10,txtW(txt,1,false,true)));
    S.text(W/2,H/2+s*0.35,s,txt,{a:'middle',b:true,c:'#c62828',rot:-Math.atan2(H,W)*180/Math.PI,op:0.2,wm:true}); };
  return S;
}
/* table: cols [{h,w,a,wrap}] rows [[...]] -> returns bottom y. Wrapping columns grow the row height. */
function sheetTable(S,x,y,cols,rows,o={}){
  const s=o.s||DT.s, pad=1.3, lh=s*DT.lh, W=cols.reduce((a,c)=>a+c.w,0), hh=s*DT.cap+2*pad+1.4;
  if(o.title){ S.text(x,y-1.6,o.ts||DT.t,o.title,{b:true}); }
  S.rect(x,y,W,hh,{fill:'#e9e6df',w:0.18});
  let cx=x; cols.forEach(c=>{ S.text(c.a==='end'?cx+c.w-1:cx+1,y+hh-pad-0.5,s,fitTxt(c.h,c.w-2,s),{b:true,a:c.a||'start'}); cx+=c.w; });
  let yy=y+hh;
  rows.forEach((r,i)=>{ const cells=cols.map((c,j)=>c.wrap?wrapTxt(r[j]??'',c.w-2,s,c.mono).slice(0,c.maxL||4):[fitTxt(r[j]??'',c.w-2,s,c.mono)]);
    const n=Math.max(...cells.map(l=>l.length)), rh=s*DT.cap+2*pad+1.2+(n-1)*lh;
    if(o.hl&&o.hl(r,i)) S.rect(x,yy,W,rh,{fill:o.hl(r,i),w:0});
    cx=x; cols.forEach((c,j)=>{ cells[j].forEach((t,k)=>S.text(c.a==='end'?cx+c.w-1:cx+1,yy+pad+s*DT.cap+0.6+k*lh,s,t,{a:c.a||'start',mono:c.mono,c:o.color?o.color(r,j):undefined})); cx+=c.w; });
    yy+=rh; S.line(x,yy,x+W,yy,{w:0.1,c:'#999'}); });
  S.rect(x,y,W,yy-y,{w:0.25});
  cx=x; cols.slice(0,-1).forEach(c=>{ cx+=c.w; S.line(cx,y,cx,yy,{w:0.1,c:'#999'}); });
  return yy;
}
/* key / value block: returns bottom y */
function sheetKV(S,x,y,w,pairs,o={}){ const s=o.s||DT.s, dy=s*1.45, kw=o.kw||w*0.42;
  pairs.forEach(([k,v])=>{ const vl=o.wrap?wrapTxt(v,w-kw-2,s):[fitTxt(v,w-kw-2,s)]; S.text(x,y,s,fitTxt(k,kw-1,s),{c:'#333'}); vl.forEach((t,i)=>S.text(x+w,y+i*s*DT.lh,s,t,{a:'end'})); y+=dy+(vl.length-1)*s*DT.lh; });
  return y; }
const N_SHEETS=4;
/* title block, bottom right of drawing sheets (170 × 58 mm) */
function titleBlock(S,rel,hash,sheetNo,scaleTxt){
  const {p,meta}=rel, tx=240, ty=229, so=meta.signoff;
  const cell=(x,y,w,h,lab,val,o={})=>{ S.rect(x,y,w,h,{w:0.25}); S.text(x+1,y+DT.s*DT.cap+1,DT.s,lab,{c:'#555'}); const vs=o.s||4; S.text(x+1,y+h-1.5,vs,fitTxt(val,w-2,vs,o.mono),{b:o.b,mono:o.mono}); };
  S.rect(tx,ty,170,58,{w:0.6});
  cell(tx,ty,72,13,'UMPAN LAB · PRODUCT DRAWING',rel.name||rel.modelCode,{b:true,s:DT.t});
  cell(tx+72,ty,28,13,'MODEL',rel.modelCode,{b:true}); cell(tx+100,ty,52,13,'SKU',rel.sku,{mono:true,s:DT.m}); cell(tx+152,ty,18,13,'REV',meta.rev,{b:true,s:6});
  cell(tx,ty+13,30,11,'STATUS',meta.status,{b:meta.status!=='Released'}); cell(tx+30,ty+13,34,11,'DATE',isoDate()); cell(tx+64,ty+13,44,11,'SCALE',scaleTxt);
  cell(tx+108,ty+13,22,11,'UNITS','mm'); cell(tx+130,ty+13,40,11,'SHEET',`${sheetNo} / ${N_SHEETS}`);
  [['DRAWN','drawn'],['CHECKED','checked'],['APPROVED','approved']].forEach(([l,k],i)=>cell(tx+i*56.67,ty+24,56.67,11,l,`${so[k].name||'—'}  ${so[k].date||''}`,{s:DT.s}));
  cell(tx,ty+35,48,10,'GEN. TOLERANCE','ISO 2768-m',{s:DT.s}); cell(tx+48,ty+35,46,10,'PROJECTION','1st angle',{s:DT.s}); cell(tx+94,ty+35,76,10,'MATERIAL',`ABS · ${BILL_MATS[p.billMat].n.replace(/ \(.*/,'')} bill`,{s:DT.s});
  const px=tx+86, py=ty+41; S.circle(px,py,1.6,{w:0.2}); S.circle(px,py,0.7,{w:0.2}); S.poly([[px-7,py-1.6],[px-3,py-1],[px-3,py+1],[px-7,py+1.6]],{w:0.2});
  S.rect(tx,ty+45,170,13,{w:0.25}); S.text(tx+1,ty+45+DT.s*DT.cap+1,DT.s,'SPEC SHA-256 (canonical spec JSON)',{c:'#555'});
  S.text(tx+1,ty+55.6,DT.s,fitTxt(String(hash||'(not computed)'),168,DT.s));
}
function sheetFrame(S,W,H){ S.rect(10,10,W-20,H-20,{w:0.6}); }
/* drawing sheet 1: general arrangement (side / front / top), spec, hardware coordinates, notes, title block */
function drawingModel(rel,hash){
  const {p,A,bill,geom:g,cw}=rel, S=sheet(), W=420, H=297, B=bill.B, eye=rel.eye||eyeSpec(p), bp=ballastPocket(p);
  sheetFrame(S,W,H);
  const pd=profileData(p), zTop=Math.max(...pd.tops), zBot=Math.max(...pd.bots), wMax=Math.max(...pd.ws);
  const bc=billSideCorners(p,B,A.tip), xmin=Math.min(0,...bc.map(v=>v.x)), zmin=Math.min(-zBot,...bc.map(v=>v.z));
  const tw=Math.max(wMax,p.billW/2);
  let sc=0.5; for(const k of [2,1,0.5]){ const wNeed=8+k*(p.L-xmin)+24+16+k*2*tw+6, hNeed=19+10+k*(zTop-zmin)+12+30+14+k*2*tw+14; if(wNeed<=276&&hNeed<=208){ sc=k; break; } }
  const scTxt=sc>=1?`${sc}:1`:`1:${1/sc}`;
  const ox=16+8+sc*(-xmin); let oy=19+10+sc*zTop+2;
  { const off=(p.billT/2)*sc+7, tipZ=B.root.z+B.d.z*A.tip, yTop=oy+Math.min(-sc*B.root.z,-sc*tipZ)+B.d.x*off-7; if(yTop<26) oy+=26-yTop; }
  const X=x=>ox+sc*x, Z=z=>oy-sc*z;
  const fx0=X(p.L)+24+16+sc*tw;                      // front view centre
  const viewR=fx0+sc*tw+8;
  // ---------- SIDE VIEW
  S.text(16,19,DT.t,`SIDE VIEW  (scale ${scTxt})`,{b:true});
  const side=pd.xs.map((x,i)=>[X(x),Z(pd.tops[i])]).concat(pd.xs.slice().reverse().map((x,i)=>[X(x),Z(-pd.bots[pd.xs.length-1-i])]));
  S.poly(side,{w:0.5,avoid:'soft'}); S.poly(bc.map(v=>[X(v.x),Z(v.z)]),{w:0.4,avoid:'soft'});
  S.cline(X(xmin)-3,Z(0),X(p.L)+4,Z(0),{avoid:'soft'});
  if(g.cav){ const cx=[], ct=[], cb=[]; for(let i=0;i<=40;i++){ const x=g.cav.x0+(g.cav.x1-g.cav.x0)*i/40, q=radii(x/p.L,p); cx.push(x); ct.push(q[0]-g.wall-g.flange); cb.push(q[1]-g.wall-g.flange); }
    S.poly(cx.map((x,i)=>[X(x),Z(ct[i])]).concat(cx.slice().reverse().map((x,i)=>[X(x),Z(-cb[cx.length-1-i])])),{w:0.2,dash:[1.6,0.8],avoid:'soft'}); }
  if(g.slot) S.poly(g.slot.rect.map(q=>[X(q[0]),Z(q[1])]),{w:0.2,dash:[1.6,0.8],avoid:'soft'});
  S.poly(A.harness.map(q=>[X(q[0]),Z(q[2])]),{closed:false,w:0.18,dash:[4,1,1,1],c:'#555',avoid:'soft'});
  for(let i=0;i<p.ballN;i++) S.circle(X(A.ballX(i)),Z(p.ballZ),sc*p.ballD/2,{w:0.2,dash:[1.2,0.6],avoid:'soft'});
  if(bp) S.rect(X(bp.x-bp.len/2),Z(bp.z+bp.dia/2),sc*bp.len,sc*bp.dia,{w:0.15,dash:[0.8,0.6],c:'#444'});
  g.pins.forEach(q=>S.circle(X(q.x),Z(q.z),sc*PROD.pinD/2,{w:0.2,dash:[0.8,0.5]}));
  [A.pts.tie,A.pts.belly,A.pts.tail].forEach(q=>{ S.circle(X(q[0]),Z(q[2]),0.8,{w:0.25}); S.line(X(q[0])-1.4,Z(q[2]),X(q[0])+1.4,Z(q[2]),{w:0.12}); S.line(X(q[0]),Z(q[2])-1.4,X(q[0]),Z(q[2])+1.4,{w:0.12}); });
  S.circle(X(eye.x),Z(eye.z),sc*eye.d/2,{w:0.3,avoid:'soft'}); S.circle(X(eye.x),Z(eye.z),sc*eye.d/4,{w:0.15,fill:'#000'});
  const cgm=q=>{ S.circle(X(q[0]),Z(q[2]),1.1,{w:0.25}); S.poly([[X(q[0]),Z(q[2])-1.1],[X(q[0])+1.1,Z(q[2])],[X(q[0]),Z(q[2])],[X(q[0]),Z(q[2])+1.1],[X(q[0])-1.1,Z(q[2])],[X(q[0]),Z(q[2])]],{fill:'#000',w:0.05}); };
  cgm(A.CG); cgm(A.CB);
  // section cut lines + letters (fixed)
  let lettersBottom=0;
  rel.sections.forEach(sx=>{ const q=radii(sx.t,p), y1=Z(q[0])-4, y2=Z(-q[1])+4; S.line(X(sx.x),y1,X(sx.x),y2,{w:0.25,dash:[6,1.2,1,1.2],avoid:'hard'});
    S.text(X(sx.x),y1-0.9,DT.t,sx.n,{a:'middle',b:true}); S.text(X(sx.x),y2+0.9+DT.t*DT.cap,DT.t,sx.n,{a:'middle',b:true}); lettersBottom=Math.max(lettersBottom,y2+1+DT.t*DT.cap); });
  // dimensions below
  const yb=Math.max(Z(zmin)+8,lettersBottom+7);
  S.hdim(X(0),Z(0),X(p.bellyX),Z(A.pts.belly[2]),yb,`${fx(p.bellyX,1)} ±0.3`);
  S.hdim(X(0),Z(0),X(A.pts.tail[0]),Z(0),yb+7.5,`${fx(A.pts.tail[0],1)} ±0.3`);
  S.hdim(X(0),Z(0),X(p.L),Z(0),yb+15,`L ${fx(p.L,1)} ±0.3`);
  const tipX=Math.min(...bc.map(v=>v.x)); S.hdim(X(tipX),Z(bc.reduce((a,v)=>v.x<a.x?v:a).z),X(p.L),Z(0),yb+22.5,`${fx(p.L-tipX,1)} overall (ref)`);
  const xf=p.fat*p.L, qf=radii(p.fat,p);
  S.vdim(X(xf),Z(0),X(xf),Z(qf[0]),X(p.L)+7,`${fx(qf[0],1)} ±0.2`,{flip:true}); S.vdim(X(xf),Z(-qf[1]),X(xf),Z(qf[0]),X(p.L)+16,`H ${fx(qf[0]+qf[1],1)} ±0.3`);
  // bill: aligned length (fixed), angle (movable)
  const r0=[X(B.root.x),Z(B.root.z)], tipP=[X(B.root.x+B.d.x*A.tip),Z(B.root.z+B.d.z*A.tip)], ud=[B.d.x,-B.d.z];
  const region=[14,22,viewR-2,yb+30];
  S.dim(r0,tipP,ud,(p.billT/2)*sc+7,`bill ${fx(A.tip,1)} ±0.3`,{resolve:true,region,dirs:[-150,180,150,-120,120,-90,90]});
  const ar=Math.min(16,Math.max(9,sc*A.tip*0.5)); const arc=[]; for(let k=0;k<=16;k++){ const a=Math.PI+B.th*k/16; arc.push([r0[0]+ar*Math.cos(a),r0[1]+ar*Math.sin(a)]); }
  S.poly(arc,{closed:false,w:0.18,avoid:'soft'}); S.line(r0[0],r0[1],r0[0]-ar-4,r0[1],{w:0.12,dash:[2,1],avoid:'soft'});
  const mid=arc[8];
  S.label(mid[0],mid[1],`${fx(p.billAng,0)}° ±1°`,{dirs:[-150,180,-120,150,-90],dists:[3,6,9,13,18],region,dot:false});
  S.label(X(A.pts.tie[0]),Z(A.pts.tie[2]),'TIE',{dirs:[120,90,150,60,180],region});
  if(g.slot){ const sp=[(g.slot.rearPts[0][0]+g.slot.rearPts[1][0])/2,(g.slot.rearPts[0][1]+g.slot.rearPts[1][1])/2]; S.label(X(sp[0]),Z(sp[1]),'SLOT (note 4)',{dirs:[-100,-80,-120,-60,-135,-45],region}); }
  S.label(X(A.CG[0]),Z(A.CG[2]),'CG',{dirs:[60,90,120,45,135],region,r0:1.1});
  S.label(X(A.CB[0]),Z(A.CB[2]),'CB',{dirs:[-60,-90,-45,-120,-30],region,r0:1.1});
  S.label(X(eye.x),Z(eye.z),`EYE Ø${fx(eye.d,1)} (note 7)`,{dirs:[-110,-90,-130,-70,-150],region,r0:sc*eye.d/2});
  if(p.ballN) S.label(X(p.ballX),Z(p.ballZ),`BALLAST (note 6)`,{dirs:[100,80,120,60,135],region,r0:sc*p.ballD/2});
  S.label(X(p.L),Z(0),'PL',{dirs:[-30,-45,-15,30,45],dists:[4,7,10,14],region});
  // ---------- FRONT VIEW (from the nose, 1st-angle: placed right)
  const fW=y=>fx0+sc*y;
  S.text(fx0-sc*tw-4,19,DT.t,'FRONT VIEW',{b:true});
  const ringMax=sectionRing(qf,p.se,72); S.poly(ringMax.map(q=>[fW(q[0]),Z(q[1])]),{w:0.5,avoid:'soft'});
  S.poly(bill.outline.pts.map(([u,v])=>[fW(v),Z(B.root.z+B.d.z*u)]),{w:0.3,avoid:'soft'});
  S.cline(fx0,Z(zTop)-3,fx0,Z(zmin)+3);
  S.hdim(fW(-qf[2]),Z(0),fW(qf[2]),Z(0),yb,`W ${fx(2*qf[2],1)} ±0.2`);
  S.hdim(fW(-p.billW/2),Z(B.root.z+B.d.z*A.tip),fW(p.billW/2),Z(B.root.z+B.d.z*A.tip),yb+7.5,`bill ${fx(p.billW,1)} ±0.2`);
  S.label(fW(eye.y),Z(eye.z),`eye y ±${fx(eye.y,1)}`,{dirs:[-45,-30,-60,0],dists:[6,9,12,16],region:[fx0-sc*tw-10,22,W-120,yb-4]});
  // ---------- TOP VIEW (below)
  const tTitle=yb+22.5+12, ty=tTitle+7+sc*tw, Yt=y=>ty+sc*y;
  S.text(16,tTitle,DT.t,'TOP VIEW',{b:true});
  S.poly(pd.xs.map((x,i)=>[X(x),Yt(-pd.ws[i])]).concat(pd.xs.slice().reverse().map((x,i)=>[X(x),Yt(pd.ws[pd.xs.length-1-i])])),{w:0.5,avoid:'soft'});
  S.poly(bill.outline.pts.map(([u,v])=>[X(B.root.x+B.d.x*u),Yt(v)]),{w:0.3,avoid:'soft'});
  [1,-1].forEach(sd=>S.circle(X(eye.x),Yt(sd*eye.y),Math.max(0.6,sc*0.4),{w:0.25}));
  S.cline(X(xmin)-3,ty,X(p.L)+4,ty,{avoid:'soft'});
  S.vdim(X(xf),Yt(qf[2]),X(xf),Yt(-qf[2]),X(p.L)+8,`${fx(2*qf[2],1)} ±0.2`,{flip:true});
  S.label(X(p.L),ty,'PL',{dirs:[-30,30,-45,45,-60,60],dists:[4,7,10,14,18],region:[14,tTitle,viewR,226]});
  // ---------- RIGHT COLUMN: spec + hardware coordinates
  const rx=298, rw=110; let y=19;
  S.text(rx,y,DT.t,'SPEC',{b:true}); y+=7;
  y=sheetKV(S,rx,y,rw,[['Class (28 °C fresh)',`${rel.cls} · net ${A.net>=0?'+':''}${fx(A.net,2)} g`],['Weight',`${fx(A.M,2)} g ±0.3`],['Displacement',`${fx(A.Vd/1000,2)} cm³`],
    [A.vPause>=0?'Float rate':'Sink rate',`${fx(Math.abs(A.vPause*100),1)} cm/s`],['Action est.',`${fx(rel.S05.f,1)} Hz @0.5 · ${fx(rel.S10.f,1)} Hz @1.0 m/s`],
    ['CG (x, z)',`${fx(A.CG[0],1)}, ${fx(A.CG[2],1)}`],['CB (x, z)',`${fx(A.CB[0],1)}, ${fx(A.CB[2],1)}`],['Body',`ABS inj., wall ${fx(g.wall,2)}, ${fx(g.Vshell/1000,2)} cm³`],
    ['Bill',`${BILL_MATS[p.billMat].n.replace(/ \(.*/,'')} ${fx(p.billT,1)} @ ${p.billAng}°`],['Hooks',`${p.hookB==='none'?'—':p.hookB} / ${p.hookT==='none'?'—':p.hookT} ${HSTR[p.hookStr].n.replace(' wire','')}`],
    ['Ballast',p.ballN?`${p.ballN}× Ø${p.ballD} ${BALLAST[p.ballMat].n.toLowerCase()}, ${p.ballFix==='rattle'?'loose rattle':'glued'}`:'none'],
    ['Eyes',`3D sticker Ø${fx(eye.d,1)}, x ${fx(eye.x,1)} z ${fx(eye.z,1)}`],
    ['Depth (cast)',Object.entries(LINES).filter(([k])=>['pe2','pe3','mono12'].includes(k)).map(([k,v])=>`${v.n.replace(' braid','').replace('Mono ','M')} ${fx(A.depthBase*v.f,1)} m`).join(' · ')]],{kw:38});
  const hwRows=[['Bill root',A.pts.root,'±0.3'],['Line tie (bill)',A.pts.tie,'±0.3'],['Belly hanger',A.pts.belly,'±0.3'],['Tail hanger',A.pts.tail,'±0.3']];
  if(p.ballN&&p.ballN<=3) for(let i=0;i<p.ballN;i++) hwRows.push([`Ballast ${i+1} Ø${p.ballD}`,[A.ballX(i),0,p.ballZ],'±0.5']);
  else if(p.ballN) hwRows.push([`Ballast ×${p.ballN} (row)`,[p.ballX,0,p.ballZ],'±0.5']);
  g.pins.forEach((q,i)=>hwRows.push([`Pin ${i+1} Ø${PROD.pinD}/${PROD.holeD}`,[q.x,0,q.z],'±0.1']));
  if(g.slot) hwRows.push(['Slot rear (ctr)',[(g.slot.rearPts[0][0]+g.slot.rearPts[1][0])/2,0,(g.slot.rearPts[0][1]+g.slot.rearPts[1][1])/2],'±0.2']);
  hwRows.push([`Eye Ø${fx(eye.d,1)} L / R`,[eye.x,eye.y,eye.z],'±0.5','±']);
  if(g.cav) hwRows.push(['Cavity x start / end',[g.cav.x0,0,g.cav.x1],'ref','cav']);
  hwRows.push(['CG',A.CG,'calc'],['CB',A.CB,'calc']);
  y=sheetTable(S,rx,y+5,[{h:'Point',w:41},{h:'X',w:17,a:'end'},{h:'Y',w:17,a:'end'},{h:'Z',w:19,a:'end'},{h:'Tol',w:16,a:'end'}],
    hwRows.map(([n,q,t,f])=>f==='cav'?[n,fx(q[0],1),'—',fx(q[2],1),t]:[n,fx(q[0],1),(f==='±'?'±':'')+fx(q[1],1),fx(q[2],1),t]),{title:'HARDWARE COORDINATES (mm)'});
  // ---------- NOTES (bottom left)
  const notes=['1. Units mm. Datum nose tip (0,0,0); X aft, Z up, Y left (−) / right (+). General tolerances ISO 2768-m unless stated.',
    `2. Two-half mold, parting plane Y = 0: body_L = −Y, body_R = +Y. Wall ${fx(g.wall,2)} ±0.15, seam land +${fx(g.flange,1)}.`,
    `3. Draft ${p.draftDeg}° on pins / holes; outer skin see DFM. Pins Ø${PROD.pinD} on L, holes Ø${PROD.holeD} on R.`,
    g.slot?`4. Bill slot each half ${fx(g.slot.width,2)} wide (billT +0.10/+0.20) × ${fx(g.slot.d,2)} deep × ${fx(g.slot.len,1)} long; bill bonded with 2K epoxy.`:'4. Bill slot: NOT AVAILABLE (see DFM).',
    `5. Harness Ø${fx(+p.wireGauge,1)} SS304 (dash-dot): tab anchor → belly → tail eye. Channel Ø${fx(+p.wireGauge+0.2,1)} on the parting face (toolmaker).`,
    bp?`6. Ballast ${p.ballN}× Ø${p.ballD} ${BALLAST[p.ballMat].n.toLowerCase()}: ${bp.fix==='rattle'?`LOOSE RATTLE, chamber Ø${bp.dia} × ${bp.len} long`:`GLUED IN POCKET Ø${bp.dia} × ${bp.len} long (2K epoxy)`}, centre x ${fx(bp.x,1)} z ${fx(bp.z,1)}.`:'6. No ballast.',
    `7. Eyes: 3D sticker Ø${fx(eye.d,1)} both flanks, centre x ${fx(eye.x,1)} z ${fx(eye.z,1)} (y ±${fx(eye.y,1)} on the skin); recess Ø${fx(eye.recessD,1)} × ${eye.recessDepth} deep.`,
    `8. Colourway ${cw.code} ${cw.name}, ${cw.finish}. Pantone / RAL: ${cw.pantone||'TBD'}. Sections, bill pattern, tolerances: sheet 2.`];
  S.text(16,236,DT.t,'NOTES',{b:true}); let ny=242.5;
  notes.forEach(t=>{ wrapTxt(t,220,DT.s).forEach((l,i)=>{ if(ny<=285.5) S.text(16+(i?4:0),ny,DT.s,l); ny+=DT.s*DT.lh; }); });
  S.resolve();
  titleBlock(S,rel,hash,1,scTxt);
  if(rel.gate&&rel.gate.watermark) S.watermark(W,H,rel.gate.watermark);
  return {W,H,items:S.it,scale:scTxt};
}
/* drawing sheet 2: sections, bill flat pattern, specific tolerances */
function drawingModel2(rel,hash){
  const {p,A,bill,geom:g}=rel, S=sheet(), W=420, H=297;
  sheetFrame(S,W,H);
  const pd=profileData(p), zTop=Math.max(...pd.tops), zBot=Math.max(...pd.bots), wMax=Math.max(...pd.ws);
  const secSc=2*(zTop+zBot)<=110&&4*wMax<=76?2:1, secTxt=`${secSc}:1`;
  S.text(16,19,DT.t,`SECTIONS  (scale ${secTxt})`,{b:true}); S.text(16,26,DT.s,'grey = mold wall · Y = 0 parting line dash-dot · section positions on sheet 1',{c:'#333'});
  const boxW=97, maxTop=Math.max(...rel.sections.map(sx=>radii(sx.t,p)[0]));
  rel.sections.forEach((sx,i)=>{ const cx=16+boxW*i+boxW/2+4, q=radii(sx.t,p), cy=40+secSc*maxTop, Q=(y,z)=>[cx+secSc*y,cy-secSc*z];
    S.poly(sectionRing(q,p.se,72).map(v=>Q(v[0],v[1])),{w:0.45,fill:'#d9d9d9',avoid:'soft'});
    const qi=innerRadiiAt(rel,sx.x); if(qi) S.poly(sectionRing(qi,p.se,72).map(v=>Q(v[0],v[1])),{w:0.3,fill:'#ffffff',avoid:'soft'});
    S.cline(cx,cy-secSc*q[0]-3,cx,cy+secSc*q[1]+3,{avoid:'hard'});
    S.text(cx,34,DT.t,`${sx.n}–${sx.n}  x ${fx(sx.x,1)}`,{a:'middle',b:true});
    S.hdim(cx-secSc*q[2],cy,cx+secSc*q[2],cy,cy+secSc*q[1]+7,`${fx(2*q[2],1)} ±0.2`);
    S.vdim(cx,cy+secSc*q[1],cx,cy-secSc*q[0],cx-secSc*q[2]-6,`${fx(q[0]+q[1],1)} ±0.3`);
    if(qi&&sx.n==='B'){ const yw=(q[2]+qi[2])/2; S.label(...Q(yw,0),`wall ${fx(g.wall,2)} ±0.15`,{dirs:[-35,-55,35,55,-20,20],dists:[6,9,12,16,20],region:[cx-boxW/2-6,30,cx+boxW/2+10,150]}); }
  });
  S.resolve();
  const yS=Math.max(...rel.sections.map(sx=>{ const q=radii(sx.t,p); return 40+secSc*maxTop+secSc*q[1]+12; }))+8;
  // ---------- BILL FLAT PATTERN
  const o=bill.outline, bw=A.tip+TAB, byT=Math.max(yS,150), bsc=[2,1,0.5].find(k=>k*bw+44<=212&&k*p.billW+44<=286-byT-6)||0.5, bx=28+bsc*TAB, by=byT+22+bsc*p.billW/2;
  S.text(16,byT,DT.t,`BILL FLAT PATTERN (scale ${bsc>=1?bsc+':1':'1:2'})`,{b:true}); S.text(16,byT+6,DT.s,`${BILL_MATS[p.billMat].n} t = ${fx(p.billT,1)} ±0.1 · bonded in slot with 2K epoxy`);
  S.poly(o.pts.map(([u,v])=>[bx+bsc*u,by-bsc*v]),{w:0.4});
  S.line(bx,by-bsc*o.tabHW-1,bx,by+bsc*o.tabHW+1,{w:0.12,dash:[1,0.6]});
  if(bill.holeOK) S.circle(bx+bsc*p.tieU,by,bsc*1.1,{w:0.25});
  S.hdim(bx-bsc*TAB,by,bx+bsc*A.tip,by,by-bsc*p.billW/2-6,`${fx(A.tip+TAB,1)} ±0.2`);
  S.hdim(bx-bsc*TAB,by+bsc*o.tabHW,bx,by+bsc*o.tabHW,by+bsc*p.billW/2+7,`tab ${TAB}`,{flip:true});
  S.vdim(bx+bsc*o.c,by+bsc*o.R,bx+bsc*o.c,by-bsc*o.R,bx+bsc*A.tip+7,`${fx(p.billW,1)} ±0.2`);
  S.vdim(bx-bsc*TAB,by+bsc*o.tabHW,bx-bsc*TAB,by-bsc*o.tabHW,bx-bsc*TAB-5,`${fx(2*o.tabHW,1)}`);
  if(bill.holeOK) S.hdim(bx,by,bx+bsc*p.tieU,by,by+bsc*p.billW/2+14,`Ø2.2 @ ${fx(p.tieU,1)}`);
  // ---------- SPECIFIC TOLERANCES (right)
  const bp=ballastPocket(p);
  sheetTable(S,240,Math.max(yS,150)+2,[{h:'Feature',w:100},{h:'Tolerance',w:66,a:'end'}],[['Overall body length L','±0.3 mm'],['Weight, ready to fish','±0.3 g'],['Bill angle','±1°'],['Hanger X positions','±0.3 mm'],
    ['Bill slot width (billT +)','+0.10 / +0.20 mm'],['Body height / width','±0.3 / ±0.2 mm'],['Wall thickness','±0.15 mm'],['Bill thickness','±0.1 mm'],['Eye centre (x, z)','±0.5 mm'],
    [bp&&bp.fix==='rattle'?'Rattle chamber Ø / length':'Ballast pocket Ø / length',bp?`+0.1 / +0.5 mm`:'—'],['Everything else','ISO 2768-m']],{title:'SPECIFIC TOLERANCES'});
  titleBlock(S,rel,hash,2,`sect. ${secTxt} · bill ${bsc>=1?bsc+':1':'1:2'}`);
  if(rel.gate&&rel.gate.watermark) S.watermark(W,H,rel.gate.watermark);
  return {W,H,items:S.it,scale:secTxt};
}
function tableHeader(S,rel,hash,n,title){
  S.text(16,21,DT.t,`${rel.modelCode} · ${rel.sku} · Rev ${rel.meta.rev} (${rel.meta.status}) — ${title}`,{b:true});
  S.text(404,280.5,DT.s,`sheet ${n} / ${N_SHEETS} · SHA-256 ${(hash||'').slice(0,16)}…`,{a:'end'});
}
/* sheet 3: BOM, costing, packaging */
function tablesModel(rel,hash){
  const S=sheet(), W=420, H=297, c=rel.costing, k=rel.pack; sheetFrame(S,W,H);
  tableHeader(S,rel,hash,3,'BOM, costing and packaging');
  let y=sheetTable(S,16,34,[{h:'#',w:7},{h:'Part no.',w:37},{h:'Description',w:70,wrap:true},{h:'Spec',w:72,wrap:true},{h:'Size',w:34,wrap:true},{h:'Rated kg',w:18,a:'end'},{h:'Mass g',w:19,a:'end'},
    {h:'Supplier',w:38,wrap:true},{h:'Unit USD',w:20,a:'end'},{h:'Qty',w:10,a:'end'},{h:'MOQ',w:18,a:'end'},{h:'Lead d',w:15,a:'end'},{h:'Ext USD',w:19,a:'end'},{h:'Lure',w:12}],
    rel.bom.map(r=>[r.item,r.partNo,r.desc,r.spec,r.size,+r.ratedKg?fx(+r.ratedKg,1):'',fx(+r.mass_g,3),r.supplier,fx(+r.unitCostUSD,3),r.qty,r.moq,r.leadTimeDays,fx(r.extUSD,3),r.inLure?'yes':'no']),{title:'BILL OF MATERIALS'});
  const bm=rel.bom.filter(r=>r.inLure).reduce((s,r)=>s+(+r.mass_g)*(+r.qty),0);
  S.text(16,y+5,DT.s,`BOM mass in lure ${fx(bm,2)} g · model ${fx(rel.A.M,2)} g · parts cost ${fx(rel.bom.reduce((s,r)=>s+r.extUSD,0),3)} USD per lure`);
  const y0=y+16;
  let y2=sheetTable(S,16,y0,[{h:`Cost line per unit (${c.currency})`,w:96},{h:c.currency,w:22,a:'end'}],c.lines.map(l=>[l[0],fx(l[1],3)]).concat([['Variable cost (unit cost)',fx(c.variable,3)],[`Margin ${c.marginPct} % (on unit cost only)`,fx(c.margin,3)],[`FOB excl. tooling`,fx(c.fobEx,3)]]),
    {title:'COSTING',hl:(r)=>/^(Variable|FOB)/.test(r[0])?'#f1efe9':null});
  const tx=140; S.text(tx,y0-1.6,DT.t,'FOB BY QUANTITY',{b:true});
  let y3=sheetTable(S,tx,y0,[{h:'Qty',w:16,a:'end'},{h:'FOB excl.',w:24,a:'end'},{h:'Tooling/u',w:24,a:'end'},{h:'FOB incl.',w:36,a:'end'}],c.tiers.map(t=>[t.qty,fx(t.fobEx,3),fx(t.amort,3),fx(t.fobIncl,3)]));
  y3+=6; S.text(tx,y3,DT.s,`TOOLING (one-off NRE): ${fx(c.tooling,0)} ${c.currency}`,{b:true}); y3+=DT.s*DT.lh;
  wrapTxt(`Mold ${fx(rel.cost.moldUSD,0)} + bill die ${fx(rel.cost.billToolUSD,0)}, invoiced separately, not inside FOB. "FOB incl." = FOB excl. + tooling ÷ qty (amortised, info only).`,100,DT.s)
    .concat(wrapTxt(`Terms: ${c.incoterm||'Incoterm TBD'} · currency ${c.currency} · rates dated ${c.rateDate||'TBD'}.`,100,DT.s)).forEach(l=>{ S.text(tx,y3,DT.s,l); y3+=DT.s*DT.lh; });
  // packaging block
  const px=246;
  S.text(px,y0-1.6,DT.t,'PACKAGING',{b:true});
  sheetTable(S,px,y0,[{h:'Item',w:44,wrap:true},{h:'Value',w:116,wrap:true}],[
    ['SKU',k.sku],['EAN-13',k.ean.ok?k.ean.full:(rel.pkg.ean13?rel.pkg.ean13+' — INVALID: '+k.ean.msg:'not set')],
    ['Lure envelope incl. hooks',`${fx(k.env.L,1)} × ${fx(k.env.H,1)} × ${fx(k.env.W,1)} mm (L × H × W)`],
    ['Blister inner (+5 mm)',`${fx(k.blister.L,0)} × ${fx(k.blister.H,0)} × ${fx(k.blister.D,0)} mm, PET 0.3 mm`],
    ['Backing card',`${k.card.W} × ${k.card.H} mm, 350 gsm, Euro hang hole`],['Packed unit',`${fx(k.unitG,1)} g`],
    ['Inner box',`${k.innerQty} pcs · ${k.inner.W} × ${k.inner.H} × ${k.inner.D} mm`],
    ['Export carton',`${k.cartonQty} pcs = ${k.nInner} inners (${k.carton?k.carton.grid.join('×'):'—'}) · ${k.carton?k.carton.dims.map(v=>fx(v,0)).join(' × '):'—'} mm · ${fx(k.grossKg,1)} kg gross`],
    ['Card copy EN',k.copyEN],['Card copy BM',k.copyBM]].concat(k.checks.filter(x=>x[0]!=='o').map(x=>[x[0]==='e'?'CHECK (error)':'Check (warning)',x[1]])),
    {color:(r,j)=>/error|INVALID/.test(r[0]+r[1])?'#b00020':null});
  if(rel.gate&&rel.gate.watermark) S.watermark(W,H,rel.gate.watermark);
  return {W,H,items:S.it};
}
/* sheet 4: QC, DFM, colourway, revisions, release gate */
function tablesModel2(rel,hash){
  const S=sheet(), W=420, H=297; sheetFrame(S,W,H);
  tableHeader(S,rel,hash,4,'QC, DFM, colourway and revisions');
  let y=sheetTable(S,16,34,[{h:'Criterion',w:62,wrap:true},{h:'Target',w:20,a:'end'},{h:'Tol',w:18,a:'end'},{h:'Unit',w:14},{h:'Method',w:88,wrap:true}],
    rel.qc.map(q=>[q.label,q.type==='bool'?'Y':fx(q.target,2),q.tol,q.unit,q.method]),{title:'QC ACCEPTANCE (tank / lake test)'});
  y+=6; wrapTxt('Sampling ISO 2859-1 / ANSI Z1.4 general level II, AQL 2.5 (major). Lots 501–1200: n = 80, Ac 5 Re 6; 1201–3200: n = 125, Ac 7 Re 8; 3201–10000: n = 200, Ac 10 Re 11. Critical defects (hook / ring opening, bill crack, leak): Ac 0.',200,DT.s)
    .forEach(l=>{ S.text(16,y,DT.s,l); y+=DT.s*DT.lh; });
  y+=8; S.text(16,y,DT.t,'COLOURWAY',{b:true}); y+=6.5;
  y=sheetKV(S,16,y,200,[['Code · name',`${rel.cw.code} · ${rel.cw.name}`],['Finish · paint level',`${rel.cw.finish} · ${rel.cw.complexity}`],['Pantone / RAL',rel.cw.pantone||'TBD'],['Layers',rel.cw.layers]],{kw:44,wrap:true});
  y+=6; S.text(16,y,DT.t,'REVISION HISTORY',{b:true}); y+=6.5;
  const cl=rel.meta.changelog.slice(-5).reverse(); if(!cl.length){ S.text(16,y,DT.s,'— no logged changes —'); y+=5; }
  cl.forEach(e=>{ wrapTxt(`Rev ${e.rev} · ${e.date} · ${e.status} · ${e.changes.join('; ')}`,200,DT.s).slice(0,2).forEach(l=>{ if(y<284) S.text(16,y,DT.s,l); y+=DT.s*DT.lh; }); });
  const dx=230; let yy=34; S.text(dx,yy-1.6,DT.t,'DFM CHECKS',{b:true}); yy+=5;
  const ord={e:0,w:1,i:2,o:3};
  rel.dfm.slice().sort((a,b)=>ord[a[0]]-ord[b[0]]).forEach(([k,t])=>{ const col=k==='e'?'#b00020':k==='w'?'#8a5a00':k==='i'?'#333':'#1d5e2f';
    wrapTxt((k==='e'?'✗ ':k==='w'?'! ':k==='i'?'i ':'✓ ')+t,174,DT.s).forEach((l,i)=>{ if(yy<230) S.text(dx+(i?3:0),yy,DT.s,l,{c:col}); yy+=DT.s*DT.lh; }); yy+=1; });
  const G=rel.gate; yy=Math.max(yy+6,238); S.text(dx,yy,DT.t,'RELEASE GATE',{b:true}); yy+=6.5;
  (G.ok?[`OK: sign-off, Pantone / RAL and DFM are complete.${G.production?' Released for production.':' Status '+rel.meta.status+'.'}`]:['Missing: '+G.missing.join('; ')]).concat(G.warn.length?['Note: '+G.warn.join('; ')]:[])
    .forEach(t=>wrapTxt(t,174,DT.s).forEach(l=>{ if(yy<276) S.text(dx,yy,DT.s,l,{c:G.ok?'#1d5e2f':'#b00020'}); yy+=DT.s*DT.lh; }));
  if(rel.gate&&rel.gate.watermark) S.watermark(W,H,rel.gate.watermark);
  return {W,H,items:S.it};
}
function sheetModels(rel,hash){ return [drawingModel(rel,hash),drawingModel2(rel,hash),tablesModel(rel,hash),tablesModel2(rel,hash)]; }
const SVG_FONT={sans:"Arial, Helvetica, system-ui, sans-serif",mono:"'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace"};
function sheetSVG(m,opts={}){
  const e=v=>String(v).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])), n=v=>+v.toFixed(3);
  const st=o=>`stroke="${o.c}" stroke-width="${o.w}"${o.dash?` stroke-dasharray="${o.dash.join(' ')}"`:''}`;
  const body=m.items.map(o=>{
    if(o.t==='line') return `<line x1="${n(o.x1)}" y1="${n(o.y1)}" x2="${n(o.x2)}" y2="${n(o.y2)}" ${st(o)}/>`;
    if(o.t==='poly') return `<${o.closed?'polygon':'polyline'} points="${o.pts.map(q=>n(q[0])+','+n(q[1])).join(' ')}" fill="${o.fill||'none'}" ${o.w?st(o):'stroke="none"'} stroke-linejoin="round"/>`;
    if(o.t==='circle') return `<circle cx="${n(o.cx)}" cy="${n(o.cy)}" r="${n(o.r)}" fill="${o.fill||'none'}" ${st(o)}/>`;
    if(o.t==='text') return `<text x="${n(o.x)}" y="${n(o.y)}" font-size="${n(o.s)}"${o.mono?` font-family="${SVG_FONT.mono}"`:''}${o.b?' font-weight="bold"':''}${o.a!=='start'?` text-anchor="${o.a}"`:''}${o.c!=='#000'?` fill="${o.c}"`:''}${o.op!=null?` fill-opacity="${o.op}"${o.wm?' class="watermark"':''}`:''}${o.rot?` transform="rotate(${n(o.rot)} ${n(o.x)} ${n(o.y)})"`:''}>${e(o.txt)}</text>`;
    return ''; }).join('\n');
  const size=opts.inline?`width="100%" style="max-width:${m.W*3}px;height:auto;display:block"`:`width="${m.W}mm" height="${m.H}mm"`;
  return `<svg xmlns="http://www.w3.org/2000/svg" ${size} viewBox="0 0 ${m.W} ${m.H}" font-family="${SVG_FONT.sans}">\n<rect width="${m.W}" height="${m.H}" fill="#fff"/>\n${body}\n</svg>`;
}
function drawingSVG(rel,hash){ return sheetSVG(drawingModel(rel,hash)); }
/* jsPDF standard fonts are WinAnsi (Latin-1 + a few): keep ± ° Ø × · ³ ², map the rest to ASCII so nothing prints as "?" */
const PDF_MAP={'≈':'~','≤':'<=','≥':'>=','−':'-','→':'->','←':'<-','↔':'<->','✓':'OK','✗':'X','✕':'X','…':'...','–':'-','—':'-','‘':"'",'’':"'",'“':'"','”':'"','Δ':'d','●':'*','▸':'>','▾':'v'};
function pdfSafe(t){ return String(t).replace(/[^\x20-\x7E\xA0-\xFF]/g,ch=>{ if(PDF_MAP[ch]!==undefined) return PDF_MAP[ch]; const b=ch.normalize('NFD').replace(/[̀-ͯ]/g,''); return /^[\x20-\x7E]+$/.test(b)?b:''; }); }
/* draws a sheet model with jsPDF vector primitives (no rasterising) */
function sheetPDF(doc,m){
  const rgb=h=>{ let x=String(h).replace('#',''); if(x.length===3) x=x.split('').map(c=>c+c).join(''); const c=parseInt(x,16)||0; return [(c>>16)&255,(c>>8)&255,c&255]; };
  const gs=op=>{ try{ if(doc.GState&&doc.setGState){ doc.setGState(new doc.GState({opacity:op,'stroke-opacity':op})); return true; } }catch(e){} return false; };
  m.items.forEach(o=>{
    if(o.t!=='text'){ doc.setDrawColor(...rgb(o.c)); doc.setLineWidth(o.w||0.01); doc.setLineDashPattern(o.dash||[],0); if(o.fill) doc.setFillColor(...rgb(o.fill)); }
    const style=o.fill?(o.w?'FD':'F'):'S';
    if(o.t==='line') doc.line(o.x1,o.y1,o.x2,o.y2);
    else if(o.t==='poly'){ if(o.pts.length<2) return; const d=[]; for(let i=1;i<o.pts.length;i++) d.push([o.pts[i][0]-o.pts[i-1][0],o.pts[i][1]-o.pts[i-1][1]]); doc.lines(d,o.pts[0][0],o.pts[0][1],[1,1],o.closed?style:'S',o.closed); }
    else if(o.t==='circle') doc.circle(o.cx,o.cy,o.r,style);
    else if(o.t==='text'){ doc.setFont(o.mono?'courier':'helvetica',o.b?'bold':'normal'); doc.setFontSize(o.s*72/25.4);
      let col=rgb(o.c), alpha=false; if(o.op!=null){ alpha=gs(o.op); if(!alpha) col=col.map(v=>Math.round(255-(255-v)*o.op)); }
      doc.setTextColor(...col);
      const t=pdfSafe(o.txt), w=doc.getTextWidth(t), k=o.a==='middle'?0.5:o.a==='end'?1:0, r=o.rot*Math.PI/180;
      doc.text(t,o.x-w*k*Math.cos(r),o.y-w*k*Math.sin(r),o.rot?{angle:-o.rot}:undefined);
      if(alpha) gs(1); }
  });
  doc.setLineDashPattern([],0);
}

/* ============================== release documents (pure) ============================== */
const csvCell=v=>{ const t=v==null?'':String(v); return /[",\n;]/.test(t)?'"'+t.replace(/"/g,'""')+'"':t; };
const csvOf=rows=>rows.map(r=>r.map(csvCell).join(',')).join('\n')+'\n';
const BOM_COLS=['item','role','partNo','desc','spec','size','finish','ratedKg','mass_g','supplier','unitCostUSD','qty','moq','leadTimeDays','extUSD','inLure'];
function bomCSV(rel){ return csvOf([BOM_COLS].concat(rel.bom.map(r=>BOM_COLS.map(k=>k==='extUSD'?fx(r.extUSD,4):k==='inLure'?(r.inLure?'yes':'no'):r[k])))); }
function costingCSV(rel){ const c=rel.costing, rows=[['section','item','qty','usd']];
  rows.push(['terms','currency','',c.currency],['terms','incoterm','',c.incoterm],['terms','rates dated','',c.rateDate||'TBD']);
  c.lines.forEach(l=>rows.push(['per-unit',l[0],'',fx(l[1],4)])); rows.push(['per-unit','Variable cost (unit cost)','',fx(c.variable,4)]);
  rows.push(['per-unit',`Margin ${c.marginPct}% on unit cost`,'',fx(c.margin,4)],['per-unit','FOB excl. tooling','',fx(c.fobEx,4)]);
  rows.push(['one-off','Tooling NRE (mold + bill die), not in FOB','',fx(c.tooling,2)]);
  COST_ITEMS.forEach(([k,l,u])=>rows.push(['rate',`${l} (${u})`,'',rel.cost[k]]));
  c.tiers.forEach(t=>{ rows.push(['tier','FOB excl. tooling',t.qty,fx(t.fobEx,4)],['tier','tooling per unit (amortised, info)',t.qty,fx(t.amort,4)],['tier','FOB incl. amortised tooling',t.qty,fx(t.fobIncl,4)]); });
  return csvOf(rows); }
function qcMarkdown(rel,hash){
  const q=rel.qc, L=[`# QC acceptance criteria — ${rel.modelCode} (${rel.sku}) rev ${rel.meta.rev}`,'',`Spec SHA-256: \`${hash}\``,'',
    `Class **${rel.cls}** in 28 °C fresh water · weight ${fx(rel.A.M,2)} g ±0.3 · net buoyancy ${fx(rel.A.net,2)} g · line for depth tests: ${LINES[rel.p.line].n}.`,'',
    '| Key | Criterion | Target | Tolerance | Unit | Method |','|---|---|---:|---:|---|---|'];
  q.forEach(c=>L.push(`| ${c.key} | ${c.label} | ${c.type==='bool'?'Y':fx(c.target,2)} | ${c.tol} | ${c.unit} | ${c.method} |`));
  L.push('','## Sampling (ISO 2859-1 / ANSI Z1.4, general inspection level II)','','| Lot size | Sample | AQL 2.5 major Ac / Re | Critical |','|---|---:|---|---|',
    '| 281–500 | 50 | 3 / 4 | Ac 0 |','| 501–1 200 | 80 | 5 / 6 | Ac 0 |','| 1 201–3 200 | 125 | 7 / 8 | Ac 0 |','| 3 201–10 000 | 200 | 10 / 11 | Ac 0 |','',
    '**Critical** (any one rejects the lot): hook, ring or harness opens below the proof load; bill cracks or pulls out; body leaks (weight gain > 0.1 g after 30 min at 1 m depth).',
    '**Major**: weight, float rate, running depth or tracking out of tolerance; roll-over at 1.0 m/s; seam step > 0.15 mm.',
    '**Minor**: paint defects outside the colourway standard, eye misalignment > 0.5 mm.','',
    '## Tank / lake test procedure','','1. Condition samples 2 h in 28 ± 2 °C fresh water. Weigh dry with hooks and rings fitted.',
    '2. Float / sink rate: release at 40 cm depth, time over 30 cm. Positive = rising.',
    `3. Running depth: tow or cast on ${LINES[rel.p.line].n} at 0.5 and 1.0 m/s (GPS / pacer), depth logger clipped at the line tie, read after 20 m.`,
    '4. Tracking: straight tow over 3 m against a lane line; record worst lateral deviation (mm). Tune the line tie if > 50 mm.',
    '5. Roll-over: 10 s at 1.0 m/s; any blow-out or roll past 90° = N.',
    '6. Proof load: pull gauge on each hanger and the line tie, hold 10 s; nothing may open.','',
    'Record results in `tank_test.csv` (one row per sample, columns as in the template) and import it in Umpan Lab → Release → QC to get the pass/fail table.','');
  return L.join('\n');
}
function readmeTxt(rel,hash,files,extra){
  const g=rel.geom, p=rel.p;
  const lines=[`UMPAN LAB RELEASE PACK — ${rel.name||rel.modelCode}`,`Model ${rel.modelCode} · SKU ${rel.sku} · Rev ${rel.meta.rev} · Status ${rel.meta.status} · ${isoDate()}`,
    rel.gate.watermark?`*** ${rel.gate.watermark} ***${rel.gate.missing.length?' Missing: '+rel.gate.missing.join('; '):''}`:'Released for production: sign-off, Pantone / RAL and DFM complete.',
    `Spec SHA-256 (canonical spec JSON in design.json → "spec", keys sorted, no whitespace): ${hash}`,'',
    'Units: millimetres. Axes: X nose (0) → tail, Z up, Y width. Parting plane Y = 0.','body_L = −Y half (lure\'s left seen from behind), body_R = +Y half.','',
    'FILES'];
  files.forEach(([n,d])=>lines.push(`  ${n.padEnd(22)} ${d}`));
  lines.push('','GEOMETRY',`  Injection ABS two-half mold. Wall ${fx(g.wall,2)} mm, extra seam land (flange) ${fx(g.flange,2)} mm at the dorsal / ventral seam, draft ${p.draftDeg}° on pins and holes.`,
    g.cav?`  Hollow cavity from x ${fx(g.cav.x0,1)} to ${fx(g.cav.x1,1)} mm. Nose and tail are solid plugs.`:'  NO CAVITY (solid body): see DFM in the tech pack.',
    `  Shell volume ${fx(g.Vshell/1000,3)} cm³ (body_L ${fx(g.VL/1000,3)}, body_R ${fx(g.VR/1000,3)} cm³ incl. pins / holes).`,
    `  Mesh check: body_L ${g.checkL.watertight?'watertight':'NOT watertight'}, body_R ${g.checkR.watertight?'watertight':'NOT watertight'}, body_shell ${g.checkShell.watertight?'watertight':'NOT watertight'} (every edge shared by exactly two triangles).`,
    g.slot&&g.info.slotOK?`  Bill slot pocket in both halves: ${fx(g.slot.width,2)} wide (billT +0.15) × ${fx(g.slot.d,2)} deep per half × ${fx(g.slot.len,1)} long. It opens at the chin and is modelled with vertical walls (0° draft).`:'  Bill slot: not modelled (see DFM).',
    g.pins.length?`  Alignment pins are real geometry: Ø${PROD.pinD} × ${PROD.pinH} mm bosses on body_L, Ø${PROD.holeD} × ${fx(PROD.pinH+PROD.holeExtra,1)} mm blind holes in body_R (not separate bodies), at ${g.pins.map(q=>`x ${fx(q.x,1)} z ${fx(q.z,1)}`).join(' and ')}.`:'  No alignment pins.',
    '  Not modelled (TODO for the toolmaker): harness channel on the parting face, ballast pocket / rattle chamber, eye recesses (all dimensioned on the drawing).',
    `  Ballast fixing: ${p.ballN?BALLFIX[p.ballFix||'pocket']:'no ballast'}. Eyes: 3D sticker Ø${fx(rel.eye.d,1)} at x ${fx(rel.eye.x,1)} z ${fx(rel.eye.z,1)}.`,
    '  body_shell.stl is the closed hollow shell (outer skin + cavity, two closed surfaces) without pins, for volume / mass checks and SLA masters.',
    '  sections.csv gives the exact superellipse sections at 25 stations (outer and, where hollow, inner) for re-lofting in CAD.','',
    'MASS (fresh water, ready to fish)',`  ${fx(rel.A.M,2)} g · displacement ${fx(rel.A.Vd/1000,2)} cm³ · net buoyancy ${fx(rel.A.net,2)} g · class ${rel.cls}`);
  if(extra) lines.push('',extra);
  return lines.join('\n')+'\n';
}
function escH(s){ return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function htmlTable(cols,rows,cls){ return `<table class="${cls||''}"><thead><tr>${cols.map(c=>`<th${c.r?' class="r"':''}>${escH(c.h)}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map((v,i)=>`<td${cols[i].r?' class="r"':''}>${escH(v)}</td>`).join('')}</tr>`).join('')}</tbody></table>`; }
function techpackHTML(rel,hash,qcRes){
  const {A,p,meta,cw}=rel, c=rel.costing;
  const so=meta.signoff;
  const qcRows=qcRes?qcRes.rows.map(r=>[r.id,...r.cells.map(x=>x.v==null?'—':(typeof x.v==='number'?fx(x.v,2):x.v)+(x.ok===false?' ✗':x.ok===true?' ✓':'')),r.pass===null?'—':r.pass?'PASS':'FAIL']):null;
  return `<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>Tech pack ${escH(rel.modelCode)} rev ${escH(meta.rev)}</title>
<style>
@page{size:A3 landscape;margin:8mm}
body{font-family:Arial,Helvetica,system-ui,sans-serif;color:#1c2826;margin:18px;font-size:12px}
h1{font-size:20px;margin:0 0 4px} h2{font-size:14px;margin:18px 0 6px;color:#1f6f6a;text-transform:uppercase;letter-spacing:.05em}
.mono,code{font-family:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace}
table{border-collapse:collapse;width:100%;margin:4px 0} th,td{border:1px solid #cfc9bb;padding:3px 6px;text-align:left;vertical-align:top} th{background:#eeeae1} td.r,th.r{text-align:right}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px} .sheet{border:1px solid #999;margin:8px 0;page-break-after:always}
.wm{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-35deg);font:700 64px Arial,sans-serif;color:rgba(198,40,40,.16);white-space:nowrap;pointer-events:none;z-index:9}
.nfp{background:#fff0f0;border:1px solid #efb1b1;color:#9e1f1f;padding:6px 10px;font-weight:700} li.i{color:#444}
li.e{color:#a1001b} li.w{color:#7a5200} li.o{color:#1d5e2f} .meta{color:#555}
@media print{ .noprint{display:none} body{margin:0} }
</style></head><body>
${rel.gate&&rel.gate.watermark?`<div class="wm">${escH(rel.gate.watermark)}</div><p class="nfp">${escH(rel.gate.watermark)}${rel.gate.missing.length?' · missing: '+escH(rel.gate.missing.join('; ')):''}</p>`:''}
<h1>${escH(rel.name||rel.modelCode)} — tech pack</h1>
<div class="meta">Model <b>${escH(rel.modelCode)}</b> · SKU <b class="mono">${escH(rel.sku)}</b> · Rev <b>${escH(meta.rev)}</b> · Status <b>${escH(meta.status)}</b> · ${isoDate()}<br>Spec SHA-256 <code>${escH(hash)}</code></div>
<div class="sheet">${sheetSVG(drawingModel(rel,hash),{inline:true})}</div>
<div class="sheet">${sheetSVG(drawingModel2(rel,hash),{inline:true})}</div>
<div class="grid"><div>
<h2>Spec</h2>${htmlTable([{h:'Item'},{h:'Value',r:1}],[['Class (28 °C fresh water)',`${rel.cls} (net ${fx(A.net,2)} g)`],['Weight ready to fish',`${fx(A.M,2)} g ±0.3`],['Displacement',`${fx(A.Vd/1000,2)} cm³`],
  [A.vPause>=0?'Float rate':'Sink rate',`${fx(Math.abs(A.vPause*100),1)} cm/s`],['Action (est.)',`${fx(rel.S05.f,1)} Hz @0.5 m/s · ${fx(rel.S10.f,1)} Hz @1.0 m/s`],
  ['Body',`ABS injection, wall ${fx(rel.geom.wall,2)} mm, shell ${fx(rel.geom.Vshell/1000,2)} cm³, ${fx(A.mBody,2)} g`],['Bill',`${BILL_MATS[p.billMat].n} t=${fx(p.billT,1)} mm, ${fx(A.tip,1)} × ${fx(p.billW,1)} mm @ ${p.billAng}°`]].concat(
  Object.entries(LINES).map(([k,v])=>[`Target depth, ${v.n}`,`${fx(A.depthBase*v.f,1)} m (cast) · ${fx(A.depthBase*v.f*1.5,1)} m (troll)`])))}
<h2>Colourway</h2>${htmlTable([{h:'Field'},{h:'Value'}],[['Code',cw.code],['Name',cw.name],['Finish',cw.finish],['Paint complexity',String(cw.complexity)],['Pantone / RAL',cw.pantone||'TBD'],['Layer stack',cw.layers],
  ['Preview colours',`back ${rel.st.PAINT.back} · flank ${rel.st.PAINT.side} · belly ${rel.st.PAINT.belly}${rel.st.PAINT.headOn?' · head '+rel.st.PAINT.head:''}${rel.st.PAINT.bars?' · bars':''}`]])}
<h2>Revision &amp; sign-off</h2>${htmlTable([{h:'Role'},{h:'Name'},{h:'Date'}],[['Drawn',so.drawn.name,so.drawn.date],['Checked',so.checked.name,so.checked.date],['Approved',so.approved.name,so.approved.date]])}
${htmlTable([{h:'Rev'},{h:'Date'},{h:'Status'},{h:'Changes'}],meta.changelog.slice().reverse().map(e=>[e.rev,e.date,e.status,e.changes.join('; ')]))}
</div><div>
<h2>DFM checks</h2><ul>${rel.dfm.map(([k,t])=>`<li class="${k}">${escH(t)}</li>`).join('')}</ul>
<h2>Costing (${escH(c.currency)} per unit · ${escH(c.incoterm||'Incoterm TBD')} · rates ${escH(c.rateDate||'TBD')})</h2>${htmlTable([{h:'Line'},{h:c.currency,r:1}],c.lines.map(l=>[l[0],fx(l[1],3)]).concat([['Variable cost (unit cost)',fx(c.variable,3)],[`Margin ${c.marginPct} % (unit cost only)`,fx(c.margin,3)],['FOB excl. tooling',fx(c.fobEx,3)]]))}
${htmlTable([{h:'Qty',r:1},{h:'FOB excl. tooling',r:1},{h:'Tooling / unit (amortised)',r:1},{h:'FOB incl. amortised tooling',r:1}],c.tiers.map(t=>[t.qty,fx(t.fobEx,3),fx(t.amort,3),fx(t.fobIncl,3)]))}
<p><b>Tooling, one-off NRE (not in FOB): ${fx(c.tooling,0)} ${escH(c.currency)}</b> (mold ${fx(rel.cost.moldUSD,0)} + bill die ${fx(rel.cost.billToolUSD,0)}).</p>
<h2>Packaging</h2>${htmlTable([{h:'Item'},{h:'Value'}],[['SKU',rel.pack.sku],['EAN-13',rel.pack.ean.ok?rel.pack.ean.full:(rel.pkg.ean13?rel.pkg.ean13+' (INVALID: '+rel.pack.ean.msg+')':'not set')],['Lure envelope incl. hooks',`${fx(rel.pack.env.L,1)} × ${fx(rel.pack.env.H,1)} × ${fx(rel.pack.env.W,1)} mm`],['Blister inner',`${fx(rel.pack.blister.L,0)} × ${fx(rel.pack.blister.H,0)} × ${fx(rel.pack.blister.D,0)} mm`],['Card',`${rel.pack.card.W} × ${rel.pack.card.H} mm`],['Inner',`${rel.pack.innerQty} pcs · ${rel.pack.inner.W} × ${rel.pack.inner.H} × ${rel.pack.inner.D} mm`],['Carton',`${rel.pack.cartonQty} pcs · ${rel.pack.carton?rel.pack.carton.dims.map(v=>fx(v,0)).join(' × '):'—'} mm · ${fx(rel.pack.grossKg,1)} kg`],['Card copy EN',rel.pack.copyEN],['Card copy BM',rel.pack.copyBM]])}
<ul>${rel.pack.checks.map(([k,t])=>`<li class="${k}">${escH(t)}</li>`).join('')}</ul>
</div></div>
<h2>Bill of materials</h2>${htmlTable([{h:'#'},{h:'Part no.'},{h:'Description'},{h:'Spec'},{h:'Size'},{h:'Finish'},{h:'Rated kg',r:1},{h:'Mass g',r:1},{h:'Supplier'},{h:'Unit USD',r:1},{h:'Qty',r:1},{h:'MOQ',r:1},{h:'Lead days',r:1},{h:'Ext USD',r:1}],
  rel.bom.map(r=>[r.item,r.partNo,r.desc,r.spec,r.size,r.finish,+r.ratedKg?fx(+r.ratedKg,1):'',fx(+r.mass_g,3),r.supplier,fx(+r.unitCostUSD,3),r.qty,r.moq,r.leadTimeDays,fx(r.extUSD,3)]))}
<h2>QC acceptance criteria</h2>${htmlTable([{h:'Key'},{h:'Criterion'},{h:'Target',r:1},{h:'Tolerance',r:1},{h:'Unit'},{h:'Method'}],rel.qc.map(q=>[q.key,q.label,q.type==='bool'?'Y':fx(q.target,2),q.tol,q.unit,q.method]))}
${qcRows?`<h2>Tank test results (${qcRes.summary.pass}/${qcRes.summary.n} samples pass)</h2>${htmlTable([{h:'Sample'}].concat(rel.qc.map(q=>({h:q.key,r:1}))).concat([{h:'Result'}]),qcRows)}`:''}
<h2>Notes</h2><ul><li>Dimensions in mm, datum nose tip; general tolerances ISO 2768-m unless stated.</li><li>Parting plane Y = 0; body_L = −Y, body_R = +Y.</li>
<li>Ballast: ${p.ballN?`${p.ballN}× Ø${p.ballD} ${escH(BALLAST[p.ballMat].n.toLowerCase())}, ${escH(BALLFIX[p.ballFix||'pocket'])}`:'none'}. Eyes: 3D sticker Ø${fx(rel.eye.d,1)} at x ${fx(rel.eye.x,1)}, z ${fx(rel.eye.z,1)}, y ±${fx(rel.eye.y,1)}; recess Ø${fx(rel.eye.recessD,1)} × ${rel.eye.recessDepth}.</li>
<li>TODO for the toolmaker: harness channel Ø${fx(+p.wireGauge+0.2,1)} on the parting face and the ballast pocket are specified on the drawing but not modelled in the halves.</li>
<li>Depth, action and float-rate figures are model estimates. Confirm them with the tank test.</li></ul>
</body></html>`;
}

/* ============================== UI: controls ============================== */
/* Stage B: the schema (GROUPS / SIM_ITEMS, above) is unchanged so saved files and the spec hash stay identical.
   Only the presentation is re-grouped and re-labelled here. Internal keys never change. */
const ctl=document.getElementById('controls');
const inputs={};
const ITEM={}; GROUPS.forEach(g=>g.items.forEach(it=>ITEM[it.k]=it)); SIM_ITEMS.forEach(it=>ITEM[it.k]=it);
/* k: [label, unit, hint, display scale] — scale converts the internal value for display (halfW ×2 = full width, fat ×100 = %) */
const LBL={
  L:['Body length','mm'], top:['Back height, above axis','mm'], bot:['Belly depth, below axis','mm'],
  halfW:['Body width (full)','mm','',2], fat:['Max-thickness station','%','% of length from the nose',100],
  taper:['Tail taper','×','higher = slimmer tail'], se:['Cross-section: round ↔ flat-sided','','2 = round, 3.5 = slab-sided'], tailR:['Tail thickness','mm'],
  billLen:['Bill length (exposed)','mm'], billW:['Bill width','mm'], billAng:['Bill angle below body axis','°','lower = deeper diving'],
  billT:['Bill thickness','mm'], tieU:['Line tie, from bill root','mm'], rootX:['Bill root position, from nose','mm'], rootZ:['Bill root position, from axis','mm','− = below the axis'],
  billMat:['Bill material'], bodyMat:['Prototype body material'], wall:['Print wall','mm','3D prints only'], infill:['Print infill','%','3D prints only'], coat:['Paint + epoxy coat','mm'],
  ballN:['Ballast balls','pcs'], ballD:['Ball diameter','mm'], ballMat:['Ballast material'], ballX:['Ballast centre, from nose','mm'], ballZ:['Ballast centre, from axis','mm','− = towards the belly'], ballFix:['Ballast fixing'],
  hookType:['Hook type'], hookStr:['Hook wire strength'], hookB:['Belly hook size'], hookT:['Tail hook size'], ring:['Split rings'],
  bellyX:['Belly hanger, from nose','mm'], tailX:['Tail hanger, inset from tail','mm'], wireGauge:['Through-wire harness'],
  prodMode:['Body build'], wallMm:['Mold wall thickness','mm','injection shell'], draftDeg:['Draft angle','°','pins / holes; skin is checked'], flangeMm:['Bond land (flange)','mm','extra wall at the seam'], pins:['Alignment pins'],
  line:['Main line'], water:['Water'], clarity:['Water clarity'],
  style:['Retrieve style'], gear:['Reel gear ratio'], spoolD:['Spool diameter','mm','line on the spool'], tps:['Cranking pace','/s','handle turns per second'],
  goTurns:['Turns before a pause','turns','stop & go'], pauseS:['Pause / slack length','s'], castDist:['Cast distance','m'], rodH:['Rod tip height','m'], bottomD:['Bottom depth','m'], target:['Target depth','m','±0.6 m band']
};
/* Design accordion: [name, basic keys, advanced keys] */
const UI_GROUPS=[
  ['Shape',['L','top','bot','halfW','fat','taper'],['se','tailR']],
  ['Bill',['billLen','billW','billAng','billMat','tieU'],['billT','rootX','rootZ']],
  ['Hardware',['hookType','hookStr','hookB','hookT','ring','bellyX','tailX','wireGauge'],[]],
  ['Ballast',['ballN','ballD','ballMat','ballX','ballZ','ballFix'],[]],
  ['Material & production',['prodMode','bodyMat','wall','wallMm'],['infill','coat','draftDeg','flangeMm','pins']],
  ['Finish',[],[]]
];
const SIM_GROUPS=[['Retrieve',['style','gear','spoolD','tps','goTurns','pauseS']],['Cast & water',['castDist','rodH','bottomD','target']],['Fishing conditions',['line','water','clarity']]];
let LOADED=null;   // parameter values at the last load: double-click a label to reset to them
const decs=s=>{ const t=String(s); return t.includes('.')?t.split('.')[1].length:0; };
function makeRow(k,adv){
  const it=ITEM[k], [l,u,hint,scRaw]=LBL[k]||[it.l,it.u||''], sc=scRaw||1, id='p-'+k;
  const row=document.createElement('div'); row.dataset.k=k;
  if(it.type==='select'){
    row.className='prow sel'+(adv?' adv':'')+(Math.max(...it.o.map(o=>String(o[1]).length))>21?' stk':'');
    row.innerHTML=`<label id="lbl-${k}" for="${id}" data-reset title="Double-click to reset">${l}</label><select id="${id}">${it.o.map(([v,n])=>`<option value="${v}">${n}</option>`).join('')}</select>`;
    const s=row.querySelector('select'); s.onchange=()=>{P[k]=s.value; changed()};
    inputs[k]={set:v=>s.value=v,row,reset:()=>{ if(LOADED&&k in LOADED){ P[k]=LOADED[k]; s.value=P[k]; changed(); } }};
  } else {
    row.className='prow'+(adv?' adv':'');
    const mn=+(it.min*sc).toFixed(6), mx=+(it.max*sc).toFixed(6), st=+(it.step*sc).toFixed(6), dp=decs(st);
    row.innerHTML=`<label id="lbl-${k}" for="${id}" data-reset title="Double-click to reset · [ ] to nudge, Shift ×10">${l}</label><input type="number" id="${id}" min="${mn}" max="${mx}" step="${st}"><span class="u" aria-hidden="true">${u||''}</span><input type="range" min="${mn}" max="${mx}" step="${st}" aria-labelledby="lbl-${k}" list="dl-${k}"><datalist id="dl-${k}"><option value="${mn}"></option></datalist>${hint?`<div class="hint">${hint}</div>`:''}`;
    const [num,rng]=row.querySelectorAll('input');
    const show=v=>(+(v*sc).toFixed(dp+2));
    rng.oninput=()=>{P[k]=(+rng.value)/sc; num.value=rng.value; changed()};
    num.onchange=()=>{ let v=+num.value; if(!isFinite(v)) v=show(P[k]); v=clamp(v,mn,mx); P[k]=v/sc; num.value=+v.toFixed(dp); rng.value=v; changed()};
    const nudge=(e,el)=>{ if(e.key!=='['&&e.key!==']') return; e.preventDefault(); const d=(e.key===']'?1:-1)*st*(e.shiftKey?10:1);
      const v=clamp(+(show(P[k])+d).toFixed(dp),mn,mx); P[k]=v/sc; num.value=v; rng.value=v; changed(); };
    num.addEventListener('keydown',e=>nudge(e,num)); rng.addEventListener('keydown',e=>nudge(e,rng));
    inputs[k]={set:v=>{const d=+(+v*sc).toFixed(dp); num.value=d; rng.value=d},row,
      tick:v=>{ const o=row.querySelector('datalist option'); if(o) o.value=+(+v*sc).toFixed(dp); },
      reset:()=>{ if(LOADED&&k in LOADED){ P[k]=LOADED[k]; inputs[k].set(P[k]); changed(); } }};
  }
  row.querySelector('label').addEventListener('dblclick',()=>{ if(row.querySelector('input:disabled,select:disabled')) return; inputs[k].reset(); toast(`${l} reset to ${fmtVal(k,LOADED&&LOADED[k])}`); });
  return row;
}
function fmtVal(k,v){ const it=ITEM[k]; if(v==null) return '—'; if(it.type==='select'){ const o=it.o.find(o=>String(o[0])===String(v)); return o?o[1]:v; } const [,u,,sc]=LBL[k]||[]; return `${+(v*(sc||1)).toFixed(3)}${u?' '+u:''}`; }
function makeGroup(name,body,opts){
  const g=document.createElement('section'); g.className='grp'+(opts.cls?' '+opts.cls:''); const gid='g-'+name.replace(/[^a-z]/gi,'').toLowerCase();
  g.innerHTML=`<h2><button class="acc" aria-expanded="false" aria-controls="${gid}" id="${gid}-h">${({'Material & production':'Material & mold'})[name]||name}<span class="n"></span></button>${opts.adv?`<label class="advt" title="Show advanced parameters"><input type="checkbox" aria-label="Advanced ${name} parameters"> Advanced</label>`:''}</h2><div class="gbody" id="${gid}" role="region" aria-labelledby="${gid}-h" hidden></div>`;
  const b=g.querySelector('.gbody'); body(b);
  const btn=g.querySelector('.acc');
  btn.onclick=()=>openGroup(g, btn.getAttribute('aria-expanded')!=='true');
  const ad=g.querySelector('.advt input'); if(ad) ad.onchange=()=>g.classList.toggle('adv-on',ad.checked);
  return g;
}
/* accordion: one group open at a time */
function openGroup(g,open){
  if(open) ctl.querySelectorAll('.grp').forEach(o=>{ if(o!==g){ o.querySelector('.acc').setAttribute('aria-expanded','false'); o.querySelector('.gbody').hidden=true; } });
  g.querySelector('.acc').setAttribute('aria-expanded',String(open)); g.querySelector('.gbody').hidden=!open;
}
function buildControls(){
  UI_GROUPS.forEach(([name,basic,adv],gi)=>{
    const g=makeGroup(name,b=>{
      basic.forEach(k=>b.appendChild(makeRow(k,false))); adv.forEach(k=>b.appendChild(makeRow(k,true)));
      if(name==='Hardware') b.insertAdjacentHTML('beforeend','<p class="note">Dashed circles in the side view show how far each hook can swing. The belly hook must not reach the line tie or the tail hook.</p>');
      if(name==='Material & production'){
        b.insertAdjacentHTML('beforeend',`<div class="prow chk"><label><input type="checkbox" id="showHalves"> Preview mold halves (opened like a book)</label></div>
          <p class="note" id="prodNote"></p>
          <p class="note">Wood bodies count as solid, so print wall and infill are ignored. A printed body must be fully sealed: any leak changes the buoyancy completely.</p>
          <p class="note" id="injNote" hidden>Injection mode: the body is a hollow ABS shell (1.05 g/cm³). Prototype material, print wall and infill apply to prototypes only.</p>`);
        b.querySelector('#showHalves').onchange=()=>changed();
      }
      if(name==='Finish') buildFinish(b);
    },{adv:adv.length>0,cls:'spec'});
    ctl.appendChild(g); if(gi===0) openGroup(g,true);
  });
  // Simulate: full-width rows, all sections visible
  const sc=document.getElementById('simctl');
  SIM_GROUPS.forEach(([name,keys],i)=>{ sc.insertAdjacentHTML('beforeend',`<div class="psub">${name}</div>`); keys.forEach(k=>sc.appendChild(makeRow(k,false))); });
  sc.insertAdjacentHTML('beforeend','<p class="note">These are angler / test settings. They are saved in the <b>sim</b> section of the design file and are never locked by a release.</p>');
  buildProductionExtras($('relctl'));
}
function buildFinish(b){
  b.innerHTML=`<div class="prow sel"><label for="pat">Paint pattern</label><select id="pat">${Object.entries(PATTERNS).map(([k,v])=>`<option value="${k}">${v.n}</option>`).join('')}</select></div>
   <div class="prow col"><label for="c-back">Back colour</label><input type="color" id="c-back" data-c="back"></div>
   <div class="prow col"><label for="c-side">Flank colour</label><input type="color" id="c-side" data-c="side"></div>
   <div class="prow col"><label for="c-belly">Belly colour</label><input type="color" id="c-belly" data-c="belly"></div>
   <div class="prow col"><label><input type="checkbox" id="headOn"> Contrast head</label><input type="color" id="c-head" data-c="head" aria-label="Head colour"></div>
   <div class="prow chk"><label><input type="checkbox" id="bars"> Tiger bars</label></div>
   <p class="note">The colourway code, Pantone / RAL and layer stack for the factory are in <b>Release</b>.</p>`;
  b.querySelector('#pat').onchange=e=>{PAINT=Object.assign({},PATTERNS[e.target.value]); P.pattern=e.target.value; const c=defaultCW(P.pattern); Object.assign(CW,{code:c.code,name:c.name,layers:c.layers,complexity:c.complexity}); syncPaint(); syncMeta(); changed()};
  b.querySelectorAll('input[type=color]').forEach(c=>c.oninput=()=>{PAINT[c.dataset.c]=c.value; changed()});
  b.querySelector('#headOn').onchange=e=>{PAINT.headOn=e.target.checked; changed()};
  b.querySelector('#bars').onchange=e=>{PAINT.bars=e.target.checked; changed()};
}
function syncPaint(){
  $('pat').value=P.pattern in PATTERNS?P.pattern:'firetiger';
  document.querySelectorAll('#controls input[type=color]').forEach(c=>c.value=PAINT[c.dataset.c]);
  $('headOn').checked=!!PAINT.headOn; $('bars').checked=!!PAINT.bars;
}
function syncControls(){ for(const k in inputs) if(k in P) inputs[k].set(P[k]); syncPaint(); syncMeta(); applyLock(); }
function setTicks(){ LOADED=JSON.parse(JSON.stringify(P)); for(const k in inputs) if(inputs[k].tick&&k in P) inputs[k].tick(P[k]); }
/* Release side panel: identity, revision, colourway (text fields live in META / CW, not P) */
function buildProductionExtras(d){
  d.insertAdjacentHTML('beforeend',`
   <div class="psub">Identity &amp; revision</div>
   <div class="lockbar side">Released: spec, colourway and BOM are locked. Change the status to edit; the revision letter then goes up.</div>
   <div class="prow sel"><label for="mFamily">Model family code</label><input type="text" id="mFamily" maxlength="6" spellcheck="false"></div>
   <div class="prow sel"><label for="mRev">Revision</label><input type="text" id="mRev" maxlength="2" spellcheck="false"></div>
   <div class="prow sel"><label for="mStatus">Status</label><select id="mStatus">${STATUSES.map(s=>`<option>${s}</option>`).join('')}</select></div>
   <p class="note mono" id="skuNote"></p>
   <div class="psub">Colourway</div>
   <div class="prow sel"><label for="cwCode">Colour code</label><input type="text" id="cwCode" maxlength="10" spellcheck="false"></div>
   <div class="prow sel"><label for="cwName">Colour name</label><input type="text" id="cwName" maxlength="40"></div>
   <div class="prow sel"><label for="cwPantone">Pantone / RAL</label><input type="text" id="cwPantone" maxlength="120" placeholder="e.g. 802 C · RAL 1026"></div>
   <div class="prow sel"><label for="cwFinish">Finish</label><select id="cwFinish">${FINISHES.map(s=>`<option>${s}</option>`).join('')}</select></div>
   <div class="prow sel stk"><label for="cwCx">Paint complexity</label><select id="cwCx">${PAINT_LEVELS.map(([v,n])=>`<option value="${v}">${n}</option>`).join('')}</select></div>
   <label class="stack" for="cwLayers">Layer stack<textarea id="cwLayers" rows="3" maxlength="300"></textarea></label>
   <p class="note">Paint pattern and preview colours are in Design → Finish. Changing the pattern pre-fills this colourway.</p>`);
  const q=id=>d.querySelector('#'+id);
  q('mFamily').onchange=e=>{ const v=e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,6); META.family=v||META.family; syncMeta(); relDirty(); };
  q('mRev').onchange=e=>{ const v=e.target.value.toUpperCase(); if(/^[A-Z]{1,2}$/.test(v)) META.rev=v; syncMeta(); relDirty(); };
  q('mStatus').onchange=e=>setStatus(e.target.value);
  q('cwCode').onchange=e=>{ const v=e.target.value.toUpperCase().replace(/[^A-Z0-9-]/g,'').slice(0,10); if(v) CW.code=v; syncMeta(); relDirty(); };
  q('cwName').onchange=e=>{ CW.name=e.target.value.slice(0,40); syncMeta(); relDirty(); };
  q('cwPantone').onchange=e=>{ CW.pantone=e.target.value.slice(0,120); syncMeta(); relDirty(); };
  q('cwFinish').onchange=e=>{ CW.finish=e.target.value; syncMeta(); relDirty(); };
  q('cwCx').onchange=e=>{ CW.complexity=+e.target.value; syncMeta(); relDirty(); };
  q('cwLayers').onchange=e=>{ CW.layers=e.target.value.slice(0,300); syncMeta(); relDirty(); };
}
function syncMeta(){
  const set=(id,v)=>{ const el=$(id); if(el&&document.activeElement!==el) el.value=v; };
  set('mFamily',META.family); set('mRev',META.rev); set('mStatus',META.status);
  set('cwCode',CW.code); set('cwName',CW.name); set('cwPantone',CW.pantone); set('cwFinish',CW.finish); set('cwCx',String(CW.complexity)); set('cwLayers',CW.layers);
  const cls=cache?buoyClass(cache.A.net):'F'; if($('skuNote')) $('skuNote').textContent=`Model ${META.family}${Math.round(P.L)} · SKU ${skuOf(META,P.L,cls,CW)} (class from current figures)`;
  $('barRev').textContent='Rev '+META.rev; const b=$('barStatus'); $('barStatusRev').textContent=META.rev+' · '; $('barStatusTxt').textContent=META.status; b.className='badge s-'+META.status; b.title=`Rev ${META.rev} · ${META.status}`;
  updateDirty();
}
function nextRev(r){ const a=r.split('').map(c=>c.charCodeAt(0)-65); let i=a.length-1; while(i>=0){ if(a[i]<25){a[i]++;break} a[i]=0;i--; } if(i<0) a.unshift(0); return a.map(n=>String.fromCharCode(65+n)).join('').slice(-2); }
/* gate check for T1 / Golden / Released (pure releaseGate on the current state) */
function gateNow(){ try{ return relModel().gate; }catch(e){ return {ok:false,missing:['release model could not be built: '+e.message],warn:[]}; } }
let GATE_MSG=null;
function setStatus(ns){
  if(!STATUSES.includes(ns)) return; const os=META.status; if(ns===os) return;
  if(GATED.includes(ns)&&STATUSES.indexOf(ns)>STATUSES.indexOf(os)){ const g=gateNow();
    if(!g.ok){ GATE_MSG={status:ns,missing:g.missing}; syncMeta(); if($('mStatus')) $('mStatus').value=os; toast(`${ns} refused: ${g.missing.length} item${g.missing.length>1?'s':''} missing (see Release gate)`);
      if(MODE!=='release') setMode('release'); else renderRelease(); const gc=document.getElementById('gateCard'); if(gc){ gc.scrollIntoView({block:'nearest'}); gc.classList.remove('flash'); void gc.offsetWidth; gc.classList.add('flash'); } return; } }
  GATE_MSG=null;
  const toInj=STATUSES.indexOf(ns)>=1&&P.prodMode!=='inject'; if(toInj){ P.prodMode='inject'; syncControls(); changed(); }
  if(os==='Released'){ const was=META.rev; META.rev=nextRev(META.rev); META.changelog.push({rev:META.rev,date:isoDate(),status:ns,changes:[`Reopened after release of rev ${was}`]}); }
  else logChanges(`Status ${os} → ${ns}`);
  META.status=ns; syncMeta(); applyLock(); relDirty(); toast((ns==='Released'?'Released: spec inputs are locked':'Status: '+ns)+(toInj?' · build mode set to Injection ABS':''));
}
/* Released => product inputs locked; injection mode => prototype material inputs disabled */
function applyLock(){
  const locked=META.status==='Released', S=paramSchema();
  for(const k in inputs){ const it=inputs[k]; if(!it.row) continue; const spec=S[k]&&S[k].sec!=='sim';
    const inj=P.prodMode==='inject'&&['bodyMat','wall','infill'].includes(k);
    it.row.querySelectorAll('input,select').forEach(el=>el.disabled=(spec&&locked)||inj); it.row.classList.toggle('dim',inj); }
  document.querySelectorAll('#pat,#controls input[type=color],#headOn,#bars,#mFamily,#mRev,#cwCode,#cwName,#cwPantone,#cwFinish,#cwCx,#cwLayers').forEach(el=>el.disabled=locked);
  if($('injNote')) $('injNote').hidden=P.prodMode!=='inject';
  document.body.classList.toggle('locked',locked);
  ctl.querySelectorAll('.grp .acc .n').forEach(n=>n.textContent='');
}

/* ============================== 3D ============================== */
const view=document.getElementById('view');
const renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
view.insertBefore(renderer.domElement,view.firstChild);
renderer.domElement.setAttribute('role','img'); renderer.domElement.setAttribute('aria-label','3D model of the lure');
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(35,1,1,5000);
camera.up.set(0,0,1);
const controls=new THREE.OrbitControls(camera,renderer.domElement);
controls.enableDamping=true;
/* B9: render on demand. OrbitControls fires 'change' on every camera move, including the damping tail after release. */
controls.addEventListener('change',()=>requestRender()); controls.addEventListener('start',()=>requestRender());
scene.add(new THREE.HemisphereLight(0xffffff,0x8a7f6a,0.85));
const sun=new THREE.DirectionalLight(0xffffff,0.75); sun.position.set(80,-120,160); scene.add(sun);
const fill=new THREE.DirectionalLight(0xffffff,0.3); fill.position.set(-100,120,40); scene.add(fill);
let grid=null, gridBaseX=0;
const bodyMat=new THREE.MeshStandardMaterial({vertexColors:true,roughness:0.28,metalness:0.08});
const billMatMesh=new THREE.MeshPhysicalMaterial({color:0xdfeff7,roughness:0.08,metalness:0,transparent:true,opacity:0.55});
const steelMat=new THREE.MeshStandardMaterial({color:0x3b3f46,metalness:0.85,roughness:0.32});
const ringMat=new THREE.MeshStandardMaterial({color:0xb9bec4,metalness:0.9,roughness:0.25});
// hierarchy: pivot (animated) -> lure (offset) -> parts
const pivot=new THREE.Group(), lure=new THREE.Group(); pivot.add(lure); scene.add(pivot);
let bodyMesh=null,billMesh=null,markers=new THREE.Group(),eyes=new THREE.Group(),hookGroup=new THREE.Group();
lure.add(markers); lure.add(eyes); lure.add(hookGroup);
let hookObjs=[];
let firstFrame=true;

function resize(){const w=view.clientWidth,h=view.clientHeight; if(!w||!h)return; renderer.setSize(w,h); camera.aspect=w/h; camera.updateProjectionMatrix(); requestRender();}
new ResizeObserver(resize).observe(view);
let _rsT=null; new ResizeObserver(()=>{ clearTimeout(_rsT); _rsT=setTimeout(()=>{ if(cache){ drawSide(cache.p,cache.bill,cache.A); drawDive(cache.p,cache.sim); } },60); }).observe(document.getElementById('panel'));

const MATS=new Map();   // B10: shared materials for markers / eyes
function matOf(color,o){ const k=color+JSON.stringify(o||{}); if(!MATS.has(k)) MATS.set(k,new THREE.MeshStandardMaterial(Object.assign({color,roughness:.4},o||{}))); return MATS.get(k); }
function sphere(r,color,pos){const m=new THREE.Mesh(new THREE.SphereGeometry(r,20,14),matOf(color));m.position.set(...pos);return m}
const halfMats=[new THREE.MeshStandardMaterial({color:0xe7e2d6,roughness:.55,metalness:0,side:THREE.DoubleSide}),new THREE.MeshStandardMaterial({color:0xcfd8d6,roughness:.55,metalness:0,side:THREE.DoubleSide})];
let halfMeshes=[];
function meshGeo(m){ const g=new THREE.BufferGeometry(); g.setAttribute('position',new THREE.Float32BufferAttribute(m.pos,3)); g.setIndex(m.idx); g.computeVertexNormals(); return g; }
function disposeTree(o){o.traverse(c=>{if(c.geometry)c.geometry.dispose()})}

function makeHook(info,type){
  const g=new THREE.Group(), ringD=info.ringD, rw=0.3+ringD*0.035;
  const ring=new THREE.Mesh(new THREE.TorusGeometry(ringD/2-rw,rw,8,28),ringMat);
  ring.rotation.x=Math.PI/2; ring.position.set(0,0,-(ringD/2-rw)); g.add(ring);
  const hl=info.l, wd=Math.max(0.42,hl*0.03), gap=info.gap, eyeR=Math.max(1,hl*0.06);
  const eye=new THREE.Mesh(new THREE.TorusGeometry(eyeR,wd*0.8,8,20),steelMat);
  eye.rotation.y=Math.PI/2; const ze=-(ringD-2*rw)-eyeR+rw; eye.position.set(0,0,ze); g.add(eye);
  const shTop=ze-eyeR, shLen=hl*0.62, zb=shTop-shLen;
  const sh=new THREE.Mesh(new THREE.CylinderGeometry(wd,wd,shLen,10),steelMat);
  sh.rotation.x=Math.PI/2; sh.position.set(0,0,shTop-shLen/2); g.add(sh);
  const arms=type==='single'?[0]:[0,2*Math.PI/3,4*Math.PI/3];
  arms.forEach(a=>{
    const arm=new THREE.Group(), br=gap/2;
    const tg=new THREE.TorusGeometry(br,wd,8,20,Math.PI); tg.rotateZ(Math.PI); tg.rotateX(Math.PI/2);
    const bend=new THREE.Mesh(tg,steelMat); bend.position.set(br,0,zb); arm.add(bend);
    const pl=hl*0.3;
    const pt=new THREE.Mesh(new THREE.CylinderGeometry(wd,wd,pl,8),steelMat); pt.rotation.x=Math.PI/2; pt.position.set(gap,0,zb+pl/2); arm.add(pt);
    const tip=new THREE.Mesh(new THREE.ConeGeometry(wd*1.15,wd*5,8),steelMat); tip.rotation.x=Math.PI/2; tip.position.set(gap,0,zb+pl+wd*2.5); arm.add(tip);
    const barb=new THREE.Mesh(new THREE.ConeGeometry(wd*0.7,wd*3.2,6),steelMat); barb.position.set(gap-wd*1.3,0,zb+pl+wd*0.8); barb.rotation.y=Math.PI*0.82; arm.add(barb);
    arm.rotation.z=a; g.add(arm);
  });
  return g;
}

function update3D(p,body,bill,A){
  if(bodyMesh){lure.remove(bodyMesh);bodyMesh.geometry.dispose()}
  if(billMesh){lure.remove(billMesh);billMesh.geometry.dispose()}
  bodyMesh=new THREE.Mesh(body.geo,bodyMat); lure.add(bodyMesh);
  halfMeshes.forEach(h=>{lure.remove(h);h.geometry.dispose()}); halfMeshes=[];
  const showH=$('showHalves')&&$('showHalves').checked&&!swimming;
  if(showH){ try{ const g=productionGeometry(Object.assign({},p,{prodMode:'inject'}),true);
      // opened like a book: both parting faces (Y=0) turned up, L on the near side, R on the far side
      [[g.L,-1],[g.R,1]].forEach(([m,sg],i)=>{ const h=new THREE.Mesh(meshGeo(m),halfMats[i]); h.rotation.x=-sg*Math.PI/2; h.position.y=sg*(p.bot+3); lure.add(h); halfMeshes.push(h); });
      bodyMesh.visible=false; }catch(e){ console.warn('halves preview failed',e); } }
  if(p.billMat==='pc'){billMatMesh.color.set(0xdfeff7);billMatMesh.opacity=0.55}
  else if(p.billMat==='fr4'){billMatMesh.color.set(0x5d7f3f);billMatMesh.opacity=0.95}
  else {billMatMesh.color.set(PAINT.side);billMatMesh.opacity=1}
  billMesh=new THREE.Mesh(bill.geo,billMatMesh); lure.add(billMesh);
  const xr=document.getElementById('xray').checked;
  bodyMat.transparent=xr; bodyMat.opacity=xr?0.35:1; bodyMat.depthWrite=!xr;
  // markers
  disposeTree(markers); markers.clear();
  const s=Math.max(1.2,p.L/70);
  markers.add(sphere(1.6*s,0xc62f2f,A.CG));
  markers.add(sphere(1.6*s,0x2a62c9,A.CB));
  [A.pts.tie,A.pts.belly,A.pts.tail].forEach(q=>markers.add(sphere(0.9*s,0x222222,q)));
  for(let i=0;i<p.ballN;i++) markers.add(sphere(p.ballD/2,0x9aa3a8,[A.ballX(i),0,p.ballZ]));
  markers.visible=document.getElementById('showMarkers').checked&&!showH;
  // hooks on their hangers
  disposeTree(hookGroup); hookGroup.clear(); hookObjs=[];
  [[A.hooks.belly,A.pts.belly],[A.hooks.tail,A.pts.tail]].forEach(([h,pos],i)=>{
    if(!h) return; const hk=makeHook(h,p.hookType); hk.position.set(...pos); hookGroup.add(hk); hookObjs.push({obj:hk,i});
  });
  // eyes (visual only)
  disposeTree(eyes); eyes.clear();
  const te=0.12, [top,,w]=radii(te,p), ez=top*0.28, ey=w*Math.pow(Math.max(0,1-Math.pow(ez/top,p.se)),1/p.se)*0.98, er=Math.max(1.4,top*0.17);
  [1,-1].forEach(sd=>{
    const ring=new THREE.Mesh(new THREE.SphereGeometry(er,24,16),matOf(0xf2c514,{roughness:.2,metalness:.3}));
    ring.scale.set(1,0.25,1); ring.position.set(te*p.L,sd*ey,ez); eyes.add(ring);
    const pup=new THREE.Mesh(new THREE.SphereGeometry(er*0.5,20,12),matOf(0x111111,{roughness:.1}));
    pup.scale.set(1,0.3,1); pup.position.set(te*p.L,sd*(ey+er*0.18),ez); eyes.add(pup);
  });
  hookGroup.visible=eyes.visible=billMesh.visible=!showH;
  // swim pivot near the head third
  const pv=new THREE.Vector3(p.L*0.3,0,0); pivot.position.copy(pv); lure.position.copy(pv).multiplyScalar(-1);
  // grid & camera
  if(grid){scene.remove(grid);grid.geometry.dispose();grid.material.dispose()}
  grid=new THREE.GridHelper(400,40,0xb9b0a0,0xd8d0c0); grid.rotation.x=Math.PI/2;
  const hookDrop=Math.max(A.hooks.belly?A.hooks.belly.r:0,A.hooks.tail?A.hooks.tail.r:0);
  const zmin=Math.min(-p.bot-hookDrop, bill.B.root.z+bill.B.d.z*(bill.outline.tip+5))-10;
  gridBaseX=p.L/2; grid.position.set(gridBaseX,0,zmin); grid.visible=document.getElementById('showGrid').checked; scene.add(grid);
  if(firstFrame){ fitCamera(p,bill); firstFrame=false; setViewBtn('v3d'); } else autoRefit(p,bill);
  renderer.domElement.setAttribute('aria-label',`3D model of ${$('dname').value||'the lure'}: ${p.L} mm body, ${f1(A.M)} g, ${f1(A.net)} g net buoyancy, bill ${p.billAng}° below the axis`);
  requestRender();
}
/* camera fit: the whole lure incl. bill and hooks (bounding box of the lure group) fills ~80 % of the smaller view axis.
   anim=true eases there in ~0.45 s; the fitted size is remembered so a later rebuild can tell if the model left the view. */
let camAnim=null, FIT={span:0,userMoved:false};
function lureBox(){ lure.updateMatrixWorld(true); const b=new THREE.Box3(); [bodyMesh,billMesh,hookGroup,eyes].forEach(o=>{ if(o&&o.visible!==false) b.expandByObject(o); }); halfMeshes.forEach(h=>b.expandByObject(h)); return b; }
function fitCamera(p,bill,anim,dirKeep){
  const b=lureBox(); if(b.isEmpty()) return; const c=b.getCenter(new THREE.Vector3()), sz=b.getSize(new THREE.Vector3());
  const r=0.5*Math.hypot(sz.x,sz.y,sz.z), vf=camera.fov*D2R, hf=2*Math.atan(Math.tan(vf/2)*camera.aspect), f=Math.min(vf,hf);
  const dist=r/Math.sin(f/2)*0.98;
  const dir=dirKeep?camera.position.clone().sub(controls.target).normalize():new THREE.Vector3(0.45,-1.05,0.4).normalize();
  const tp=c.clone().addScaledVector(dir,dist);
  FIT={span:sz.x,userMoved:false};
  if(anim){ camAnim={t0:performance.now(),p0:camera.position.clone(),t0v:controls.target.clone(),p1:tp,t1:c}; requestRender(); }
  else { camAnim=null; controls.target.copy(c); camera.position.copy(tp); controls.update(); }
}
/* is any corner of the lure box outside 92 % of the view? */
function lureClipped(){ const b=lureBox(); if(b.isEmpty()) return false; camera.updateMatrixWorld(); let out=false;
  for(const x of [b.min.x,b.max.x]) for(const y of [b.min.y,b.max.y]) for(const z of [b.min.z,b.max.z]){ const v=new THREE.Vector3(x,y,z).project(camera); if(Math.abs(v.x)>0.92||Math.abs(v.y)>0.92||v.z>1) out=true; }
  return out; }
/* after a rebuild: refit when the model would be clipped, or when it changed size > 15 % and the user has not orbited since the last fit */
function autoRefit(p,bill){ if(swimming||envOn) return; const sz=lureBox().getSize(new THREE.Vector3()).x;
  if(lureClipped()) fitCamera(p,bill,true,FIT.userMoved); else if(!FIT.userMoved&&FIT.span&&Math.abs(sz/FIT.span-1)>0.15) fitCamera(p,bill,true,false); }
controls.addEventListener('start',()=>{ FIT.userMoved=true; camAnim=null; });
['showMarkers','showGrid','xray'].forEach(id=>document.getElementById(id).onchange=()=>changed());
/* camera presets */
function setViewBtn(id){ ['v3d','vSide','vTop'].forEach(b=>$(b).setAttribute('aria-pressed',String(b===id))); }
function setView(kind){
  if(!cache) return; const {p,bill}=cache, tipX=bill.B.root.x+bill.B.d.x*bill.outline.tip, cx=(p.L+tipX)/2, span=p.L-tipX;
  if(kind==='v3d'||kind==='vFit'){ fitCamera(p,bill,kind==='vFit',kind==='vFit'); if(kind==='vFit'){ requestRender(); return; } }
  else { controls.target.set(cx,0,-6); if(kind==='vSide') camera.position.set(cx,-span*1.75,-6); else camera.position.set(cx,-span*0.02,span*1.75); controls.update(); }
  setViewBtn(kind); requestRender();
}
['v3d','vSide','vTop'].forEach(id=>$(id).onclick=()=>{ if(swimming) startSwim(false); setView(id); });
$('vFit').onclick=()=>{ if(swimming) startSwim(false); setView('vFit'); };

/* ============================== underwater world ============================== */
const D2R=Math.PI/180;
function canvasTex(w,h,draw){const c=document.createElement('canvas');c.width=w;c.height=h;draw(c.getContext('2d'),w,h);const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;return t}
function causticTex(){
  return canvasTex(256,256,(g,w,h)=>{
    const img=g.createImageData(w,h), pts=[]; for(let i=0;i<26;i++) pts.push([Math.random()*w,Math.random()*h]);
    for(let y=0;y<h;y++) for(let x=0;x<w;x++){
      let d1=1e9,d2=1e9;
      for(const [px,py] of pts) for(let ox=-w;ox<=w;ox+=w) for(let oy=-h;oy<=h;oy+=h){
        const d=Math.hypot(x-px-ox,y-py-oy); if(d<d1){d2=d1;d1=d}else if(d<d2)d2=d;
      }
      const v=Math.pow(clamp(1-(d2-d1)/9,0,1),2.2)*255, i=(y*w+x)*4;
      img.data[i]=img.data[i+1]=img.data[i+2]=v; img.data[i+3]=255;
    }
    g.putImageData(img,0,0);
  });
}
function sandTex(){
  return canvasTex(128,128,(g,w,h)=>{
    const img=g.createImageData(w,h);
    for(let i=0;i<w*h;i++){const n=170+Math.random()*60; img.data[i*4]=n; img.data[i*4+1]=n*0.93; img.data[i*4+2]=n*0.78; img.data[i*4+3]=255}
    g.putImageData(img,0,0);
  });
}
/* B11: the underwater world is built on the first Swim (causticTex alone cost ~210 ms at start-up) */
let W=null;
function buildWorld(){
  const rayTex=canvasTex(64,256,(g,w,h)=>{const gr=g.createLinearGradient(0,0,0,h);gr.addColorStop(0,'rgba(255,255,240,0.9)');gr.addColorStop(1,'rgba(255,255,240,0)');g.fillStyle=gr;g.fillRect(0,0,w,h);
    const gx=g.createLinearGradient(0,0,w,0);gx.addColorStop(0,'rgba(0,0,0,1)');gx.addColorStop(0.5,'rgba(0,0,0,0)');gx.addColorStop(1,'rgba(0,0,0,1)');g.globalCompositeOperation='destination-out';g.fillStyle=gx;g.fillRect(0,0,w,h)});
  const caust=causticTex(), caust2=caust.clone(); caust2.needsUpdate=true; caust.repeat.set(12,12); caust2.repeat.set(14,14);
  const sand=sandTex(); sand.repeat.set(30,30);
  
  const env=new THREE.Group(); env.visible=false; scene.add(env);
  const surfGeo=new THREE.PlaneGeometry(5000,5000,50,50);
  const surfBase=Float32Array.from(surfGeo.attributes.position.array);
  const surfMat=new THREE.MeshBasicMaterial({map:caust,color:0xe2d9a0,transparent:true,opacity:0.6,side:THREE.DoubleSide,fog:false,depthWrite:false});
  const surface=new THREE.Mesh(surfGeo,surfMat); env.add(surface);
  const skyGlow=new THREE.Mesh(new THREE.PlaneGeometry(5000,5000),new THREE.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:0.18,fog:false,side:THREE.DoubleSide}));
  env.add(skyGlow);
  const rays=[];
  for(let i=0;i<11;i++){
    const g=new THREE.PlaneGeometry(1,1); g.rotateX(Math.PI/2);
    const m=new THREE.Mesh(g,new THREE.MeshBasicMaterial({map:rayTex,transparent:true,opacity:0.07+Math.random()*0.08,blending:THREE.AdditiveBlending,depthWrite:false,fog:false,side:THREE.DoubleSide}));
    m.userData={w:25+Math.random()*70,h:1400+Math.random()*900,ph:Math.random()*6.28};
    m.scale.set(m.userData.w,1,m.userData.h);
    m.position.set(-500+Math.random()*1500,-500+Math.random()*900,0); env.add(m); rays.push(m);
  }
  const NPART=900, partGeo=new THREE.BufferGeometry(), partPos=new Float32Array(NPART*3);
  for(let i=0;i<NPART;i++){partPos[i*3]=-800+Math.random()*2000;partPos[i*3+1]=-700+Math.random()*1400;partPos[i*3+2]=-450+Math.random()*900}
  partGeo.setAttribute('position',new THREE.BufferAttribute(partPos,3));
  const particles=new THREE.Points(partGeo,new THREE.PointsMaterial({color:0xf2ecd2,size:2.2,transparent:true,opacity:0.55,depthWrite:false}));
  env.add(particles);
  const bottomG=new THREE.Group(); env.add(bottomG);
  const bottomMat=new THREE.MeshStandardMaterial({map:sand,color:0x6f6447,roughness:1});
  const bottom=new THREE.Mesh(new THREE.PlaneGeometry(6000,6000),bottomMat); bottomG.add(bottom);
  const bottomCaust=new THREE.Mesh(new THREE.PlaneGeometry(6000,6000),new THREE.MeshBasicMaterial({map:caust2,transparent:true,opacity:0.22,blending:THREE.AdditiveBlending,depthWrite:false}));
  bottomCaust.position.z=1.5; bottomG.add(bottomCaust);
  const debris=[];
  const woodMat=new THREE.MeshStandardMaterial({color:0x3a2c1c,roughness:0.95}), rockMat=new THREE.MeshStandardMaterial({color:0x56594a,roughness:1,flatShading:true});
  for(let i=0;i<22;i++){
    let m;
    if(i%3){ const len=180+Math.random()*520; m=new THREE.Mesh(new THREE.CylinderGeometry(5+Math.random()*9,8+Math.random()*12,len,9),woodMat);
      m.rotation.set(Math.PI/2+(Math.random()-0.5)*0.5,0,Math.random()*Math.PI); m.position.z=8; }
    else { const r=18+Math.random()*50; m=new THREE.Mesh(new THREE.DodecahedronGeometry(r,0),rockMat); m.scale.z=0.55; m.position.z=r*0.3; }
    m.position.x=-1500+Math.random()*3000; m.position.y=-1000+Math.random()*2000; bottomG.add(m); debris.push(m);
  }
  // a few standing drowned trunks (typical of Malaysian reservoirs)
  for(let i=0;i<4;i++){ const tr=new THREE.Mesh(new THREE.CylinderGeometry(22,34,3000,10),woodMat); tr.rotation.x=Math.PI/2; tr.position.set(-1500+i*800+Math.random()*300, 500+Math.random()*500*(i%2?-1:1)*1.5, 1400); bottomG.add(tr); debris.push(tr); }
  return {rayTex,caust,caust2,sand,env,surfGeo,surfBase,surfMat,surface,skyGlow,rays,NPART,partGeo,partPos,particles,bottomG,bottomMat,bottom,bottomCaust,debris,woodMat,rockMat};
}
function ensureWorld(){ if(!W) W=buildWorld(); return W; }
const DEPTH_K=110;   // mm on screen per metre of real depth (depth is compressed so the surface stays in view)
let envOn=false, envSurfZ=1e9, envBotZ=-1e9, savedCam=null;
function setEnv(on){
  if(on) ensureWorld(); envOn=on; if(W) W.env.visible=on; view.classList.toggle('uw',on);
  if(on){ const c=CLARITY[(cache&&cache.p.clarity)||'tea']; scene.fog=new THREE.FogExp2(c.fog,c.d); scene.fog.userData={base:c.d}; scene.background=new THREE.Color(c.fog);
    W.surfMat.color.set(c.surf); W.bottomMat.color.set(c.bot); if(grid) grid.visible=false; }
  else { scene.fog=null; scene.background=null; if(grid) grid.visible=$('showGrid').checked; }
}
function updateEnv(dx,zReal,tR){
  const {surface,skyGlow,surfGeo,surfBase,caust,caust2,sand,bottomG,debris,partGeo,NPART,rays}=ensureWorld();
  const surfZ=40+zReal*DEPTH_K, botZ=-((Math.max(cache.p.bottomD-zReal,0))*DEPTH_K+35); envSurfZ=surfZ; envBotZ=botZ;
  surface.position.z=surfZ; skyGlow.position.z=surfZ+60;
  const pa=surfGeo.attributes.position.array;
  for(let i=0;i<pa.length;i+=3){const x=surfBase[i],y=surfBase[i+1]; pa[i+2]=7*Math.sin(x*0.006+tR*1.3)+5*Math.sin(y*0.008-tR*1.7)+3*Math.sin((x+y)*0.013+tR*2.3)}
  surfGeo.attributes.position.needsUpdate=true;
  caust.offset.x=(caust.offset.x - dx/714 + 0.0006)%1; caust.offset.y=(caust.offset.y+0.0004)%1;
  caust2.offset.x=(caust2.offset.x - dx/428)%1; caust2.offset.y=(caust2.offset.y+0.0005)%1;
  sand.offset.x=(sand.offset.x - dx/200)%1;
  bottomG.position.z=botZ;
  debris.forEach(m=>{ m.position.x+=dx; if(m.position.x>1600) m.position.x-=3200; });
  const pp=partGeo.attributes.position.array;
  for(let i=0;i<NPART;i++){ pp[i*3]+=dx+Math.sin(tR*0.7+i)*0.08; pp[i*3+2]+=Math.sin(tR*0.5+i*1.7)*0.05; if(pp[i*3]>1200) pp[i*3]-=2000;
    if(pp[i*3+2]>surfZ-5) pp[i*3+2]=botZ+10+Math.random()*50; }
  partGeo.attributes.position.needsUpdate=true;
  rays.forEach((m,i)=>{ const u=m.userData; m.position.x+=dx*0.15; if(m.position.x>1100) m.position.x-=1600;
    m.position.z=surfZ-u.h/2; m.rotation.z=Math.atan2(camera.position.x-m.position.x, -(camera.position.y-m.position.y));
    m.material.opacity=(0.06+0.05*Math.sin(tR*0.6+u.ph)); });
}
$('uw').onchange=()=>{ if(swimming) setEnv($('uw').checked); requestRender(); };

/* ============================== toman (procedural) ============================== */
function buildFish(){
  const len=600, H=len*0.085, NS=72, NA=26, g=new THREE.Group(), parts=[];
  const hAt=t=>H*(0.3+0.7*Math.sqrt(clamp(t/0.2,0,1)))*(1-0.62*smooth(0.6,0.9,t));
  const wAt=t=>hAt(t)*(0.95-0.45*smooth(0.45,0.9,t));
  const pos=[],col=[],idx=[];
  const back=hexRGB('#1b211b'), side=hexRGB('#4a5747'), belly=hexRGB('#cfd0bd'), blot=hexRGB('#121612');
  for(let i=0;i<NS;i++){
    const t=0.9*i/(NS-1), x=t*len, h=hAt(t), w=wAt(t);
    for(let j=0;j<NA;j++){
      const a=2*Math.PI*j/NA, c=Math.cos(a), s=Math.sin(a), y=w*c, z=h*s*(s<0?0.92:1);
      pos.push(x,y,z);
      let cc=mix(side,back,smooth(0.15,0.7,s)); cc=mix(cc,belly,smooth(0.2,0.75,-s));
      const bl=Math.sin(x*0.045)+Math.sin(x*0.071+1.3)+0.6*Math.sin(x*0.13+j);
      if(bl>1.0 && s>-0.45 && t>0.15) cc=mix(cc,blot,0.75);
      if(t<0.12 && s>0) cc=mix(cc,back,0.6);
      col.push(...cc);
    }
  }
  const nose=pos.length/3; pos.push(-H*0.18,0,-H*0.05); col.push(...back);
  const tail=nose+1; pos.push(0.9*len+2,0,0); col.push(...back);
  for(let i=0;i<NS-1;i++) for(let j=0;j<NA;j++){const a0=i*NA+j,a1=i*NA+(j+1)%NA,b0=a0+NA,b1=a1+NA; idx.push(a0,a1,b0, a1,b1,b0);}
  for(let j=0;j<NA;j++){ idx.push(nose,(j+1)%NA,j); const o=(NS-1)*NA; idx.push(tail,o+j,o+(j+1)%NA); }
  const bg=new THREE.BufferGeometry(); bg.setAttribute('position',new THREE.Float32BufferAttribute(pos,3)); bg.setAttribute('color',new THREE.Float32BufferAttribute(col,3)); bg.setIndex(idx); bg.computeVertexNormals();
  const body=new THREE.Mesh(bg,new THREE.MeshStandardMaterial({vertexColors:true,roughness:0.45,metalness:0.15,side:THREE.DoubleSide})); g.add(body); parts.push(body);
  const finMat=new THREE.MeshStandardMaterial({color:0x1d231c,roughness:0.6,transparent:true,opacity:0.88,side:THREE.DoubleSide});
  const fin=(ptsXZ)=>{ const sh=new THREE.Shape(); ptsXZ.forEach(([x,z],i)=>i?sh.lineTo(x,z):sh.moveTo(x,z)); const fg=new THREE.ShapeGeometry(sh); fg.rotateX(Math.PI/2); const m=new THREE.Mesh(fg,finMat); g.add(m); parts.push(m); return m; };
  const dors=[]; for(let k=0;k<=20;k++){const t=0.3+0.56*k/20; dors.push([t*len,hAt(t)*0.92])} for(let k=20;k>=0;k--){const t=0.3+0.56*k/20; dors.push([t*len+12,hAt(t)+H*0.45*Math.sin(Math.PI*(0.15+0.85*k/20))*0.9+H*0.1])}
  fin(dors);
  const anal=[]; for(let k=0;k<=16;k++){const t=0.5+0.36*k/16; anal.push([t*len,-hAt(t)*0.85])} for(let k=16;k>=0;k--){const t=0.5+0.36*k/16; anal.push([t*len+10,-hAt(t)-H*0.38*Math.sin(Math.PI*(0.15+0.85*k/16))-H*0.06])}
  fin(anal);
  const cf=[[0.88*len,H*0.32]]; for(let k=0;k<=24;k++){const a=Math.PI/2-Math.PI*k/24; cf.push([0.9*len+H*1.15*Math.cos(a)*1.05,H*0.95*Math.sin(a)])} cf.push([0.88*len,-H*0.32]);
  fin(cf);
  [1,-1].forEach(sd=>{ const sh=new THREE.Shape(); sh.absellipse(0,0,H*0.55,H*0.32,0,Math.PI*2); const pg=new THREE.ShapeGeometry(sh); const m=new THREE.Mesh(pg,finMat);
    m.position.set(0.2*len,sd*wAt(0.2)*0.9,-hAt(0.2)*0.35); m.rotation.set(sd*0.6,0,sd*0.5); g.add(m); });
  // lower jaw on a hinge + dark mouth
  const jawPivot=new THREE.Group(); jawPivot.position.set(len*0.085,0,-H*0.22); g.add(jawPivot);
  const jaw=new THREE.Mesh(new THREE.SphereGeometry(1,20,12,0,Math.PI*2,Math.PI/2,Math.PI/2),new THREE.MeshStandardMaterial({color:0xbdbfae,roughness:.5,side:THREE.DoubleSide}));
  jaw.scale.set(len*0.1,wAt(0.06)*0.95,H*0.42); jaw.position.set(-len*0.085,0,0.0); jaw.rotation.x=Math.PI; jawPivot.add(jaw);
  const mouth=new THREE.Mesh(new THREE.SphereGeometry(1,18,12),new THREE.MeshStandardMaterial({color:0x3b1512,roughness:.8}));
  mouth.scale.set(len*0.075,wAt(0.06)*0.8,H*0.42); mouth.position.set(len*0.03,0,-H*0.18); g.add(mouth);
  [1,-1].forEach(sd=>{ const e=new THREE.Mesh(new THREE.SphereGeometry(H*0.13,16,12),new THREE.MeshStandardMaterial({color:0xa8541c,roughness:.2,metalness:.2}));
    e.position.set(len*0.055,sd*wAt(0.055)*0.82,H*0.42); g.add(e);
    const pu=new THREE.Mesh(new THREE.SphereGeometry(H*0.075,12,10),new THREE.MeshStandardMaterial({color:0x050505})); pu.position.set(len*0.05,sd*(wAt(0.055)*0.82+H*0.07),H*0.44); g.add(pu); });
  const deform=parts.map(m=>({m,base:Float32Array.from(m.geometry.attributes.position.array)}));
  g.visible=false;
  return {g,deform,jawPivot,len};
}
let FISH=null;   // B11: built on the first strike / spawn
function ensureFish(){ if(!FISH){ FISH=buildFish(); scene.add(FISH.g); } return FISH; }
function fishWave(tR,amp,freq){
  const L=FISH.len;
  FISH.deform.forEach(({m,base})=>{ const pa=m.geometry.attributes.position.array;
    for(let i=0;i<pa.length;i+=3){ const x=base[i], u=clamp(x/L,0,1.1); pa[i+1]=base[i+1]+amp*L*(0.03+0.97*u*u)*Math.sin(2*Math.PI*(u*1.1-freq*tR)); }
    m.geometry.attributes.position.needsUpdate=true; });
}

/* ============================== swim + strike loop ============================== */
let swimming=false, simT=0, lastTS=null, phase=0, curPitch=0, prevK=0, tReal=0;
const qA=new THREE.Quaternion(), qB=new THREE.Quaternion(), qC=new THREE.Quaternion();
const AX=new THREE.Vector3(1,0,0), AY=new THREE.Vector3(0,1,0), AZ=new THREE.Vector3(0,0,1);
const fish={state:'none',t:0,W:0,len:600,from:new THREE.Vector3(),to:new THREE.Vector3(),yaw:0,shake:0,spin:0,trigger:false,odds:null,res:null,stats:{strikes:0,hooked:0,landed:0}};
let camZ=1, camShift=0;

function startSwim(on){
  if(on&&!swimming&&$('showHalves')&&$('showHalves').checked){ $('showHalves').checked=false; }
  swimming=on; $('swimBtn').textContent=on?'■ Stop':'▶ Swim'; $('swimBtn').setAttribute('aria-pressed',String(on)); $('swimInfo').hidden=!on;
  lastTS=null; setEnv(on && $('uw').checked);
  if(on && $('uw').checked && cache){ savedCam={p:camera.position.clone(),t:controls.target.clone()};
    /* frame the swimming lure in the central ~58 % of the view so the HUD (top) and transport bar (bottom) never cover it */
    const sp=cache.p.L+cache.p.billLen, cx=cache.p.L*0.4, vis=2*Math.tan(camera.fov*D2R/2)*Math.min(1,camera.aspect*0.8);
    const k=clamp(0.9/(0.58*vis),1.3,4)/1.3;
    controls.target.set(cx,0,0); camera.position.set(cx+sp*0.35*k,-sp*1.25*k,-sp*0.18*k); controls.update(); }
  if(!on && savedCam){ camZ=1; camShift=0; camera.position.copy(savedCam.p); controls.target.copy(savedCam.t); savedCam=null; controls.update(); }
  if(!on){ resetPose(); fishReset(); collapseToasts(); }
  if(on) rebuildIfHalves(); requestRender();
}
function rebuildIfHalves(){ if(halfMeshes.length) changed(); }
$('swimBtn').onclick=()=>startSwim(!swimming);
$('strikeBtn').onclick=()=>{ if(!cache) return; if(!swimming) startSwim(true); if(fish.state==='none'){ spawnFish(true); } else if(fish.state==='approach'||fish.state==='follow'){ fish.forced=true; } };
function resetPose(){ pivot.quaternion.identity(); hookObjs.forEach(h=>h.obj.rotation.set(0,0,0)); if(grid) grid.position.x=gridBaseX; const d=document.getElementById('diveDot'); if(d) d.setAttribute('visibility','hidden'); }
function fishReset(){ fish.state='none'; if(FISH) FISH.g.visible=false; fish.shake=0; fish.spin=0; fish.forced=false; }
function followPos(p,v){ return new THREE.Vector3(p.L+30, 22, -6); }
function spawnFish(force){
  ensureFish(); fish.trigger=false;   // B8: the reaction-strike bonus must not carry over between fish
  const p=cache.p; fish.W=1.2+5.8*Math.pow(Math.random(),1.8); fish.len=460*Math.cbrt(fish.W)+0; // mm
  FISH.g.scale.setScalar(fish.len/FISH.len); FISH.g.visible=true; FISH.g.rotation.set(0,0,0);
  fish.from.set(p.L+900,380,-140); fish.to.copy(followPos(p)); FISH.g.position.copy(force?fish.to:fish.from);
  fish.state=force?'follow':'approach'; fish.t=0; fish.forced=!!force; fish.followT=0;
}
/* B6: strike events are non-blocking toasts (bottom-left, collapse to one line after 3 s) + a full session log in the side panel */
const SESSION=[]; let sessT0=null;
function strikeEvent(title,color,sub,odds,detail){
  const s=fish.stats, now=performance.now(); if(sessT0==null) sessT0=now;
  const box=$('strikeToasts'), el=document.createElement('div'); el.className='stoast'; el.style.borderLeftColor=color;
  el.innerHTML=`<div class="t" style="color:${color}">${esc(title)}</div><div class="m">${esc(sub)}${odds?` · odds ${Math.round(odds.p*100)}%`:''}</div><div class="d">${odds?`<div class="bar" aria-hidden="true"><i style="width:${Math.round(odds.p*100)}%"></i></div>`:''}${esc(detail||'')}</div>`;
  box.appendChild(el); while(box.children.length>3) box.firstChild.remove();
  setTimeout(()=>el.classList.add('mini'),matchMedia('(max-width:560px)').matches?2000:3000); setTimeout(()=>{ el.classList.add('fade'); setTimeout(()=>el.remove(),450); },12000);
  SESSION.unshift({t:(now-sessT0)/1000,title,color,sub,odds,detail}); if(SESSION.length>50) SESSION.pop();
  renderSession();
}
function collapseToasts(){ document.querySelectorAll('#strikeToasts .stoast').forEach(e=>e.classList.add('mini')); }
function renderSession(){
  const s=fish.stats; $('sessStats').innerHTML=s.strikes?`<b>${s.strikes}</b> strike${s.strikes>1?'s':''} · <b>${s.hooked}</b> hooked · <b>${s.landed}</b> landed (this session)`:'No strikes yet. Press ▶ Swim (or Space), then Strike.';
  $('sessionLog').innerHTML=SESSION.map(e=>`<li><b style="color:${e.color}">${esc(e.title)}</b> <span class="m">${f1(e.t)} s</span><div class="m">${esc(e.sub)}</div>${e.detail?`<div>${esc(e.detail)}</div>`:''}${e.odds?`<details><summary>Hook-up odds ${Math.round(e.odds.p*100)}% — why</summary><ul>${e.odds.reasons.map(([k,t])=>`<li class="${k==='+'?'c-ok':'c-e'}">${k==='+'?'+':'−'} ${esc(t)}</li>`).join('')}</ul></details>`:''}</li>`).join('');
}
function updateFish(dtS,dtR,st){
  const p=cache.p, A=cache.A; if(fish.state==='none'){
    if($('autoFish').checked && simT>2.5){ const rate=0.11*interestAt(p,A,st.z,st.v,st.S); if(Math.random()<rate*dtS) spawnFish(false); }
    return;
  }
  const g=FISH.g; fish.t+=dtR;
  let wAmp=0.05, wFreq=1.6;
  if(fish.state==='approach'){
    const k=smooth(0,1.6,fish.t); g.position.lerpVectors(fish.from,followPos(p),k); g.rotation.z=(1-k)*0.35;
    if(k>=1){fish.state='follow';fish.t=0;fish.followT=0}
  } else if(fish.state==='follow'){
    fish.followT+=dtS; const fp=followPos(p); g.position.set(fp.x+8*Math.sin(tReal*1.3),fp.y+10*Math.sin(tReal*0.9),fp.z+5*Math.sin(tReal*1.1)); g.rotation.z=0.06*Math.sin(tReal*0.9);
    const I=interestAt(p,A,st.z,st.v,st.S);
    if(st.event){ fish.trigger=true; }
    let go=fish.forced && fish.followT>0.25;
    if(!go && st.event && Math.random()<0.5*I) go=true;
    if(!go && Math.random()<0.16*I*dtS) go=true;
    if(go){ fish.state='lunge'; fish.t=0; fish.lt=0; fish.from.copy(g.position); fish.odds=hookOdds(p,A,{trigger:fish.trigger||st.v<0.05,v:st.v}); fish.stats.strikes++; }
    else if(fish.followT>7){ fish.state='leave'; fish.t=0; fish.from.copy(g.position); }
    wFreq=2.0;
  } else if(fish.state==='lunge'){
    fish.lt+=dtS; const k=smooth(0,0.32,fish.lt);
    g.position.lerpVectors(fish.from,new THREE.Vector3(p.L*0.05,0,-2),k); g.rotation.z=0;
    FISH.jawPivot.rotation.y=-0.75*Math.sin(Math.min(fish.lt/0.4,1)*Math.PI);
    wAmp=0.09; wFreq=6;
    if(fish.lt>0.42){ FISH.jawPivot.rotation.y=0;
      const hit=Math.random()<fish.odds.p;
      if(hit){ fish.state='hooked'; fish.t=0; fish.ht=0; fish.stats.hooked++;
        strikeEvent('Fish on!','#1f6f6a',`Toman ≈ ${f1(fish.W)} kg · ${Math.round(fish.len/10)} cm`,fish.odds,'Fighting: head-shakes and jumps load the hooks and rings.'); }
      else { fish.state='miss'; fish.t=0; fish.from.copy(g.position); fish.spin=0.01;
        strikeEvent('Missed strike','#9a6200',`Toman ≈ ${f1(fish.W)} kg · ${Math.round(fish.len/10)} cm`,fish.odds,'The fish closed on the lure but the points did not stick.'); }
    }
  } else if(fish.state==='hooked'){
    fish.ht+=dtS; fish.shake=0.5*Math.sin(2*Math.PI*2.6*fish.ht)*smooth(0,0.2,fish.ht);
    g.position.set(p.L*0.05,0,-2); g.rotation.z=fish.shake; g.rotation.x=0.25*Math.sin(2*Math.PI*1.3*fish.ht);
    wAmp=0.08; wFreq=4.5;
    if(fish.ht>2.2){ const r=fightOutcome(p,A,fish.W); fish.res=r; if(r.ok) fish.stats.landed++;
      strikeEvent(r.ok?'Landed!':r.t,r.ok?'#26733f':'#c62f2f',`Toman ≈ ${f1(fish.W)} kg · ${Math.round(fish.len/10)} cm`,null,r.why);
      fish.state=r.ok?'landed':'lost'; fish.t=0; fish.from.copy(g.position); fish.shake=0; }
  } else if(fish.state==='landed'){
    g.rotation.z=0.15*Math.sin(tReal*3); fish.shake=g.rotation.z; wAmp=0.04; wFreq=2;
    if(fish.t>2.6){ fishReset(); simT=0; phase=0; }
  } else if(fish.state==='lost'||fish.state==='miss'||fish.state==='leave'){
    const k=smooth(0,1.8,fish.t); g.position.lerpVectors(fish.from,new THREE.Vector3(p.L+250,1100,-220),k); g.rotation.z=-1.2*smooth(0,0.6,fish.t); g.rotation.x=0;
    if(fish.state==='miss') fish.spin=Math.max(0,1-fish.t*1.5)*Math.sin(fish.t*25)*0.6;
    wAmp=0.1; wFreq=5;
    if(k>=1){ const was=fish.state; fishReset(); if(was==='lost'){simT=0;phase=0} }   // B7: read the state before the reset
  }
  fishWave(tReal,wAmp,wFreq);
}
/* B9: the loop runs only while something moves (swim, camera damping, a pending redraw), then stops itself */
let needsRender=true, loopOn=false, idleFrames=0; window.__renders=0;
function requestRender(){ needsRender=true; if(!loopOn){ loopOn=true; lastTS=null; idleFrames=0; renderer.setAnimationLoop(frame); } }
function frame(ts){
  const dtR=lastTS==null?0:Math.min((ts-lastTS)/1000,0.05); lastTS=ts; tReal+=dtR;
  let moving=swimming;
  if(swimming && cache && cache.sim.n>1){
    const sim=cache.sim, p=cache.p, A=cache.A, dtS=dtR*(+$('slowmo').value);
    const frozen=['hooked','landed'].includes(fish.state);
    if(!frozen){ simT+=dtS; if(simT>=sim.T){ simT=0; phase=0; prevK=0; } }
    const k=Math.min(Math.floor(simT/sim.dt),sim.n-1);
    let event=false; for(let i=prevK+1;i<=k;i++) if(sim.E[i]) event=true; prevK=k;
    const v=frozen?0:sim.V[k], z=sim.Z[k], x=sim.X[k];
    const S=swimParams(p,A,Math.max(v,0.001)), m=smooth(0.05,0.35,v);
    phase+=2*Math.PI*S.f*dtS*m;
    const restPitch=-clamp((A.CG[0]-A.CB[0])*2.5,-25,25);
    curPitch+=((m*S.pitch+(1-m)*restPitch)-curPitch)*Math.min(1,dtS*5);
    const yaw=S.yaw*D2R*Math.sin(phase)*m+fish.shake, roll=S.roll*D2R*Math.sin(phase+0.6)*m+fish.spin;
    qA.setFromAxisAngle(AY,-(curPitch+1.5*m*Math.sin(2*phase))*D2R); qB.setFromAxisAngle(AZ,yaw); qC.setFromAxisAngle(AX,roll);
    pivot.quaternion.copy(qA).multiply(qB).multiply(qC);
    hookObjs.forEach(h=>h.obj.rotation.set(0.25*m*Math.sin(phase+1+h.i),-1.15*m+0.15*Math.sin(tReal*1.5+h.i),0));
    const dx=v*1000*dtS;
    if(envOn) updateEnv(dx,z,tReal); else if(grid) grid.position.x=gridBaseX+((simT*p.speed*1000)%10);
    updateFish(dtS,dtR,{v,z,S,event});
    const dot=document.getElementById('diveDot'); if(dot){ dot.setAttribute('cx',DV.X(x)); dot.setAttribute('cy',DV.Y(z)); dot.setAttribute('visibility','visible'); }
    const turns=(p.castDist-x)/linePerTurn(p);
    if(!(Math.round(tReal*10)%2)) $('swimInfo').innerHTML=`<span class="hl"><b>${frozen?'fish on — fighting':sim.labels[sim.Lb[k]]}</b> · ${f2(v)} m/s · depth ${f1(z)} m · ${f1(S.f*m)} Hz<br>${f1(simT)} s · ${Math.round(p.castDist-x)} m in · ≈${Math.round(turns)} handle turns</span><span class="hs">${f2(v)} m/s · ${f1(z)} m · ${f1(S.f*m)} Hz</span>`;
    // camera: pull back when a fish is around
    const fishOn=fish.state!=='none';
    const wantZ=fishOn?clamp(fish.len*1.15/(p.L+p.billLen),1.4,6):1, wantS=fishOn?fish.len*0.38:0;
    const nz=camZ+(wantZ-camZ)*Math.min(1,dtR*1.8), ns=camShift+(wantS-camShift)*Math.min(1,dtR*1.8);
    const off=camera.position.clone().sub(controls.target).multiplyScalar(nz/camZ);
    controls.target.x+=ns-camShift; camera.position.copy(controls.target).add(off); camZ=nz; camShift=ns;
    if(envOn){ camera.position.z=clamp(camera.position.z,envBotZ+25,envSurfZ-25); if(scene.fog&&scene.fog.userData) scene.fog.density=scene.fog.userData.base/Math.max(1,camZ*0.8); }
  } else if(camZ!==1||camShift!==0){
    const off=camera.position.clone().sub(controls.target).multiplyScalar(1/camZ); controls.target.x-=camShift; camera.position.copy(controls.target).add(off); camZ=1; camShift=0; moving=true;
  }
  if(camAnim){ const k=Math.min(1,(performance.now()-camAnim.t0)/450), e=k<0.5?2*k*k:1-Math.pow(-2*k+2,2)/2;
    controls.target.lerpVectors(camAnim.t0v,camAnim.t1,e); camera.position.lerpVectors(camAnim.p0,camAnim.p1,e); moving=true; if(k>=1) camAnim=null; }
  if(controls.update()) moving=true;
  if(moving||needsRender){ needsRender=false; idleFrames=0; renderer.render(scene,camera); window.__renders++; }
  else if(++idleFrames>20){ renderer.setAnimationLoop(null); loopOn=false; }
}

/* ============================== side profile SVG ============================== */
function hookSVG(pos,h,type,color,sw){
  const x=pos[0], y=-pos[2], top=y+h.ringD, yb=top+h.l*0.68, g=h.gap, pl=h.l*0.3;
  let s=`<circle cx="${x}" cy="${y+h.ringD/2}" r="${h.ringD/2}" fill="none" stroke="#8d939a" stroke-width="${sw*1.4}"/>`;
  if(type!=='single') s+=`<path d="M${x},${yb} A${g/2},${g/2} 0 0 1 ${x-g},${yb} L${x-g},${yb-pl}" fill="none" stroke="${color}" stroke-opacity=".45" stroke-width="${sw*2}"/>`;
  s+=`<path d="M${x},${top} L${x},${yb} A${g/2},${g/2} 0 0 0 ${x+g},${yb} L${x+g},${yb-pl}" fill="none" stroke="${color}" stroke-width="${sw*2.2}" stroke-linecap="round"/>`;
  return s;
}
function drawSide(p,bill,A){
  const svg=document.getElementById('side'), pd=profileData(p);
  const bc=billSideCorners(p,bill.B,bill.outline.tip), H=A.hooks;
  const drop=Math.max(H.belly?H.belly.ringD+H.belly.l*1.2-A.pts.belly[2]:0, H.tail?H.tail.ringD+H.tail.l*1.2:0);
  const xmin=Math.min(0,...bc.map(v=>v.x))-8, xmax=p.L+(H.tail?H.tail.gap:0)+16;
  const zmax=p.top+8, zmin=Math.min(-p.bot,...bc.map(v=>v.z),-drop)-6;
  svg.setAttribute('viewBox',`${xmin} ${-zmax} ${xmax-xmin} ${zmax-zmin}`);
  const sw=(xmax-xmin)/500;
  const outline=pd.xs.map((x,i)=>`${x},${-pd.tops[i]}`).concat(pd.xs.slice().reverse().map((x,i)=>`${x},${pd.bots[pd.xs.length-1-i]}`)).join(' ');
  let h='';
  for(let x=Math.ceil(xmin/10)*10;x<=xmax;x+=10) h+=`<line x1="${x}" y1="${-zmax}" x2="${x}" y2="${-zmin}" stroke="#e6dfd1" stroke-width="${sw}"/>`;
  for(let z=Math.ceil(zmin/10)*10;z<=zmax;z+=10) h+=`<line x1="${xmin}" y1="${-z}" x2="${xmax}" y2="${-z}" stroke="${z===0?'#cfc6b4':'#e6dfd1'}" stroke-width="${sw}"/>`;
  // swing circles
  const col=k=>k==='e'?'#c62f2f':k==='w'?'#c98a12':'#2f8a4c';
  const bState=H.lineFoul==='e'||H.tangle==='e'?'e':(H.lineFoul||H.tangle)?'w':null;
  if(H.belly) h+=`<circle cx="${A.pts.belly[0]}" cy="${-A.pts.belly[2]}" r="${H.belly.r}" fill="${col(bState)}" fill-opacity=".05" stroke="${col(bState)}" stroke-dasharray="${sw*5} ${sw*4}" stroke-width="${sw*1.3}"/>`;
  if(H.tail) h+=`<circle cx="${A.pts.tail[0]}" cy="${-A.pts.tail[2]}" r="${H.tail.r}" fill="${col(H.tangle)}" fill-opacity=".05" stroke="${col(H.tangle)}" stroke-dasharray="${sw*5} ${sw*4}" stroke-width="${sw*1.3}"/>`;
  h+=`<polygon points="${outline}" fill="${PAINT.side}" fill-opacity=".55" stroke="#1c2826" stroke-width="${sw*1.6}"/>`;
  h+=`<polygon points="${bc.map(v=>`${v.x},${-v.z}`).join(' ')}" fill="#cfe6f5" stroke="#1c2826" stroke-width="${sw*1.4}"/>`;
  if(p.ballN) h+=`<circle cx="${p.ballX}" cy="${-p.ballZ}" r="${p.ballD/2}" fill="#9aa3a8" stroke="#555" stroke-width="${sw}"/>`;
  if(H.belly) h+=hookSVG(A.pts.belly,H.belly,p.hookType,'#3b3f46',sw);
  if(H.tail) h+=hookSVG(A.pts.tail,H.tail,p.hookType,'#3b3f46',sw);
  const sr=svg.getBoundingClientRect(), pxu=sr.width>0&&sr.height>0?Math.min(sr.width/(xmax-xmin),sr.height/(zmax-zmin)):0;
  const fs=Math.max((xmax-xmin)/58,pxu?11/pxu:0);   // labels never below 11 px on screen
  const mark=(q,c,lab,r)=>`<circle cx="${q[0]}" cy="${-q[2]}" r="${r}" fill="${c}"/><text x="${q[0]+r*1.6}" y="${-q[2]+fs*0.35}" font-size="${fs}" font-family="'IBM Plex Mono',ui-monospace,monospace" fill="${c}">${lab}</text>`;
  const r=(xmax-xmin)/170;
  h+=mark(A.pts.tie,'#222','tie',r*0.8)+mark(A.pts.belly,'#222','',r*0.8)+mark(A.pts.tail,'#222','',r*0.8);
  h+=`<line x1="${A.CG[0]}" y1="${-A.CG[2]}" x2="${A.CB[0]}" y2="${-A.CB[2]}" stroke="#888" stroke-dasharray="${r} ${r}" stroke-width="${sw}"/>`;
  h+=mark(A.CB,'#2a62c9','CB',r*1.2)+mark(A.CG,'#c62f2f','CG',r*1.2);
 h+=`<text x="${xmin+2}" y="${-zmin-2}" font-size="${Math.max(fs*0.9,pxu?10.5/pxu:0)}" fill="#6b736f" font-family="'IBM Plex Mono',ui-monospace,monospace">grid 10 mm · dashed = hook swing reach</text>`;
  svg.innerHTML=h;
}

/* ============================== dive simulation plot ============================== */
const DV={X:x=>0,Y:z=>0};
function drawDive(p,sim){
  const el=$('dive'), br=el.getBoundingClientRect(), W=br.width>80?Math.round(br.width):640, Hh=br.height>60?Math.round(br.height):200, l=44,r=56,t=14,b=26, C=p.castDist;
  el.setAttribute('viewBox',`0 0 ${W} ${Hh}`);   // drawn in CSS pixels: 10-11 px labels stay 10-11 px at any panel size
  const maxD=Math.max(p.bottomD,sim.maxZ,p.target+0.6)*1.08+0.2;
  DV.X=x=>l+(1-x/C)*(W-l-r); DV.Y=z=>t+z/maxD*(Hh-t-b);
  const X=DV.X, Y=DV.Y;
  let s=`<defs><linearGradient id="wat" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#cfe3e0"/><stop offset="1" stop-color="#7fa7a2"/></linearGradient>
  <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" stroke="#8a6f4a" stroke-width="2"/></pattern></defs>`;
  s+=`<rect x="${X(C)}" y="${Y(0)}" width="${X(0)-X(C)}" height="${Y(p.bottomD)-Y(0)}" fill="url(#wat)" opacity=".75"/>`;
  s+=`<rect x="${X(C)}" y="${Y(p.bottomD)}" width="${X(0)-X(C)}" height="${Hh-b-Y(p.bottomD)+2}" fill="#c9b38c"/><rect x="${X(C)}" y="${Y(p.bottomD)}" width="${X(0)-X(C)}" height="${Hh-b-Y(p.bottomD)+2}" fill="url(#hatch)" opacity=".35"/>`;
  const z1=Math.max(p.target-0.6,0), z2=Math.min(p.target+0.6,p.bottomD);
  if(z2>z1) s+=`<rect x="${X(C)}" y="${Y(z1)}" width="${X(0)-X(C)}" height="${Y(z2)-Y(z1)}" fill="#f2c514" opacity=".22"/><text x="${X(C)+4}" y="${Y(z1)+11}" font-size="11" fill="#7a6200" font-family="'IBM Plex Mono',ui-monospace,monospace">target ${f1(p.target)} m ±0.6</text>`;
  // axes
  for(let d=0; d<=C+0.01; d+= C>40?10:5){ s+=`<line x1="${X(d)}" y1="${Hh-b}" x2="${X(d)}" y2="${Hh-b+4}" stroke="#555"/><text x="${X(d)}" y="${Hh-b+15}" font-size="11" text-anchor="middle" fill="#555" font-family="'IBM Plex Mono',ui-monospace,monospace">${d}</text>`; }
  s+=`<text x="${(X(C)+X(0))/2}" y="${Hh-1}" font-size="11" text-anchor="middle" fill="#6b736f">distance from you (m)</text>`;
  const step=maxD>8?2:1;
  for(let d=0; d<=maxD; d+=step){ s+=`<line x1="${l-4}" y1="${Y(d)}" x2="${l}" y2="${Y(d)}" stroke="#555"/><text x="${l-7}" y="${Y(d)+3.5}" font-size="11" text-anchor="end" fill="#555" font-family="'IBM Plex Mono',ui-monospace,monospace">${d} m</text>`; }
  // surface + angler
  s+=`<line x1="${X(C)}" y1="${Y(0)}" x2="${X(0)+20}" y2="${Y(0)}" stroke="#1f6f6a" stroke-width="1.5"/>`;
  const ax=X(0)+18; s+=`<line x1="${ax}" y1="${Y(0)}" x2="${ax}" y2="${Y(0)-10}" stroke="#1c2826" stroke-width="2"/><line x1="${ax}" y1="${Y(0)-10}" x2="${ax-26}" y2="${Y(0)-13-p.rodH*3}" stroke="#1c2826" stroke-width="1.5"/><text x="${ax+4}" y="${Y(0)-2}" font-size="11" fill="#1c2826">you</text>`;
  // curve
  const pts=sim.pts.filter((_,i)=>i%4===0||i===sim.pts.length-1).map(([x,z])=>`${X(x).toFixed(1)},${Y(z).toFixed(1)}`).join(' ');
  s+=`<polyline points="${pts}" fill="none" stroke="#d4621c" stroke-width="2.4" stroke-linejoin="round"/>`;
  s+=`<circle cx="${X(sim.maxAt)}" cy="${Y(sim.maxZ)}" r="3.5" fill="#d4621c"/><text x="${X(sim.maxAt)}" y="${Y(sim.maxZ)+15}" font-size="11.5" text-anchor="middle" fill="#a2440d" font-family="'IBM Plex Mono',ui-monospace,monospace">max ${f1(sim.maxZ)} m</text>`;
  s+=`<text x="${X(C)+2}" y="${Y(0)-4}" font-size="11" fill="#1f6f6a">splash-down</text>`;
  for(let i=0;i<sim.n;i++) if(sim.E[i]) s+=`<circle cx="${X(sim.X[i]).toFixed(1)}" cy="${Y(sim.Z[i]).toFixed(1)}" r="1.8" fill="#1f6f6a"/>`;
  s+=`<circle id="diveDot" r="5" fill="#fff" stroke="#d4621c" stroke-width="2.5" visibility="hidden"/>`;
  $('dive').innerHTML=s;
  const contact=sim.contact>0.05?` · it digs into the bottom for <b>${f1(sim.contact)} m</b> (good for deflecting off cover, but snags are possible)`:'';
  const lpt=linePerTurn(p);
  $('simRes').innerHTML=`<b>${STYLES[p.style].n}</b> on a ${p.gear}:1 reel: <b>${Math.round(lpt*100)} cm</b> (${Math.round(lpt*39.37)} in) of line per handle turn, so <b>${f2(sim.v0)} m/s</b> at ${f2(p.tps)} turns/s. It reaches a max of <b>${f1(sim.maxZ)} m</b>, ${f1(sim.maxAt)} m from you, and spends <b>${Math.round(sim.inZonePct)}%</b> of the time in the target zone${contact}. ${sim.events?`There are <b>${sim.events}</b> speed changes, which trigger reaction strikes. `:''}A full retrieve takes <b>${Math.round(sim.time)} s</b>. Press <b>▶ Swim</b> (or Space) to watch it underwater.`;
}

/* ============================== stats panel ============================== */
function $(id){return document.getElementById(id)}
const f1=v=>(Math.round(v*10)/10).toFixed(1), f2=v=>v.toFixed(2);
const STATUS_COL={F:'#1f6f6a',SF:'#26733f',N:'#e0a526',S:'#c62f2f'};
function updateStats(p,bill,A,S){
  let label,key;
  if(A.net>3){label='Floating';key='F'}
  else if(A.net>1){label='Slow float';key='SF'}
  else if(A.net>=-0.3){label='Near suspending';key='N'}
  else {label='Sinking';key='S'}
  const sb=$('statusBox'); sb.style.background=STATUS_COL[key]; sb.classList.toggle('warn',key==='N'); $('stBig').textContent=label;
  $('stSub').textContent=`${A.net>=0?'+':''}${f1(A.net)} g net buoyancy · class ${buoyClass(A.net)}`;
  $('kMass').textContent=f1(A.M)+' g'; $('kMassS').textContent=`QC band ${f2(A.M-0.3)}–${f2(A.M+0.3)} g`;
  $('kDisp').textContent=f1(A.Vd/1000)+' cm³'; $('kWater').textContent=A.water.n.toLowerCase();
  const surface=A.aF<0.15;
  $('kDepth').textContent= surface?'surface':`${f1(A.depth)} m`;
  $('kTroll').textContent= surface?'—':`${f1(A.depth*1.5)} m`;
  $('kLine').textContent=LINES[p.line].n+' · ~30 m out';
  const tg=(id,ok,txt)=>{ const el=$(id); el.className='tg '+(ok===true?'ok':ok==='w'?'w':ok===false?'e':''); el.textContent=txt; };
  const dTarget=Math.abs(A.depth-p.target);
  tg('tDepth',surface?false:dTarget<=0.6?true:dTarget<=1.2?'w':false,`target ${f1(p.target)} ±0.6 m ${dTarget<=0.6&&!surface?'✓':'✗'}`);
  const dz=A.CB[2]-A.CG[2];
  $('kStab').textContent=`${f1(dz)} mm`; $('kStab').className='v '+(dz<0.5?'c-e':dz<1.5?'c-w':'c-ok');
  tg('tStab',dz>=1.5?true:dz>=0.5?'w':false,`CB above CG · target ≥ 1.5 mm ${dz>=1.5?'✓':'✗'}`);
  const dx=A.CG[0]-A.CB[0];
  $('kRest').textContent= Math.abs(dx)<2?'Level':(dx>0?'Tail-down':'Nose-down');
  $('kRestS').textContent=`CG ${dx>=0?'+':''}${f1(dx)} mm vs CB`;
  const v=A.vPause*100;
  $('kPause').textContent= Math.abs(v)<1.5?'Hangs (≈ suspend)': v>0?`Rises ~${Math.round(v)} cm/s`:`Sinks ~${Math.round(-v)} cm/s`;
  $('kSwim').textContent=`${f1(S.f)} Hz`; $('kSwimS').textContent=`at ${f2(p.speed)} m/s · ±${Math.round(S.yaw)}° wobble`;
  const ratio=p.billW/(2*p.halfW);
  const act= ratio>1.2?'Wide, thumping wobble': ratio>0.9?'Medium wobble':'Tight wiggle';
  const extra=[]; if(p.se>2.4) extra.push('flat sides add flash'); if(p.billAng>45) extra.push('steep bill deflects off cover');
  if((p.top+p.bot)/p.L>0.3) extra.push('fat body → strong vibration');
  $('kAction').textContent=act; $('kActionS').textContent=extra.join(' · ')||`bill/body width ratio ${f2(ratio)}`;
  // ---- Simulate KPIs (odds and reel live here: B4)
  const sim=cache&&cache.sim; 
  const od=hookOdds(p,A,{trigger:false,v:p.speed}); $('kOdds').textContent=Math.round(od.p*100)+'%';
  $('kOdds').className='v '+(od.p<0.45?'c-e':od.p<0.62?'c-w':'c-ok'); $('kOddsS').textContent=od.reasons.slice(0,2).map(r=>(r[0]==='+'?'+ ':'− ')+r[1]).join(' · ');
  $('kReel').textContent=`${f2(p.speed)} m/s`; $('kReelS').textContent=`${p.gear}:1 · ${Math.round(linePerTurn(p)*100)} cm/turn`;
  $('sSwim').textContent=`${f1(S.f)} Hz`; $('sSwimS').textContent=`at ${f2(p.speed)} m/s · ±${Math.round(S.yaw)}° wobble`;
  // ---- Analyse tables
  $('massTable').innerHTML=`<tr><th>Part</th><th style="text-align:right">g</th></tr>`+A.parts.map(q=>`<tr><td>${q.n}</td><td>${f2(q.m)} g</td></tr>`).join('')+`<tr class="tot"><td>Total</td><td>${f2(A.M)} g</td></tr>`;
  const xyz=q=>q.map(x=>f1(x)).join(', ');
  $('cgTable').innerHTML=`<tr><td>Centre of gravity (x, y, z)</td><td>${xyz(A.CG)}</td></tr><tr><td>Centre of buoyancy (x, y, z)</td><td>${xyz(A.CB)}</td></tr>
   <tr><td>CB above CG (target ≥ 1.5)</td><td class="${dz<0.5?'c-e':dz<1.5?'c-w':'c-ok'}">${f1(dz)} mm</td></tr><tr><td>CG behind CB (rest attitude)</td><td>${dx>=0?'+':''}${f1(dx)} mm</td></tr>
   <tr><td>Displacement · net buoyancy</td><td>${f1(A.Vd/1000)} cm³ · ${A.net>=0?'+':''}${f2(A.net)} g</td></tr><tr><td>Float / sink rate <span class="tagi est">EST</span></td><td>${f1(v)} cm/s</td></tr>`;
  const H=A.hooks, verdict=k=>k==='e'?'<b class="c-e">foul</b>':k==='w'?'<b class="c-w">marginal</b>':'<b class="c-ok">clear</b>';
  let ht=`<tr><th>Item</th><th style="text-align:right">Value</th><th style="text-align:right">Status</th></tr>`;
  if(H.belly) ht+=`<tr><td>Belly hook ${esc(H.belly.label)} swing reach</td><td>${f1(H.belly.r)} mm</td><td></td></tr>`;
  if(H.tail) ht+=`<tr><td>Tail hook ${esc(H.tail.label)} swing reach</td><td>${f1(H.tail.r)} mm</td><td></td></tr>`;
  if(H.belly) ht+=`<tr><td>Belly hanger → line tie (needs > reach + 4)</td><td>${f1(H.tieGap)} mm</td><td>${verdict(H.lineFoul)}</td></tr>`;
  if(H.belly&&H.tail) ht+=`<tr><td>Belly hanger → tail hanger</td><td>${f1(H.hangerGap)} mm</td><td>${verdict(H.tangle)}</td></tr>`;
  if(H.belly) ht+=`<tr><td>Hook length vs body height (≥ 55 %)</td><td>${Math.round(100*H.belly.l/(p.top+p.bot))} %</td><td>${H.small?'<b class="c-w">small</b>':'<b class="c-ok">ok</b>'}</td></tr>`;
  if(!H.belly&&!H.tail) ht+=`<tr><td colspan="3" class="c-e">No hooks fitted</td></tr>`;
  $('hookTable').innerHTML=ht;
  // checks
  const C=[];
  if(dz<0.5) C.push(['e',`CG is only ${f1(dz)} mm below CB, so the lure will roll or blow out. Move the ballast lower or add weight.`]);
  else if(dz<1.5) C.push(['w',`The lure is only just stable (${f1(dz)} mm). Lower ballast will make it track straighter at speed.`]);
  else C.push(['o',`It self-rights well: CG is ${f1(dz)} mm below CB.`]);
  if(A.net<-0.3) C.push(['w','Sinks. If you want a floater that backs out of snags, reduce the ballast or hook weight, or use more infill air.']);
  else if(A.net<1 && A.net>=-0.3) C.push(['w','Close to neutral. Paint and water temperature can tip it either way, so tank-test it.']);
  if(!A.ballInside) C.push(['e','The ballast sticks outside the body at this position or size.']);
  if(BILL_MATS[p.billMat].printed && p.billT<1.8 && p.billLen>25) C.push(['w','A long printed bill under 1.8 mm thick can snap on a strike or against timber. Use polycarbonate or FR4, or a thicker bill.']);
  if(!bill.holeOK) C.push(['e','The line-tie hole is off the bill. Adjust "Line tie, from bill root".']);
  else if(p.billLen>30 && p.tieU<5) C.push(['w','For a long-bill diver, moving the tie further out on the bill (≈25–30 % of bill length) usually helps it dive.']);
  if(!H.belly && !H.tail) C.push(['e','There are no hooks fitted.']);
  if(H.lineFoul==='e') C.push(['e',`The belly hook can swing ${f1(H.belly.r)} mm, but the line tie is only ${f1(H.tieGap)} mm away. It will foul the line. Move the belly hanger back or use a smaller hook.`]);
  else if(H.lineFoul==='w') C.push(['w','The belly hook only just clears the line tie. A pause can make it foul.']);
  if(H.tangle==='e') C.push(['e',`The belly hook reaches the tail hanger (${f1(H.hangerGap)} mm apart). The hooks will tangle. Move the belly hanger forward or downsize the hooks.`]);
  else if(H.tangle==='w') C.push(['w',`The hook swings overlap a lot (hangers ${f1(H.hangerGap)} mm apart). The hooks may catch each other on the cast.`]);
  if(H.belly && !H.lineFoul && !H.tangle && (!H.tail||H.hangerGap)) C.push(['o',`The hook points clear the line tie and each other (belly reach ${f1(H.belly.r)} mm).`]);
  if(H.small) C.push(['w',`The ${H.belly.label} is small for this body height. The body can shield the points and cause missed strikes. Go up a size.`]);
  if(p.L>=80 && (p.hookStr==='std' || (H.belly && HOOKS[H.belly.size] && HOOKS[H.belly.size].l<22))) C.push(['w','For toman or snakehead, use 3X–4X strong #2–1/0 trebles or heavy inline singles.']);
  if(p.hookType==='single') C.push(['o','Inline singles are lighter and snag less in timber, but the lure will float a little higher. That is already counted.']);
  if(p.bellyX<p.L*0.25||p.bellyX>p.L*0.7) C.push(['w','The belly hanger is far from the usual 35–50 % of body length.']);
  if(p.prodMode!=='inject' && !BODY_MATS[p.bodyMat].wood && p.wall<0.8) C.push(['w','Walls under 0.8 mm tend to leak. Leaks ruin the buoyancy.']);
  if(p.prodMode==='inject'){ const g=A.prod&&A.prod.geom;
    if(g){ if(!g.cav) C.push(['e','Injection: no hollow cavity fits at this wall thickness.']);
      if(!g.slot||!g.info.slotOK) C.push(['e','Injection: the bill slot cannot be molded at this bill root. See Analyse → DFM.']);
      C.push(['o',`Injection ABS shell ${f2(g.Vshell/1000)} cm³ (wall ${f2(p.wallMm)} mm), ${g.pins.length} alignment pin${g.pins.length===1?'':'s'}. Full DFM list in Analyse and Release.`]); } }
  C.push(['o',`Through-wire harness Ø${p.wireGauge} mm SS304, ${Math.round((A.hw.find(r=>r.role==='wire')||{}).lenMm||0)} mm, rated about ${f1(wireRatedKg(+p.wireGauge))} kg.`]);
  DESIGN_CHECKS=C; renderIssues(); scheduleIssues();
  // ---- spec strip (B2)
  const cls=buoyClass(A.net), hk=[H.belly,H.tail].filter(Boolean);
  const hs=hk.length?(hk.length===2&&H.belly.size===H.tail.size?`2× ${H.belly.label.split(' ')[0]}`:hk.map(h=>h.label.split(' ')[0]).join(' + ')):'none';
  $('sLen').innerHTML=`<b>${p.L}</b> mm`; $('sMass').innerHTML=`<b>${f1(A.M)}</b> g`;
  const sc=$('sClass'); sc.className='chip cls-'+cls; sc.innerHTML=`<b>${cls==='F'?'Floating':cls==='SP'?'Suspending':'Sinking'}</b> ${A.net>=0?'+':''}${f1(A.net)} g`;
  $('sDive').innerHTML=surface?'Surface <em>est.</em>':`Dive <b>${f1(A.depth)}</b> m <em>est.</em>`;
  $('sHooks').innerHTML=`Hooks ${hs} ${p.hookType==='single'?'single':HSTR[p.hookStr].n.replace(' strong','').replace('Standard wire','std')}`;
  $('sBuild').textContent=p.prodMode==='inject'?'Injection ABS':BODY_MATS[p.bodyMat].n.replace(/ \(.*/,'');
}
/* one issue list (design checks + injection DFM) drives the Checks list, the spec-strip chip and the narrow Checks tab */
let DESIGN_CHECKS=[], DFM_LAST=null, issTimer=null;
function issueList(){ return DESIGN_CHECKS.map(([k,t])=>({k,t,src:'design'})).concat((DFM_LAST||[]).map(([k,t])=>({k,t:esc(t),src:'dfm'}))); }
function renderIssues(){
  const L=issueList(), E=L.filter(c=>c.k==='e'), Wn=L.filter(c=>c.k==='w'), ok=L.filter(c=>c.k==='o'||c.k==='i'), nE=E.length, nW=Wn.length;
  const li=c=>`<li class="${c.k}" data-src="${c.src}">${c.src==='dfm'?'<span class="src">DFM</span> ':''}${c.t}</li>`;
  $('checks').innerHTML=`<ul class="checks">${E.map(li).join('')}${Wn.map(li).join('')}</ul>`+
    (ok.length?`<details class="passed"${nE+nW?'':' open'}><summary>${ok.length} check${ok.length>1?'s':''} passed / info</summary><ul class="checks">${ok.map(li).join('')}</ul></details>`:'')+
    (DFM_LAST?'':'<p class="note">DFM (injection mold) checks are being computed…</p>');
  $('chkCount').textContent=nE||nW?`${nE} error${nE===1?'':'s'} · ${nW} warning${nW===1?'':'s'}`:'all clear';
  const si=$('sIssues'); si.className='chip '+(nE?'err':nW?'warn':'ok');
  si.textContent=nE||nW?`${nE?'✕':'!'} ${nE+nW} issue${nE+nW>1?'s':''}`:'✓ No issues'; si.dataset.n=String(nE+nW);
  si.setAttribute('aria-label',`Checks: ${nE} errors, ${nW} warnings (design and DFM). Show checks.`);
  $('ntabIssues').textContent=nE+nW?`(${nE+nW})`:'';
}
function scheduleIssues(){ clearTimeout(issTimer); issTimer=setTimeout(()=>{ try{ DFM_LAST=relModel().dfm; }catch(e){ DFM_LAST=[['e','Injection model could not be built: '+e.message]]; } renderIssues(); },350); }

/* ============================== main update ============================== */
let pending=false, cache=null, lastGood=null;
function snapshotState(){ return JSON.parse(JSON.stringify({P,PAINT,META,CW,BOMOVR,COST,PKG})); }
function restoreState(st){ P=st.P; PAINT=st.PAINT; META=st.META; CW=st.CW; BOMOVR=st.BOMOVR; COST=st.COST; PKG=st.PKG||defaultPkg(); }
/* B9: every rebuild is guarded; a failure rolls back to the last state that built */
function changed(){ if(pending) return; pending=true; requestAnimationFrame(()=>{ pending=false; safeRebuild(); }) }
function safeRebuild(){
  try{ rebuild(); lastGood=snapshotState(); return true; }
  catch(e){ console.error('rebuild failed',e); if(lastGood){ restoreState(JSON.parse(JSON.stringify(lastGood))); syncControls(); try{ rebuild(); }catch(_){} }
    toast('That change could not be built and was undone'); return false; }
}
function rebuild(){
  P.speed=lineSpeed(P);
  const p=P, body=buildBody(p), bill=buildBill(p), A=analyse(p,body,bill,bodyVolumes(p,body),BOMOVR);
  if(!isFinite(A.M)||!isFinite(A.net)||!isFinite(A.CG[0])) throw new Error('non-finite analysis result');
  const swim=swimParams(p,A), sim=diveSim(p,A);
  cache={p:JSON.parse(JSON.stringify(p)),body,bill,A,swim,sim};
  update3D(p,body,bill,A); drawSide(p,bill,A); drawDive(p,sim); updateStats(p,bill,A,swim); updateSimKPIs(p,sim); syncMeta(); applyLock(); relDirty(); anaDirty();
  if($('prodNote')) $('prodNote').textContent=p.prodMode==='inject'?`Shell ${f2(A.prod.geom.Vshell/1000)} cm³ → body ${f2(A.mBody)} g ABS. Mass and buoyancy use the exact hollow shell.`:'Prototype mode: mass uses the print / wood settings. Release always reports injection figures.';
  if(!swimming) resetPose(); else if(envOn) setEnv(true);
  if(simT>=sim.T) simT=0;
}

function updateSimKPIs(p,sim){
  const dz=Math.abs(sim.maxZ-p.target);
  $('sMax').textContent=`${f1(sim.maxZ)} m`; const t=$('sMaxT'); t.className='tg '+(dz<=0.6?'ok':dz<=1.2?'w':'e'); t.textContent=`target ${f1(p.target)} ±0.6 m ${dz<=0.6?'✓':'✗'}`;
  $('sZone').textContent=`${Math.round(sim.inZonePct)} %`; $('sZoneS').textContent=`of a ${Math.round(sim.time)} s retrieve`;
}
/* Analyse: DFM list comes from the release model (always injection), debounced like the Release view */
let anaTimer=null;
function anaDirty(){ if(MODE!=='analyse') return; clearTimeout(anaTimer); anaTimer=setTimeout(renderDFM,200); }
function renderDFM(){
  let rel; try{ rel=relModel(); }catch(e){ $('dfmList').innerHTML=`<li class="e">The injection model could not be built: ${esc(e.message)}</li>`; return; }
  const o={e:0,w:1,o:2}, L=rel.dfm.slice().sort((a,b)=>o[a[0]]-o[b[0]]);
  $('dfmList').innerHTML=(P.prodMode!=='inject'?'<li class="note" style="border:none;background:none;padding:0 0 4px">Shown for Injection ABS (the design is in Prototype mode).</li>':'')+L.map(([k,t])=>`<li class="${k}">${esc(t)}</li>`).join('');
}
/* unsaved indicator: spec + meta + costing against the last load / save */
let SAVED_SIG=null;
function stateSig(){ try{ return JSON.stringify([specObject(stateNow()),META,COST,PKG,$('dname').value]); }catch(e){ return ''; } }
function markSaved(){ SAVED_SIG=stateSig(); updateDirty(); }
function updateDirty(){ const el=$('dirty'); if(!el||SAVED_SIG==null) return; const d=stateSig()!==SAVED_SIG; el.innerHTML=d?'●<span class="dl"> Unsaved changes</span>':''; el.setAttribute('aria-label',d?'Unsaved changes':'All changes saved'); el.title=d?'Unsaved changes':''; const n=$('dname'); if(n) n.title=n.value; }

/* ============================== exports ============================== */
function stlBinary(tris,name){
  const n=tris.length/9, buf=new ArrayBuffer(84+n*50), dv=new DataView(buf);
  const hdr=('UmpanLab '+name).slice(0,79); for(let i=0;i<hdr.length;i++) dv.setUint8(i,hdr.charCodeAt(i)&127);
  dv.setUint32(80,n,true);
  let o=84;
  for(let k=0;k<tris.length;k+=9){
    const ux=tris[k+3]-tris[k],uy=tris[k+4]-tris[k+1],uz=tris[k+5]-tris[k+2],wx=tris[k+6]-tris[k],wy=tris[k+7]-tris[k+1],wz=tris[k+8]-tris[k+2];
    let nx=uy*wz-uz*wy,ny=uz*wx-ux*wz,nz=ux*wy-uy*wx; const l=Math.hypot(nx,ny,nz)||1;
    dv.setFloat32(o,nx/l,true);dv.setFloat32(o+4,ny/l,true);dv.setFloat32(o+8,nz/l,true); o+=12;
    for(let a=0;a<9;a++){dv.setFloat32(o,tris[k+a],true);o+=4}
    dv.setUint16(o,0,true); o+=2;
  }
  return buf;
}
function slotTris(p,B){ // box representing the bill slot (for a separate "cut slot here" body) — exported as a guide part
  const tw=2*(billOutline(p).tabHW+0.3), g=new THREE.BoxGeometry(TAB+2.5,tw,p.billT+0.4); g.translate(-(TAB+2.5)/2+2,0,0); g.applyMatrix4(B.M);
  const pa=g.attributes.position.array, ix=g.index.array, t=new Float32Array(ix.length*3);
  for(let k=0;k<ix.length;k++){t[k*3]=pa[ix[k]*3];t[k*3+1]=pa[ix[k]*3+1];t[k*3+2]=pa[ix[k]*3+2]}
  if(massProps(t).V<0) flipTris(t); return t;
}
function templateSVG(){
  const {p,bill,A}=cache, pd=profileData(p), B=bill.B, bc=billSideCorners(p,B,bill.outline.tip);
  const ox=-Math.min(0,...bc.map(v=>v.x))+12, W=Math.ceil(ox+p.L+20);
  const oy=p.top+22, sideH=oy+Math.max(p.bot,-Math.min(...bc.map(v=>v.z)))+14;
  const oy2=sideH+Math.max(p.halfW,p.billW/2)+12, H=Math.ceil(oy2+Math.max(p.halfW,p.billW/2)+22);
  const side=pd.xs.map((x,i)=>`${(ox+x).toFixed(2)},${(oy-pd.tops[i]).toFixed(2)}`).concat(pd.xs.slice().reverse().map((x,i)=>`${(ox+x).toFixed(2)},${(oy+pd.bots[pd.xs.length-1-i]).toFixed(2)}`)).join(' ');
  const top=pd.xs.map((x,i)=>`${(ox+x).toFixed(2)},${(oy2-pd.ws[i]).toFixed(2)}`).concat(pd.xs.slice().reverse().map((x,i)=>`${(ox+x).toFixed(2)},${(oy2+pd.ws[pd.xs.length-1-i]).toFixed(2)}`)).join(' ');
  const lipS=bc.map(v=>`${(ox+v.x).toFixed(2)},${(oy-v.z).toFixed(2)}`).join(' ');
  const lipT=bill.outline.pts.map(([u,v])=>`${(ox+p.rootX-u*Math.cos(B.th)).toFixed(2)},${(oy2-v).toFixed(2)}`).join(' ');
  const flat=bill.outline.pts.map(([u,v])=>`${(12+u+TAB).toFixed(2)},${(H+6+bill.outline.R+v).toFixed(2)}`).join(' ');
  const H2=H+bill.outline.R*2+18;
  const dot=(q,l)=>`<circle cx="${(ox+q[0]).toFixed(2)}" cy="${(oy-q[2]).toFixed(2)}" r="0.9" fill="red"/><text x="${(ox+q[0]+1.6).toFixed(2)}" y="${(oy-q[2]+3.2).toFixed(2)}" font-size="2.6">${l}</text>`;
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${Math.max(W,90)}mm" height="${H2}mm" viewBox="0 0 ${Math.max(W,90)} ${H2}" font-family="Arial, Helvetica, system-ui, sans-serif">
<rect width="100%" height="100%" fill="white"/>
<text x="4" y="6" font-size="3.6" font-weight="bold">${esc($('dname').value||'Umpan Lab design')} — 1:1 template (print at 100%)</text>
<text x="4" y="10.5" font-size="2.6">L ${p.L} mm · bill ${f1(A.tip)}×${p.billW} mm @ ${p.billAng}° · ${f1(A.M)} g · ${f1(A.net)} g net buoyancy</text>
<text x="4" y="${oy-p.top-4}" font-size="2.8">SIDE</text>
<polygon points="${side}" fill="none" stroke="black" stroke-width="0.3"/>
<polygon points="${lipS}" fill="none" stroke="#1f6f6a" stroke-width="0.3"/>
<line x1="${ox}" y1="${oy}" x2="${ox+p.L}" y2="${oy}" stroke="#999" stroke-dasharray="1,1" stroke-width="0.2"/>
${dot(A.pts.tie,'line tie')}${dot(A.pts.belly,'belly hanger')}${dot(A.pts.tail,'tail hanger')}${p.ballN?dot(A.pts.ball,'ballast'):''}
<text x="4" y="${oy2-Math.max(p.halfW,p.billW/2)-3}" font-size="2.8">TOP (bill projected)</text>
<polygon points="${lipT}" fill="none" stroke="#1f6f6a" stroke-width="0.3"/>
<polygon points="${top}" fill="none" stroke="black" stroke-width="0.3"/>
<text x="4" y="${H+2}" font-size="2.8">BILL — flat cut pattern (tab ${TAB} mm goes into the body slot)</text>
<polygon points="${flat}" fill="none" stroke="#1f6f6a" stroke-width="0.3"/>
${bill.holeOK?`<circle cx="${12+p.tieU+TAB}" cy="${H+6+bill.outline.R}" r="1.1" fill="none" stroke="#1f6f6a" stroke-width="0.25"/>`:''}
<line x1="${W-60}" y1="${H2-5}" x2="${W-10}" y2="${H2-5}" stroke="black" stroke-width="0.5"/><text x="${W-60}" y="${H2-1.5}" font-size="2.6">50 mm — check scale</text>
</svg>`;
}
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function stateNow(){ return {P,PAINT,META,CW,BOMOVR,COST,PKG,name:$('dname').value||''}; }
function resultsBlock(){ const A=cache.A, cls=buoyClass(A.net);
  return {sku:skuOf(META,P.L,cls,CW),class:cls,weight_g:+f2(A.M),displacement_cm3:+f2(A.Vd/1000),net_buoyancy_g:+f2(A.net),est_depth_cast_m:+f1(A.depth),
    CG_mm:A.CG.map(v=>+f1(v)),CB_mm:A.CB.map(v=>+f1(v)),hardware_mm:Object.fromEntries(Object.entries(A.pts).map(([k,v])=>[k,v.map(x=>+f1(x))])),mode:P.prodMode}; }
async function designJSON(){ const st=stateNow(), h=await specHash(st); return JSON.stringify(designV2(st,st.name,resultsBlock(),h),null,2); }
function slug(){return ($('dname').value||'umpan-lab-lure').trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')||'lure'}

let DL=null;
(async()=>{ try{ if(window.claude && typeof window.claude.use==='function') DL=await window.claude.use('downloads'); }catch(e){ DL=null } })();
async function save(filename,data,fallbackText){
  if(!DL){ if(fallbackText!=null) showModal(filename,fallbackText,'Downloads are not available in this view. Copy the text and save it as '+filename+'. Open the page on claude.ai to download files directly.'); else toast('Downloads are not available in this view. Open the page on claude.ai.'); return }
  try{ await DL.save({filename,data}); toast('Saved '+filename) }
  catch(e){ const c=e&&e.code; if(c==='declined') toast('Download cancelled'); else if(c==='rate_limited') toast('A download prompt is already open'); else { if(fallbackText!=null) showModal(filename,fallbackText,'Download unavailable here. Copy the text instead.'); else toast('Download unavailable here'); } }
}
$('zipBtn').onclick=async()=>{
  if(!cache) return; const {p,body,bill}=cache;
  if(typeof JSZip==='undefined'){toast('Zip library failed to load');return}
  const zip=new JSZip(), s=slug();
  const assembly=new Float32Array(body.tris.length+bill.tris.length); assembly.set(body.tris); assembly.set(bill.tris,body.tris.length);
  zip.file(`${s}_assembly.stl`,stlBinary(assembly,'assembly'));
  zip.file(`${s}_body.stl`,stlBinary(body.tris,'body'));
  zip.file(`${s}_bill.stl`,stlBinary(bill.tris,'bill'));
  zip.file(`${s}_bill-slot-cutter.stl`,stlBinary(slotTris(p,bill.B),'slot cutter'));
  zip.file(`${s}_template_1to1.svg`,templateSVG());
  zip.file(`${s}.json`,await designJSON());
  zip.file('README.txt',`Umpan Lab export — ${s}
Units: millimetres. Axes: X nose(0)->tail, Y width, Z up. The bill points forward/down (negative X).

${s}_assembly.stl         Body + bill as two overlapping shells. Most slicers and lure apps merge them on import.
${s}_body.stl             Body only (solid, watertight).
${s}_bill.stl             Bill only, including the ${TAB} mm tab that goes into the body, and the line-tie hole.
${s}_bill-slot-cutter.stl Subtract this from the body (in your CAD or slicer) to cut the bill slot. It has 0.4 mm clearance.
${s}_template_1to1.svg    Side and top profiles plus a flat bill pattern at 1:1. Print at 100 %.
${s}.json                 Every parameter, plus weight, buoyancy, CG/CB and hardware positions. Re-import it into Umpan Lab.
`);
  const blob=await zip.generateAsync({type:'blob'});
  save(`${s}.zip`,blob,null);
};
$('svgBtn').onclick=()=>{ if(cache){const t=templateSVG(); save(`${slug()}_template_1to1.svg`,t,t)} };
$('jsonBtn').onclick=async()=>{ if(cache){const t=await designJSON(); save(`${slug()}.json`,t,t)} };
$('importBtn').onclick=()=>$('importFile').click();
$('importFile').onchange=async e=>{
  const f=e.target.files[0]; if(!f) return;
  let d=null; try{ d=JSON.parse(await f.text()); }catch(_){ toast('That file is not valid JSON'); e.target.value=''; return; }
  loadDesign(d,(d&&d.name)||f.name.replace(/\.json$/,''),'imported');
  e.target.value='';
};

/* ============================== release tab (view + exports) ============================== */
let relTimer=null, REL=null, QC_TEXT=null, QC_NAME='', _jspdfP=null;
const JSPDF_URL='https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
function relVisible(){ return typeof MODE!=='undefined'&&MODE==='release'; }
function relDirty(){ if(!relVisible()) return; clearTimeout(relTimer); relTimer=setTimeout(renderRelease,180); }
function relState(){ return Object.assign(snapshotState(),{name:$('dname').value||''}); }
let RELC={sig:null,rel:null};   // one release model per state: shared by Release, Analyse DFM, the issue chip and the gate
function relModel(){ const st=relState(), sig=JSON.stringify(st); if(RELC.sig!==sig){ const rel=releaseModel(st); RELC={sig,rel}; } return RELC.rel; }
function loadJsPDF(){
  if(window.jspdf&&window.jspdf.jsPDF) return Promise.resolve(window.jspdf.jsPDF);
  if(!_jspdfP) _jspdfP=new Promise((res,rej)=>{ const sc=document.createElement('script'); sc.src=JSPDF_URL; sc.async=true;
    sc.onload=()=>window.jspdf&&window.jspdf.jsPDF?res(window.jspdf.jsPDF):rej(new Error('jsPDF did not initialise'));
    sc.onerror=()=>{ _jspdfP=null; rej(new Error('jsPDF could not be loaded')); }; document.head.appendChild(sc); });
  return _jspdfP;
}
async function relBundle(){ const st=relState(), rel=releaseModel(st), hash=await specHash(st); return {st,rel,hash,qcRes:QC_TEXT?qcEvaluate(rel.qc,QC_TEXT):null}; }
function relSlug(rel){ return `${rel.modelCode}-${rel.cw.code}_rev${rel.meta.rev}`.replace(/[^A-Za-z0-9_-]/g,''); }
async function techpackPDF(rel,hash){
  const jsPDF=await loadJsPDF(), doc=new jsPDF({orientation:'landscape',unit:'mm',format:'a3',compress:true});
  doc.setProperties({title:`Tech pack ${rel.modelCode} rev ${rel.meta.rev}`,subject:rel.sku,keywords:'spec-sha256 '+hash,creator:'Umpan Lab'});
  sheetModels(rel,hash).forEach((m,i)=>{ if(i) doc.addPage('a3','l'); sheetPDF(doc,m); });
  return doc.output('arraybuffer');
}
function relResults(rel){ const A=rel.A; return {sku:rel.sku,class:rel.cls,mode:'inject',water:'fresh',weight_g:+fx(A.M,3),displacement_cm3:+fx(A.Vd/1000,3),net_buoyancy_g:+fx(A.net,3),
  shell_cm3:+fx(rel.geom.Vshell/1000,4),body_L_cm3:+fx(rel.geom.VL/1000,4),body_R_cm3:+fx(rel.geom.VR/1000,4),est_depth_cast_m:+fx(A.depth,2),
  CG_mm:A.CG.map(v=>+fx(v,2)),CB_mm:A.CB.map(v=>+fx(v,2)),hardware_mm:Object.fromEntries(Object.entries(A.pts).map(([k,v])=>[k,v.map(x=>+fx(x,2))]))}; }
function qcResultsCSV(rel,res){ const rows=[['sample_id',...rel.qc.map(q=>q.key),...rel.qc.map(q=>q.key+'_ok'),'result']];
  res.rows.forEach(r=>rows.push([r.id,...r.cells.map(c=>c.v==null?'':c.v),...r.cells.map(c=>c.ok===null?'':c.ok?'pass':'fail'),r.pass===null?'':r.pass?'PASS':'FAIL'])); return csvOf(rows); }
function canvasPNGBase64(){ try{ renderer.render(scene,camera); const u=renderer.domElement.toDataURL('image/png'); return u.split(',')[1]||null; }catch(e){ return null; } }
async function exportReleasePack(){
  if(typeof JSZip==='undefined'){ toast('Zip library failed to load'); return; }
  toast('Building release pack…');
  const {st,rel,hash,qcRes}=await relBundle(), g=rel.geom, zip=new JSZip(), files=[];
  const add=(n,data,desc,opt)=>{ zip.file(n,data,opt); files.push([n,desc]); };
  const stl=(m,n)=>stlBinary(trisFromIndexed(m.pos,m.idx),n);
  add('body_L.stl',stl(g.L,'body_L'),`Left half (−Y), watertight${g.pins.length?', with Ø'+PROD.pinD+' pins':''}`);
  add('body_R.stl',stl(g.R,'body_R'),`Right half (+Y), watertight${g.pins.length?', with Ø'+PROD.holeD+' holes':''}`);
  add('body_shell.stl',stl(g.shell,'body_shell'),'Closed hollow shell, no pins (mass / SLA master)');
  add('bill.stl',stlBinary(rel.bill.tris,'bill'),`Bill incl. ${TAB} mm tab and Ø2.2 line-tie hole`);
  const asm=[g.L,g.R].map(m=>trisFromIndexed(m.pos,m.idx)).concat([rel.bill.tris]); const at=new Float32Array(asm.reduce((s2,t)=>s2+t.length,0)); let o=0; asm.forEach(t=>{at.set(t,o);o+=t.length;});
  add('assembly_preview.stl',stlBinary(at,'assembly'),'body_L + body_R + bill in assembled position (separate shells, preview only)');
  const png=canvasPNGBase64(); if(png) add('preview.png',png,'Screenshot of the 3D view at export time',{base64:true});
  add('sections.csv',sectionsCSV(rel),'Exact superellipse sections at 25 stations (outer + inner), for re-lofting in CAD');
  add('drawing.svg',drawingSVG(rel,hash),'A3 drawing sheet 1 (views, hardware, notes), 1 user unit = 1 mm');
  add('drawing_sheet2.svg',sheetSVG(drawingModel2(rel,hash)),'A3 drawing sheet 2 (sections, bill flat pattern, tolerances)');
  add('techpack.html',techpackHTML(rel,hash,qcRes),'Self-contained printable tech pack');
  let pdfNote='';
  try{ add('techpack.pdf',await techpackPDF(rel,hash),'Tech pack PDF, A3 × 4: drawing sheets 1–2, BOM / costing / packaging, QC / DFM / revisions'); }
  catch(e){ pdfNote='techpack.pdf was not included: '+e.message+'. Use techpack.html → Print → PDF.'; }
  add('bom.csv',bomCSV(rel),'Bill of materials'); add('qc_criteria.md',qcMarkdown(rel,hash),'QC acceptance sheet + sampling plan');
  add('tank_test.csv',tankTemplateCSV(rel),'Tank-test log template (TARGET / TOL rows are ignored on import)');
  add('costing.csv',costingCSV(rel),'Unit cost, FOB excl. tooling, tooling NRE, FOB incl. amortised tooling at 1k / 3k / 5k');
  add('packaging.csv',packagingCSV(rel),'SKU, EAN-13, blister / card / inner / carton sizes, card copy EN / BM');
  if(qcRes) add('qc_results.csv',qcResultsCSV(rel,qcRes),`Imported tank test (${QC_NAME}) with pass / fail`);
  add('design.json',JSON.stringify(designV2(st,st.name,relResults(rel),hash),null,2),'Design file v2 (spec / sim / meta); re-import in Umpan Lab');
  zip.file('README.txt',readmeTxt(rel,hash,files.concat([['README.txt','This file']]),pdfNote));
  const blob=await zip.generateAsync({type:'blob',compression:'DEFLATE'});
  await save(`${relSlug(rel)}_release.zip`,blob,null);
}
async function exportOne(kind){
  const {rel,hash,qcRes}=await relBundle(), sl=relSlug(rel);
  if(kind==='svg'){ const t=drawingSVG(rel,hash); return save(`${sl}_drawing.svg`,t,t); }
  if(kind==='html'){ const t=techpackHTML(rel,hash,qcRes); return save(`${sl}_techpack.html`,t,t); }
  if(kind==='bom'){ const t=bomCSV(rel); return save(`${sl}_bom.csv`,t,t); }
  if(kind==='tank'){ const t=tankTemplateCSV(rel); return save(`${sl}_tank_test.csv`,t,t); }
  if(kind==='pdf'){ try{ const ab=await techpackPDF(rel,hash); return save(`${sl}_techpack.pdf`,new Blob([ab],{type:'application/pdf'}),null); }
    catch(e){ toast('PDF library unavailable here. Use techpack.html and print to PDF.'); } }
}
let REL_SHEET=1;
function autoGrow(el){ el.style.height='auto'; el.style.height=(el.scrollHeight+2)+'px'; }
function renderRelease(){
  const root=$('relRoot'); if(!root) return; let rel;
  try{ rel=relModel(); }catch(e){ console.error(e); root.innerHTML=`<div class="card">The release model could not be built: ${esc(e.message)}</div>`; return; }
  REL=rel; const locked=META.status==='Released', g=rel.geom, A=rel.A, c=rel.costing, so=META.signoff, G=rel.gate, K=rel.pack;
  const qcRes=QC_TEXT?qcEvaluate(rel.qc,QC_TEXT):null, oldShell=A.bm.A*g.wall;
  const num=(v,n)=>`<td class="n">${fx(v,n)}</td>`, dis=locked?' disabled':'';
  /* BOM editor: text cells are auto-growing textareas (wrap, never truncate); numbers are compact inputs */
  const bomCols=[['partNo','Part no.','t',9],['desc','Description','t',14.5],['spec','Spec','t',14.5],['size','Size','t',8],['finish','Finish','t',7],['ratedKg','Rated kg','n',5],['mass_g','Mass g','n',5.5],['supplier','Supplier','t',8.5],['unitCostUSD','Unit USD','n',6.5],['qty','Qty','n',3.5],['moq','MOQ','n',5.5],['leadTimeDays','Lead d','n',4]];
  const cell=(r,[f,h,t])=>{ const o=BOMOVR[r.role]&&f in BOMOVR[r.role], v=esc(r[f]??''), a=`data-role="${r.role}" data-f="${f}" aria-label="BOM line ${r.item}, ${h}" title="${v}"${o?' class="ovr"':''}${dis}`;
    return t==='t'?`<td><textarea rows="1" ${a}>${v}</textarea></td>`:`<td class="n"><input inputmode="decimal" value="${v}" ${a}></td>`; };
  const cwRow=(k)=>({o:'c-ok',w:'c-w',e:'c-e',i:''}[k]);
  const gateList=G.ok?`<p class="c-ok"><b>✓ Gate complete.</b> T1, Golden and Released are allowed.</p>`:`<p class="c-e"><b>T1, Golden and Released are blocked until:</b></p><ul class="gate">${G.missing.map(m=>`<li>${esc(m)}</li>`).join('')}</ul>`;
  root.innerHTML=`
  <div class="relbar"><span class="sku" id="relSku">${esc(rel.sku)}</span><span class="badge s-${META.status}">${esc(META.status)}</span><span>Rev <b>${esc(META.rev)}</b></span>
   <span class="mono" id="relHash" title="SHA-256 of the canonical spec JSON">SHA-256 …</span><span style="flex:1"></span>
   <button id="rPack">Release pack (.zip)</button><button class="ghost" id="rPdf">techpack.pdf</button><button class="ghost" id="rHtml">techpack.html</button>
   <button class="ghost" id="rSvg">drawing.svg</button><button class="ghost" id="rBom">bom.csv</button></div>
  ${P.prodMode!=='inject'?'<p class="note">These figures are for Injection ABS (production) in fresh water. Design is set to Prototype mode.</p>':''}
  ${locked?'<div class="lockbar">Released: spec, colourway, packaging and BOM are locked. Change the status to edit; the revision letter then goes up.</div>':''}
  ${G.watermark?`<div class="nfp" id="nfpBar" role="status">${esc(G.watermark)} · exports carry this watermark</div>`:''}
  <div class="relgrid">
   <section class="card w2"><h5>Tech-pack drawing preview (A3) <span class="note">· read-only; generated from the spec</span>
     <span class="seg sheetsel" role="group" aria-label="Drawing sheet"><button id="rSh1" aria-pressed="${REL_SHEET===1}">Sheet 1</button><button id="rSh2" aria-pressed="${REL_SHEET===2}">Sheet 2</button></span></h5>
     <div class="drawprev" id="drawPrev">${sheetSVG((REL_SHEET===2?drawingModel2:drawingModel)(rel,'(computing)'),{inline:true})}</div></section>
   <div class="stack">
   <section class="card${G.ok?'':' gatebad'}" id="gateCard" aria-labelledby="gateH"><h5 id="gateH">Release gate</h5>
     ${GATE_MSG?`<p class="c-e" role="alert"><b>${esc(GATE_MSG.status)} was refused.</b> Fill in the items below, then set the status again.</p>`:''}${gateList}
     ${G.warn.length?`<p class="note">Note: ${esc(G.warn.join(' · '))}</p>`:''}
     <p class="note">Below Released every drawing, PDF and HTML export is stamped “${esc(G.watermark||'NOT FOR PRODUCTION')}”.</p></section>
   <section class="card"><h5>Revision &amp; sign-off</h5><table class="rt"><tr><th>Role</th><th>Name</th><th>Date</th></tr>
     ${['drawn','checked','approved'].map(r=>`<tr><td>${r[0].toUpperCase()+r.slice(1)}</td><td><input data-so="${r}" data-f="name" value="${esc(so[r].name)}" placeholder="name" maxlength="60" aria-label="${r} by, name"></td><td><input data-so="${r}" data-f="date" value="${esc(so[r].date)}" placeholder="YYYY-MM-DD" maxlength="20" aria-label="${r}, date"></td></tr>`).join('')}</table>
     <div class="hgroup" style="margin:6px 0;flex-wrap:wrap"><button class="ghost" id="rLog">Log changes now</button><span class="note">Save also logs the spec diff.</span></div>
     <ul class="clog">${META.changelog.slice(-8).reverse().map(e=>`<li><b>Rev ${esc(e.rev)}</b> · ${esc(e.date)} · ${esc(e.status)}<br>${esc(e.changes.slice(0,6).join('; '))}${e.changes.length>6?' …':''}</li>`).join('')||'<li class="note">No logged changes yet.</li>'}</ul></section>
   <section class="card"><h5>Production figures (injection, fresh water)</h5><table class="rt">
     <tr><td>Class · net buoyancy</td><td class="n">${rel.cls} · ${A.net>=0?'+':''}${fx(A.net,2)} g</td></tr>
     <tr><td>Weight ready to fish</td><td class="n">${fx(A.M,2)} g ±0.3</td></tr>
     <tr><td>Shell (exact) · body mass</td><td class="n">${fx(g.Vshell/1000,3)} cm³ · ${fx(A.mBody,2)} g</td></tr>
     <tr><td>Old estimate area × wall</td><td class="n">${fx(oldShell/1000,3)} cm³ · ${fx(INJ_MAT.rho*oldShell/1000,2)} g</td></tr>
     <tr><td>body_L · body_R volume</td><td class="n">${fx(g.VL/1000,3)} · ${fx(g.VR/1000,3)} cm³</td></tr>
     <tr><td>Mesh check L / R / shell</td><td class="n">${[g.checkL,g.checkR,g.checkShell].map(k=>k.watertight?'✓':'✗ '+k.nonManifold).join(' / ')}</td></tr>
     <tr><td>Float / sink rate</td><td class="n">${fx(A.vPause*100,1)} cm/s</td></tr>
     <tr><td>Action est.</td><td class="n">${fx(rel.S05.f,1)} Hz @0.5 · ${fx(rel.S10.f,1)} Hz @1.0</td></tr>
     <tr><td>Depth (${esc(LINES[rel.p.line].n)})</td><td class="n">${fx(A.depth,1)} m cast · ${fx(A.depth*1.5,1)} m troll</td></tr>
     <tr><td>Eyes (3D sticker)</td><td class="n">Ø${fx(rel.eye.d,1)} · x ${fx(rel.eye.x,1)} z ${fx(rel.eye.z,1)}</td></tr>
     <tr><td>Ballast fixing</td><td class="n">${p_ballTxt(rel.p)}</td></tr></table></section>
   </div>
   <section class="card"><h5>DFM checks</h5><ul class="checks">${rel.dfm.slice().sort((a,b)=>({e:0,w:1,i:2,o:3}[a[0]]-{e:0,w:1,i:2,o:3}[b[0]])).map(([k,t])=>`<li class="${k}">${esc(t)}</li>`).join('')}</ul></section>
   <section class="card"><h5>Costing <span class="note">· ${esc(c.currency)} · ${esc(c.incoterm||'Incoterm TBD')}</span></h5>
     <div class="costin">${COST_ITEMS.map(([k,l,u,lo,hi])=>`<label for="c_${k}">${l} <em class="note">${u}</em></label><input type="number" id="c_${k}" data-cost="${k}" min="${lo}" max="${hi}" step="any" value="${COST[k]}">`).join('')}
       ${COST_TEXT.map(([k,l,n])=>`<label for="c_${k}">${l}</label><input type="text" id="c_${k}" data-cost="${k}" maxlength="${n}" value="${esc(COST[k]||'')}"${k==='rateDate'?' placeholder="YYYY-MM-DD"':''}>`).join('')}</div>
     <table class="rt" id="costT">${c.lines.map(l=>`<tr><td>${esc(l[0])}</td>${num(l[1],3)}</tr>`).join('')}<tr class="tot"><td>Variable cost (unit cost)</td>${num(c.variable,3)}</tr>
       <tr><td>Margin ${c.marginPct} % (on unit cost only)</td>${num(c.margin,3)}</tr><tr class="tot"><td>FOB excl. tooling</td><td class="n" id="costFob">${fx(c.fobEx,3)}</td></tr></table>
     <p class="note"><b>Tooling, one-off NRE (not in FOB): <span id="costTool">${fx(c.tooling,0)}</span> ${esc(c.currency)}</b> · mold ${fx(COST.moldUSD,0)} + bill die ${fx(COST.billToolUSD,0)}</p>
     <table class="rt" style="margin-top:6px"><tr><th class="n">Qty</th><th class="n">FOB excl.</th><th class="n">Tooling/u (info)</th><th class="n">FOB incl. amort.</th></tr>${c.tiers.map(t=>`<tr>${num(t.qty,0)}${num(t.fobEx,3)}${num(t.amort,3)}${num(t.fobIncl,3)}</tr>`).join('')}</table></section>
   <section class="card" id="pkgCard"><h5>Packaging <span class="note">· packaging.csv in the release pack</span></h5>
     <div class="costin pk">
       <label for="k_ean13">EAN-13 <em class="note">12 digits → check digit added</em></label><input type="text" id="k_ean13" data-pkg="ean13" inputmode="numeric" maxlength="13" value="${esc(PKG.ean13)}"${dis}>
       ${[['cardW','Card width','mm'],['cardH','Card height','mm'],['innerQty','Inner box qty','pcs'],['cartonQty','Carton qty','pcs']].map(([k,l,u])=>`<label for="k_${k}">${l} <em class="note">${u}</em></label><input type="number" id="k_${k}" data-pkg="${k}" step="1" value="${PKG[k]}"${dis}>`).join('')}
     </div>
     <p class="mono" id="eanOut" style="font-size:12px">${K.ean.ok?`EAN-13 <b>${K.ean.full}</b> · ${esc(K.ean.msg)}`:K.ean.ok===false?`<span class="c-e">EAN-13 ${esc(K.ean.msg)}${K.ean.full?' → '+K.ean.full:''}</span>`:'EAN-13 not set'}</p>
     <table class="rt"><tr><td>Lure envelope incl. hooks</td><td class="n">${fx(K.env.L,1)} × ${fx(K.env.H,1)} × ${fx(K.env.W,1)}</td></tr>
       <tr><td>Blister inner (+5 mm)</td><td class="n">${fx(K.blister.L,0)} × ${fx(K.blister.H,0)} × ${fx(K.blister.D,0)}</td></tr>
       <tr><td>Inner box (${K.innerQty} pcs)</td><td class="n">${K.inner.W} × ${K.inner.H} × ${K.inner.D}</td></tr>
       <tr><td>Carton (${K.cartonQty} pcs, ${K.nInner} inners)</td><td class="n">${K.carton?K.carton.dims.map(v=>fx(v,0)).join(' × '):'—'} · ${fx(K.grossKg,1)} kg</td></tr></table>
     <ul class="checks">${K.checks.map(([k,t])=>`<li class="${k}">${esc(t)}</li>`).join('')}</ul>
     <label class="stack" for="k_cardEN">Card copy EN <span class="note">(empty = auto)</span><textarea id="k_cardEN" data-pkg="cardEN" rows="2" maxlength="200" placeholder="${esc(K.copyEN)}"${dis}>${esc(PKG.cardEN)}</textarea></label>
     <label class="stack" for="k_cardBM">Card copy BM <span class="note">(empty = auto)</span><textarea id="k_cardBM" data-pkg="cardBM" rows="2" maxlength="200" placeholder="${esc(K.copyBM)}"${dis}>${esc(PKG.cardBM)}</textarea></label></section>
   <section class="card wide"><h5>Bill of materials <span class="note">· edit any cell; orange = overridden; clear a cell to reset. Hardware mass edits feed the weight model.</span></h5>
     <div class="bomwrap"><table class="rt bom" id="bomT"><colgroup><col style="width:2.5%">${bomCols.map(([,,,w])=>`<col style="width:${w}%">`).join('')}<col style="width:5.5%"><col style="width:3.5%"></colgroup>
     <tr><th>#</th>${bomCols.map(([,h,t])=>`<th${t==='n'?' class="n"':''}>${h}</th>`).join('')}<th class="n">Ext USD</th><th>Lure</th></tr>
     ${rel.bom.map(r=>`<tr><td>${r.item}</td>${bomCols.map(col=>cell(r,col)).join('')}${num(r.extUSD,3)}<td>${r.inLure?'yes':'no'}</td></tr>`).join('')}
     <tr class="tot"><td colspan="7">BOM mass in lure ${fx(rel.bom.filter(r=>r.inLure).reduce((a,r)=>a+(+r.mass_g)*(+r.qty),0),2)} g (model ${fx(A.M,2)} g)</td><td colspan="5"></td><td class="n" colspan="2">${fx(rel.bom.reduce((a,r)=>a+r.extUSD,0),3)} USD</td></tr></table></div></section>
   <section class="card"><h5>QC · tank test</h5><table class="rt"><tr><th>Criterion</th><th class="n">Target</th><th class="n">Tol</th><th>Unit</th></tr>${rel.qc.map(q=>`<tr><td title="${esc(q.method)}">${esc(q.label)}</td><td class="n">${q.type==='bool'?'Y':fx(q.target,2)}</td><td class="n">${esc(q.tol)}</td><td>${esc(q.unit)}</td></tr>`).join('')}</table>
     <div class="hgroup" style="margin:6px 0;flex-wrap:wrap"><button class="ghost" id="rQcImp">Import measured CSV</button><button class="ghost" id="rQcTpl">tank_test.csv template</button>${QC_TEXT?'<button class="ghost" id="rQcClr">Clear</button>':''}</div>
     ${qcRes?`<p class="note"><b>${qcRes.summary.pass}/${qcRes.summary.n}</b> samples pass${qcRes.summary.fail?` · ${qcRes.summary.fail} fail (${Object.entries(qcRes.summary.perKey).map(([k,n])=>`${k} ×${n}`).join(', ')})`:''} · ${esc(QC_NAME)}</p>${qcRes.warn.length?`<p class="note">${esc(qcRes.warn.join(' '))}</p>`:''}
     <div style="overflow:auto"><table class="rt" id="qcT"><tr><th>Sample</th>${rel.qc.map(q=>`<th class="n" title="${esc(q.label)}">${esc(q.key.replace(/_/g,' '))}</th>`).join('')}<th>Result</th></tr>
     ${qcRes.rows.map(r=>`<tr class="${r.pass===true?'pass':r.pass===false?'fail':''}"><td>${esc(r.id)}</td>${r.cells.map(x=>`<td class="n${x.ok===false?' bad':''}">${x.v==null||x.v===''?'—':esc(typeof x.v==='number'?fx(x.v,2):x.v)}</td>`).join('')}<td><b>${r.pass===null?'—':r.pass?'PASS':'FAIL'}</b></td></tr>`).join('')}</table></div>`:'<p class="note">Fill in tank_test.csv (one row per sample) and import it to get a pass / fail table.</p>'}</section>
  </div>`;
  const q=id=>root.querySelector('#'+id);
  q('rPack').onclick=()=>exportReleasePack().catch(e=>{console.error(e);toast('Release pack failed: '+e.message)});
  q('rPdf').onclick=()=>exportOne('pdf'); q('rHtml').onclick=()=>exportOne('html'); q('rSvg').onclick=()=>exportOne('svg'); q('rBom').onclick=()=>exportOne('bom');
  q('rSh1').onclick=()=>{ REL_SHEET=1; renderRelease(); }; q('rSh2').onclick=()=>{ REL_SHEET=2; renderRelease(); };
  q('rQcTpl').onclick=()=>exportOne('tank'); q('rQcImp').onclick=()=>$('qcFile').click(); if(q('rQcClr')) q('rQcClr').onclick=()=>{QC_TEXT=null;renderRelease()};
  q('rLog').onclick=()=>{ const n=logChanges(); toast(n?`${n} change${n>1?'s':''} logged in rev ${META.rev}`:'No spec changes since the last log'); };
  root.querySelectorAll('input[data-so]').forEach(el=>el.onchange=()=>{ META.signoff[el.dataset.so][el.dataset.f]=el.value.trim().slice(0,el.dataset.f==='name'?60:20); relDirty(); updateDirty(); scheduleIssues(); });
  root.querySelectorAll('[data-cost]').forEach(el=>el.onchange=()=>{ COST=validateCost(Object.assign({},COST,{[el.dataset.cost]:el.value})); relDirty(); updateDirty(); });
  root.querySelectorAll('[data-pkg]').forEach(el=>el.onchange=()=>{ let v=el.value; if(el.dataset.pkg==='ean13'){ const st=ean13Status(v.replace(/\D/g,'')); if(st.ok&&/^\d{12}$/.test(v.replace(/\D/g,''))) v=st.full; }
    PKG=validatePkg(Object.assign({},PKG,{[el.dataset.pkg]:v})); relDirty(); updateDirty(); scheduleIssues(); });
  root.querySelectorAll('#bomT textarea').forEach(autoGrow);
  root.querySelectorAll('#bomT [data-role]').forEach(el=>{ if(el.tagName==='TEXTAREA'){ el.addEventListener('input',()=>autoGrow(el)); el.addEventListener('keydown',e=>{ if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); el.dispatchEvent(new Event('change')); } }); }
    el.onchange=()=>{ const role=el.dataset.role, f=el.dataset.f, v=el.value.trim(), o=Object.assign({},BOMOVR[role]||{});
    if(v==='') delete o[f]; else o[f]=v;
    const val=validateBomOverrides({[role]:o}); if(val[role]) BOMOVR[role]=val[role]; else delete BOMOVR[role];
    if(['mass_g','qty'].includes(f)) changed(); else { relDirty(); updateDirty(); } }; });
  specHash(relState()).then(h=>{ const el=q('relHash'); if(el){ el.textContent='SHA-256 '+h.slice(0,12)+'…'; el.title=h; } const dp=q('drawPrev'); if(dp) dp.innerHTML=sheetSVG((REL_SHEET===2?drawingModel2:drawingModel)(rel,h),{inline:true}); });
}
function p_ballTxt(p){ return p.ballN?(p.ballFix==='rattle'?'loose rattle':'glued in pocket'):'—'; }
$('qcFile').onchange=async e=>{ const f=e.target.files[0]; if(!f) return; try{ QC_TEXT=await f.text(); QC_NAME=f.name; renderRelease(); toast('Tank test imported'); }catch(_){ toast('Could not read that file'); } e.target.value=''; };

/* ============================== presets & saved designs ============================== */
const DEFAULTS=Object.assign({},PROD_DEFAULTS,PRESETS.toman90.p);
let BASELINE=null;   // spec at load / last save: the changelog diffs against it
/* accepts v2 / v1 / legacy objects; validates every field; rolls back if the result cannot be built */
function loadDesign(d,name,how){
  const prev=snapshotState(), prevName=$('dname').value;
  let r; try{ r=migrateDesign(d,DEFAULTS); }catch(e){ toast('That file is not an Umpan Lab design ('+e.message+')'); return false; }
  restoreState(r.st); $('dname').value=name||'';
  try{ syncControls(); firstFrame=true; rebuild(); lastGood=snapshotState(); BASELINE=specObject(stateNow()); setTicks(); markSaved(); }
  catch(e){ console.error(e); restoreState(prev); $('dname').value=prevName; syncControls(); try{ rebuild(); }catch(_){} toast('Could not build that design; nothing was changed'); return false; }
  if(how) toast(r.warn.length?`Design ${how} with ${r.warn.length} correction${r.warn.length>1?'s':''}: ${r.warn.slice(0,2).join('; ')}${r.warn.length>2?' …':''}`:`Design ${how}`);
  window.__lastImportWarnings=r.warn;
  return true;
}
function loadPreset(k){ const pr=PRESETS[k]; const ok=loadDesign({version:1,params:pr.p},pr.name.replace(/ \(.*/,''));
  if(ok){ META=defaultMeta(PRESET_FAMILY[k]||'UL'); CW=defaultCW(P.pattern); syncControls(); relDirty(); lastGood=snapshotState(); BASELINE=specObject(stateNow()); markSaved(); }
  return ok; }
/* auto-diff changelog entry against the baseline */
function logChanges(note){
  const cur=specObject(stateNow()), ch=BASELINE?diffSpec(BASELINE,cur):[];
  if(note) ch.unshift(note);
  if(ch.length){ META.changelog.push({rev:META.rev,date:isoDate(),status:META.status,changes:ch.slice(0,60)}); if(META.changelog.length>200) META.changelog.shift(); }
  BASELINE=cur; relDirty(); return ch.length;
}
$('presetList').innerHTML=Object.entries(PRESETS).map(([k,v])=>`<button role="menuitem" data-preset="${k}">${esc(v.name)}</button>`).join('');
$('presetList').querySelectorAll('[data-preset]').forEach(b=>b.onclick=()=>{ closeMenus(); if(swimming) startSwim(false); if(loadPreset(b.dataset.preset)) toast('New design from preset: '+PRESETS[b.dataset.preset].name); });

const LS='umpanlab.designs.v1';
function readSaved(){try{const o=JSON.parse(localStorage.getItem(LS)||'{}'); return o&&typeof o==='object'?o:{}}catch(e){return {}}}
function writeSaved(o){try{localStorage.setItem(LS,JSON.stringify(o));return true}catch(e){return false}}
function refreshMine(){const o=readSaved(); $('mine').innerHTML='<option value="">My designs…</option>'+Object.keys(o).sort().map(k=>`<option value="${esc(k)}">${esc(k)}</option>`).join('')}
$('saveBtn').onclick=()=>{const n=($('dname').value||'').trim(); if(!n){toast('Give the design a name first');$('dname').focus();return}
  const nch=logChanges(); const o=readSaved(); o[n]=designV2(stateNow(),n);
  if(writeSaved(o)){refreshMine(); $('mine').value=n; markSaved(); toast(nch?`Saved in this browser · ${nch} change${nch>1?'s':''} logged in rev ${META.rev}`:'Saved in this browser')} else toast('This browser blocks local saving. Use Export instead.')};
$('mine').onchange=()=>{const n=$('mine').value; if(!n)return; const d=readSaved()[n]; if(d){ closeMenus(); if(swimming) startSwim(false); loadDesign(d,n,'loaded'); }};
/* delete asks first, in an in-page dialog (no confirm() in the sandbox) */
$('delBtn').onclick=()=>{const n=$('mine').value; if(!n){toast('Pick a saved design to delete');return}
  const d=readSaved()[n], rev=d&&d.meta&&d.meta.rev?` Rev ${d.meta.rev}`:'';
  confirmDialog(`Delete “${n}${rev}”?`,'It is removed from this browser. This can\'t be undone. Exported files are not affected.','Delete',()=>{ const o=readSaved(); delete o[n]; writeSaved(o); refreshMine(); toast('Deleted '+n); });
};

/* ============================== misc UI ============================== */
let tt; function toast(m){const t=$('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(tt); tt=setTimeout(()=>t.classList.remove('show'),2600)}
let modalReturn=null;
function openModal(id,focusId){ modalReturn=document.activeElement; $(id).classList.add('show'); setTimeout(()=>{ const f=$(focusId); if(f) f.focus(); },0); }
function closeModal(id){ $(id).classList.remove('show'); if(modalReturn&&modalReturn.focus&&document.contains(modalReturn)) modalReturn.focus(); modalReturn=null; }
function showModal(title,text,note){ $('mTitle').textContent=title; $('mNote').textContent=note||''; $('mText').value=text; openModal('modal','mClose'); }
$('mClose').onclick=()=>closeModal('modal');
$('mCopy').onclick=async()=>{ try{ await navigator.clipboard.writeText($('mText').value); toast('Copied') }catch(e){ $('mText').select(); toast('Press Ctrl+C to copy') } };
let confirmCb=null;
function confirmDialog(title,text,okLabel,cb){ $('cTitle').textContent=title; $('cText').textContent=text; $('cOk').textContent=okLabel||'OK'; confirmCb=cb; closeMenus(); openModal('confirmDlg','cCancel'); }
$('cCancel').onclick=()=>{ confirmCb=null; closeModal('confirmDlg'); };
$('cOk').onclick=()=>{ const cb=confirmCb; confirmCb=null; closeModal('confirmDlg'); if(cb) cb(); };
['modal','confirmDlg'].forEach(id=>$(id).addEventListener('mousedown',e=>{ if(e.target.id===id){ if(id==='confirmDlg') confirmCb=null; closeModal(id); } }));
/* focus trap inside an open modal */
document.addEventListener('keydown',e=>{
  const m=document.querySelector('.modal.show'); if(!m) return;
  if(e.key==='Escape'){ e.preventDefault(); if(m.id==='confirmDlg') confirmCb=null; closeModal(m.id); return; }
  if(e.key==='Tab'){ const f=[...m.querySelectorAll('button,textarea,input,select')].filter(x=>!x.disabled); if(!f.length) return;
    const i=f.indexOf(document.activeElement); if(e.shiftKey&&i<=0){ e.preventDefault(); f[f.length-1].focus(); } else if(!e.shiftKey&&i===f.length-1){ e.preventDefault(); f[0].focus(); } }
},true);

/* menus (File / Export): close on outside click, Escape, or after an action */
function closeMenus(except){ document.querySelectorAll('details.menu[open]').forEach(d=>{ if(d!==except) d.open=false; }); }
document.querySelectorAll('details.menu').forEach(d=>d.addEventListener('toggle',()=>{ if(d.open){ closeMenus(d); const f=d.querySelector('.pop button'); if(f) f.focus(); } }));
document.addEventListener('mousedown',e=>{ if(!e.target.closest('details.menu')) closeMenus(); });
document.addEventListener('keydown',e=>{ if(e.key==='Escape'){ const d=document.querySelector('details.menu[open]'); if(d){ d.open=false; d.querySelector('summary').focus(); } } });
document.querySelectorAll('.pop').forEach(p=>p.addEventListener('keydown',e=>{
  if(e.key!=='ArrowDown'&&e.key!=='ArrowUp') return; const items=[...p.querySelectorAll('button,select')]; const i=items.indexOf(document.activeElement);
  if(e.target.tagName==='SELECT') return; e.preventDefault(); const n=items[(i+(e.key==='ArrowDown'?1:-1)+items.length)%items.length]; if(n) n.focus(); }));
['zipBtn','svgBtn','jsonBtn','importBtn'].forEach(id=>$(id).addEventListener('click',()=>closeMenus()));
document.querySelectorAll('#exportMenu [data-x]').forEach(b=>b.onclick=()=>{ closeMenus(); const k=b.dataset.x;
  if(k==='pack') exportReleasePack().catch(e=>{console.error(e);toast('Release pack failed: '+e.message)}); else exportOne(k); });

/* ---------- modes (B1) + hash routing ---------- */
const MODES=['design','analyse','simulate','release'];
let MODE='design';
function setMode(m,opts){
  if(!MODES.includes(m)) m='design'; const prev=MODE; MODE=m;
  document.body.dataset.mode=m;
  document.querySelectorAll('.modes [role=tab]').forEach(t=>{ const on=t.dataset.mode===m; t.setAttribute('aria-selected',String(on)); t.tabIndex=on?0:-1; });
  $('app').setAttribute('aria-labelledby','tab-'+m);
  if(prev==='simulate'&&m!=='simulate'&&swimming) startSwim(false);
  applyPanelH();
  if(m==='release') renderRelease();
  if(m==='analyse') { clearTimeout(anaTimer); anaTimer=setTimeout(renderDFM,30); }
  if(matchMedia('(max-width:1099px)').matches){ if(m==='analyse'&&document.body.dataset.ntab==='params') setNTab('results'); else if(prev==='analyse'&&m==='design'&&document.body.dataset.ntab==='results') setNTab('params'); }
  if(!(opts&&opts.noHash)){ try{ history.replaceState(null,'','#'+m); }catch(e){} }
  requestRender();
}
document.querySelectorAll('.modes [role=tab]').forEach(t=>{
  t.onclick=()=>setMode(t.dataset.mode);
  t.onkeydown=e=>{ const i=MODES.indexOf(t.dataset.mode); let j=null;
    if(e.key==='ArrowRight') j=(i+1)%4; else if(e.key==='ArrowLeft') j=(i+3)%4; else if(e.key==='Home') j=0; else if(e.key==='End') j=3;
    if(j!=null){ e.preventDefault(); setMode(MODES[j]); $('tab-'+MODES[j]).focus(); } };
});
window.addEventListener('hashchange',()=>{ const h=location.hash.slice(1); if(MODES.includes(h)&&h!==MODE) setMode(h,{noHash:true}); });
/* issue chip → checks */
$('sIssues').onclick=()=>{
  if(MODE!=='design') setMode('design');
  if(matchMedia('(max-width:1099px)').matches) setNTab('checks');
  const sec=$('checksSec'); sec.scrollIntoView({block:'start',behavior:'smooth'}); sec.classList.remove('flash'); void sec.offsetWidth; sec.classList.add('flash');
  const det=sec.querySelector('details.passed'); if(det&&!sec.querySelector('ul.checks li')) det.open=true;
  $('chkH').tabIndex=-1; $('chkH').focus({preventScroll:true});
};

/* ---------- resizable bottom panel (B8), per mode, persisted ---------- */
const PANEL_LS='umpanlab.panelH.v1';
let PANEL_H=(()=>{ try{ const o=JSON.parse(localStorage.getItem(PANEL_LS)||'{}'); return o&&typeof o==='object'?o:{}; }catch(e){ return {}; } })();
const PANEL_DEF={design:240,simulate:270};
function centerH(){ return document.querySelector('.center').clientHeight||600; }
function panelLimits(){ const h=centerH(); return [160,Math.max(200,Math.min(h-140,window.innerHeight*0.6))]; }
function applyPanelH(){
  const m=MODE; if(m==='release') return; const [lo,hi]=panelLimits();
  let v=PANEL_H[m]; if(!isFinite(v)) v=m==='analyse'?Math.round(centerH()*0.5):PANEL_DEF[m];
  v=Math.round(clamp(v,lo,hi)); document.documentElement.style.setProperty('--panel-h',v+'px');
  const sp=$('splitter'); sp.setAttribute('aria-valuenow',v); sp.setAttribute('aria-valuemin',lo); sp.setAttribute('aria-valuemax',Math.round(hi)); sp.setAttribute('aria-valuetext',`${v} px`);
}
function setPanelH(v,persist){ const [lo,hi]=panelLimits(); PANEL_H[MODE]=Math.round(clamp(v,lo,hi)); applyPanelH(); if(persist){ try{ localStorage.setItem(PANEL_LS,JSON.stringify(PANEL_H)); }catch(e){} } }
(()=>{ const sp=$('splitter'); let drag=false;
  sp.addEventListener('pointerdown',e=>{ drag=true; sp.setPointerCapture(e.pointerId); e.preventDefault(); });
  sp.addEventListener('pointermove',e=>{ if(!drag) return; const r=document.querySelector('.center').getBoundingClientRect(); setPanelH(r.bottom-e.clientY-3,false); });
  const end=e=>{ if(!drag) return; drag=false; try{ sp.releasePointerCapture(e.pointerId); }catch(_){} setPanelH(PANEL_H[MODE],true); };
  sp.addEventListener('pointerup',end); sp.addEventListener('pointercancel',end);
  sp.addEventListener('dblclick',()=>{ delete PANEL_H[MODE]; try{ localStorage.setItem(PANEL_LS,JSON.stringify(PANEL_H)); }catch(e){} applyPanelH(); });
  sp.addEventListener('keydown',e=>{ const cur=+sp.getAttribute('aria-valuenow'), st=e.shiftKey?60:20;
    if(e.key==='ArrowUp'){ e.preventDefault(); setPanelH(cur+st,true); } else if(e.key==='ArrowDown'){ e.preventDefault(); setPanelH(cur-st,true); }
    else if(e.key==='Home'){ e.preventDefault(); setPanelH(0,true); } else if(e.key==='End'){ e.preventDefault(); setPanelH(1e5,true); } });
  window.addEventListener('resize',()=>applyPanelH());
})();

/* ---------- narrow layout tabs: Params | Results | Checks ---------- */
function setNTab(t){ document.body.dataset.ntab=t; document.querySelectorAll('.ntabs [role=tab]').forEach(b=>{ const on=b.dataset.ntab===t; b.setAttribute('aria-selected',String(on)); b.tabIndex=on?0:-1; }); }
document.querySelectorAll('.ntabs [role=tab]').forEach(b=>{ b.onclick=()=>setNTab(b.dataset.ntab);
  b.onkeydown=e=>{ const L=['params','results','checks'], i=L.indexOf(b.dataset.ntab); let j=null; if(e.key==='ArrowRight') j=(i+1)%3; else if(e.key==='ArrowLeft') j=(i+2)%3;
    if(j!=null){ e.preventDefault(); setNTab(L[j]); document.querySelector(`.ntabs [data-ntab=${L[j]}]`).focus(); } }; });

/* ---------- keyboard: Space toggles the swim (not while typing or on a control) ---------- */
document.addEventListener('keydown',e=>{
  if(e.code!=='Space'&&e.key!==' ') return; if(e.ctrlKey||e.metaKey||e.altKey) return;
  if(document.querySelector('.modal.show')) return;
  if(e.target.closest&&e.target.closest('input,select,textarea,button,summary,a,[contenteditable],[role=separator],[role=tab],details.menu')) return;
  e.preventDefault(); if(MODE!=='simulate') setMode('simulate'); startSwim(!swimming);
});
$('dname').addEventListener('input',()=>updateDirty());

buildControls(); refreshMine(); resize();
loadPreset('toman90'); $('dname').value='Toman Deep Crank 90'; markSaved();
setMode(MODES.includes(location.hash.slice(1))?location.hash.slice(1):'design',{noHash:true});
resize(); requestRender();
</script>
</body>
</html>
