function p_L(rel){ return rel.p.L; }
function packagingCSV(rel){ const k=rel.pack, rows=[['field','value','unit']];
  const add=(f,v,u)=>rows.push([f,v,u||'']);
  add('sku',k.sku); add('ean13',k.ean.ok?k.ean.full:(rel.pkg.ean13||''),k.ean.ok===false?'INVALID: '+k.ean.msg:''); add('lure_envelope_LxHxW',`${fx(k.env.L,1)} x ${fx(k.env.H,1)} x ${fx(k.env.W,1)}`,'mm incl. hooks');
  add('blister_inner_LxHxD',`${fx(k.blister.L,0)} x ${fx(k.blister.H,0)} x ${fx(k.blister.D,0)}`,'mm (+5 mm)'); add('card_WxH',`${k.card.W} x ${k.card.H}`,'mm, 350 gsm');
  add('unit_packed_mass',fx(k.unitG,1),'g'); add('inner_qty',k.innerQty,'pcs'); add('inner_box_WxHxD',`${k.inner.W} x ${k.inner.H} x ${k.inner.D}`,'mm');
  add('carton_qty',k.cartonQty,'pcs'); add('inners_per_carton',k.nInner); add('carton_LxWxH',k.carton?k.carton.dims.map(v=>fx(v,0)).join(' x '):'','mm (inner dims)');
  add('carton_gross',fx(k.grossKg,2),'kg'); add('card_copy_en',k.copyEN); add('card_copy_bm',k.copyBM);
  k.checks.forEach(([t,m])=>add('check_'+(t==='o'?'ok':t==='w'?'warn':'error'),m));
