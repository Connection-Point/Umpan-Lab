const BOM_FIELDS=['partNo','desc','spec','size','finish','ratedKg','mass_g','supplier','unitCostUSD','qty','moq','leadTimeDays'];
const BOM_NUM={ratedKg:[0,1000],mass_g:[0,1000],unitCostUSD:[0,1000],qty:[0,100],moq:[0,1e7],leadTimeDays:[0,1000]};

function defaultMeta(family){ return {family:family||'UL',rev:'A',status:'Concept',changelog:[],signoff:{drawn:{name:'',date:''},checked:{name:'',date:''},approved:{name:'',date:''}}}; }
/* packaging (spec.packaging, hashed + locked with the spec); card copy empty = auto text */
const PKG_DEFAULTS={ean13:'',cardW:95,cardH:210,innerQty:6,cartonQty:120,cardEN:'',cardBM:''};
const PKG_NUM={cardW:[40,400],cardH:[60,500],innerQty:[1,200],cartonQty:[1,5000]};
function defaultPkg(){ return Object.assign({},PKG_DEFAULTS); }
function validatePkg(raw){ const o=defaultPkg(); raw=(raw&&typeof raw==='object')?raw:{};
  for(const k in PKG_NUM){ const n=Number(raw[k]); if(raw[k]!==undefined&&raw[k]!==''&&raw[k]!==null&&isFinite(n)) o[k]=Math.round(clamp(n,PKG_NUM[k][0],PKG_NUM[k][1])); }
  if(typeof raw.ean13==='string'||typeof raw.ean13==='number') o.ean13=String(raw.ean13).replace(/\D/g,'').slice(0,13);
  ['cardEN','cardBM'].forEach(k=>{ if(typeof raw[k]==='string') o[k]=raw[k].slice(0,200); });
  return o; }
/* EAN-13: weights 1,3,1,3… on the first 12 digits; check = (10 − sum mod 10) mod 10 */
function ean13Check(d12){ const s=String(d12); if(!/^\d{12}$/.test(s)) return null; let t=0; for(let i=0;i<12;i++) t+=(+s[i])*(i%2?3:1); return (10-t%10)%10; }
function ean13Status(v){ const s=String(v||''); if(!s) return {ok:null,msg:'EAN-13 not set'};
  if(/^\d{12}$/.test(s)) return {ok:true,full:s+ean13Check(s),msg:'check digit added'};
  if(!/^\d{13}$/.test(s)) return {ok:false,msg:'EAN-13 needs 12 or 13 digits'};
  const c=ean13Check(s.slice(0,12)); return +s[12]===c?{ok:true,full:s,msg:'valid'}:{ok:false,full:s.slice(0,12)+c,msg:`wrong check digit (${s[12]}, expected ${c})`}; }
function defaultCW(pattern){ const c=PATTERN_CW[pattern]||PATTERN_CW.firetiger; return {code:c.code,name:c.name,layers:c.layers,pantone:'',finish:'Gloss',complexity:c.complexity}; }

let P = JSON.parse(JSON.stringify(Object.assign({},PROD_DEFAULTS,PRESETS.toman90.p)));
let PAINT = Object.assign({}, PATTERNS.firetiger);
let META = defaultMeta('TDC'), CW = defaultCW('firetiger'), BOMOVR = {}, COST = Object.assign({},COST_DEFAULTS), PKG = defaultPkg();

/* ---------- one parameter schema: UI, clamping, import, migration ---------- */
const SIM_GROUP_KEYS=['line','water','clarity'];
let _schema=null;
function paramSchema(){
  if(_schema) return _schema; const S={};
  const add=(it,sec)=>{ S[it.k]= it.type==='select' ? {t:'enum',v:it.o.map(o=>String(o[0])),sec} : {t:'num',min:it.min,max:it.max,int:it.step===1&&Number.isInteger(it.min),sec}; };
  GROUPS.forEach(g=>g.items.forEach(it=>add(it,SIM_GROUP_KEYS.includes(it.k)?'sim':g.prod?'prod':'spec')));
  SIM_ITEMS.forEach(it=>add(it,'sim'));
  S.pattern={t:'enum',v:Object.keys(PATTERNS),sec:'spec'};
  S.speed={t:'num',min:0,max:10,sec:'sim'};
  return (_schema=S);
}
/* Number()+clamp for numbers, enum check for selects; unknown keys dropped; missing keys from base. */
function validateParams(raw,base){
  const S=paramSchema(), out={}, warn=[]; raw=(raw&&typeof raw==='object')?raw:{};
  for(const k in S){
    const s=S[k], has=Object.prototype.hasOwnProperty.call(raw,k), v=raw[k], def=base[k];
    if(!has||v===undefined){ out[k]=def; continue; }
    if(s.t==='num'){
      const n=(typeof v==='number'||(typeof v==='string'&&v.trim()!==''))?Number(v):NaN;
      if(!isFinite(n)){ out[k]=def; warn.push(`${k}: "${String(v).slice(0,20)}" is not a number, using ${def}`); continue; }
      let c=clamp(n,s.min,s.max); if(s.int) c=Math.round(c);
      if(c!==n) warn.push(`${k}: ${n} clamped to ${c}`); out[k]=c;
    } else {
      const sv=String(v); if(s.v.includes(sv)) out[k]=sv; else { out[k]=def; warn.push(`${k}: "${sv.slice(0,20)}" is not a valid option, using ${def}`); }
    }
  }
  return {p:out,warn};
}
const HEX=/^#[0-9a-fA-F]{6}$/;
function validatePaint(raw,pattern){
  const base=PATTERNS[pattern]||PATTERNS.firetiger, o=Object.assign({},base); raw=(raw&&typeof raw==='object')?raw:{};
  ['back','side','belly','head'].forEach(k=>{ if(typeof raw[k]==='string'&&HEX.test(raw[k])) o[k]=raw[k]; });
  ['bars','headOn'].forEach(k=>{ if(typeof raw[k]==='boolean') o[k]=raw[k]; });
  return o;
}
const str=(v,n,def)=>typeof v==='string'?v.slice(0,n):(typeof v==='number'?String(v).slice(0,n):def);
function validateMeta(raw,fallbackFamily){
  const m=defaultMeta(fallbackFamily); raw=(raw&&typeof raw==='object')?raw:{};
  const fam=String(raw.family||String(raw.modelCode||'').replace(/[^A-Za-z]+$/,'').replace(/\d+$/,'')||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,6);
  if(fam) m.family=fam;
  const rev=String(raw.rev||'').toUpperCase(); if(/^[A-Z]{1,2}$/.test(rev)) m.rev=rev;
  if(STATUSES.includes(raw.status)) m.status=raw.status;
  if(Array.isArray(raw.changelog)) m.changelog=raw.changelog.slice(-200).filter(e=>e&&typeof e==='object').map(e=>({rev:str(e.rev,3,'?'),date:str(e.date,25,''),status:STATUSES.includes(e.status)?e.status:'',changes:Array.isArray(e.changes)?e.changes.slice(0,80).map(c=>str(c,300,'')):[]}));
  if(raw.signoff&&typeof raw.signoff==='object') ['drawn','checked','approved'].forEach(r=>{ const s=raw.signoff[r]; if(s&&typeof s==='object') m.signoff[r]={name:str(s.name,60,''),date:str(s.date,20,'')}; });
  return m;
}
function validateCW(raw,pattern){
  const c=defaultCW(pattern); raw=(raw&&typeof raw==='object')?raw:{};
  const code=String(raw.code||'').toUpperCase().replace(/[^A-Z0-9-]/g,'').slice(0,10); if(code) c.code=code;
  ['name','layers','pantone'].forEach((k,i)=>{ if(typeof raw[k]==='string') c[k]=raw[k].slice(0,[40,300,120][i]); });
  if(FINISHES.includes(raw.finish)) c.finish=raw.finish;
  const cx=Math.round(Number(raw.complexity)); if(cx>=1&&cx<=4) c.complexity=cx;
  return c;
}
function validateBomOverrides(raw){
  const out={}; if(!raw||typeof raw!=='object') return out;
  for(const role of Object.keys(raw).slice(0,40)){
    const r=raw[role]; if(!/^[a-zA-Z0-9_]{1,20}$/.test(role)||!r||typeof r!=='object') continue; const o={};
    for(const f of BOM_FIELDS){ if(!(f in r)) continue;
      if(BOM_NUM[f]){ const n=Number(r[f]); if(isFinite(n)&&r[f]!==''&&r[f]!==null) o[f]=clamp(n,BOM_NUM[f][0],BOM_NUM[f][1]); }
      else if(typeof r[f]==='string'||typeof r[f]==='number') o[f]=String(r[f]).slice(0,80); }
    if(Object.keys(o).length) out[role]=o;
  }
  return out;
}
function validateCost(raw){
  const c=Object.assign({},COST_DEFAULTS); if(!raw||typeof raw!=='object') return c;
  COST_ITEMS.forEach(([k,,,lo,hi])=>{ const n=Number(raw[k]); if(raw[k]!==undefined&&raw[k]!==''&&raw[k]!==null&&isFinite(n)) c[k]=clamp(n,lo,hi); });
  COST_TEXT.forEach(([k,,n])=>{ if(typeof raw[k]==='string') c[k]=raw[k].slice(0,n); });
  c.cavities=Math.max(1,Math.round(c.cavities));
  return c;
}
/* Accepts v2 files, v1 files ({version:1,params,paint}) and legacy localStorage entries ({params,paint}). Returns a full, validated state. */
function migrateDesign(d,base){
  if(!d||typeof d!=='object') throw new Error('not an object');
  let raw, paint, meta, cw, bom, cost, pkg, warn=[], from;
  if(d.spec&&typeof d.spec==='object'){
    from='v2'; const sp=d.spec;
    raw=Object.assign({},d.sim||{},sp,sp.production||{});
    paint=sp.paint; cw=sp.colourway; bom=sp.bom&&sp.bom.overrides; meta=d.meta; cost=d.costing; pkg=sp.packaging;
  } else if(d.params&&typeof d.params==='object'){
    from='v1'; raw=Object.assign({},d.params); paint=d.paint;
    if(raw.wireGauge===undefined&&raw.wire!==undefined){ const w=Number(raw.wire); raw.wireGauge=!(w>=0.7)?'0.8':w<1.1?'1.0':'1.2'; warn.push(`wire ${raw.wire} g migrated to Ø${raw.wireGauge} mm through-wire`); }
  } else throw new Error('no spec or params section');
  const v=validateParams(raw,base); warn=warn.concat(v.warn);
  const st={P:v.p, PAINT:validatePaint(paint,v.p.pattern), META:validateMeta(meta,(d.meta&&d.meta.family)||'UL'), CW:validateCW(cw,v.p.pattern), BOMOVR:validateBomOverrides(bom), COST:validateCost(cost), PKG:validatePkg(pkg)};
  if(from==='v1') st.META.changelog.push({rev:st.META.rev,date:isoDate(),status:st.META.status,changes:['Migrated from a v1 design file']});
  return {st,warn,from};
}
function isoDate(){ const d=new Date(); return d.toISOString().slice(0,10); }

/* ============================== geometry ============================== */
const TAB = 10;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const smooth=(e0,e1,x)=>{const t=clamp((x-e0)/(e1-e0),0,1);return t*t*(3-2*t)};
const sgnpow=(v,e)=>Math.sign(v)*Math.pow(Math.abs(v),e);

function radii(t,p){
  const B=p.taper, A=p.fat*B/(1-p.fat);
  const norm=Math.pow(p.fat,A)*Math.pow(1-p.fat,B);
  const base=Math.pow(Math.max(t,0),A)*Math.pow(Math.max(1-t,0),B)/norm;
  const s=smooth(0.35,0.8,t), g=Math.sqrt(clamp(1-Math.pow(t,10),0,1)), tail=g*(1-base)*s;
  return [p.top*base+p.tailR*tail, p.bot*base+p.tailR*tail, p.halfW*base+p.tailR*0.8*tail];
}

function hexRGB(h){const c=new THREE.Color(h);return [c.r,c.g,c.b]}
function mix(a,b,t){return [a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t]}
function paintAt(x,zn,L){
  let c=hexRGB(PAINT.side);
  c=mix(c,hexRGB(PAINT.back),smooth(0.2,0.75,zn));
  c=mix(c,hexRGB(PAINT.belly),smooth(0.15,0.6,-zn));
  if(PAINT.bars && zn>-0.35 && x>0.24*L && x<0.93*L){
    const ph=((x/L)*7)%1; if(ph<0.26) c=mix(c,[0.05,0.06,0.05],0.55*smooth(-0.35,0.1,zn));
  }
  if(PAINT.headOn) c=mix(c,hexRGB(PAINT.head),1-smooth(0.15*L,0.23*L,x));
  return c;
}

function buildBody(p){
  const NS=110, NA=64, pos=[], col=[], idx=[];
  const ts=[]; for(let i=0;i<NS;i++) ts.push((1-Math.cos(Math.PI*i/(NS-1)))/2);
  for(let i=1;i<NS-1;i++){
    const t=ts[i], [top,bot,w]=radii(t,p), x=t*p.L;
    for(let j=0;j<NA;j++){
      const a=2*Math.PI*j/NA, c=Math.cos(a), s=Math.sin(a);
      const y=w*sgnpow(c,2/p.se), z=(s>=0?top:bot)*sgnpow(s,2/p.se);
      pos.push(x,y,z); col.push(...paintAt(x, z>=0? z/top : z/bot, p.L));
    }
  }
  const R=NS-2, nose=R*NA, tail=nose+1;
  pos.push(0,0,0); col.push(...paintAt(0,0,p.L));
  pos.push(p.L,0,0); col.push(...paintAt(p.L,0,p.L));
  for(let i=0;i<R-1;i++) for(let j=0;j<NA;j++){
    const a0=i*NA+j, a1=i*NA+(j+1)%NA, b0=a0+NA, b1=a1+NA;
    idx.push(a0,b0,a1, a1,b0,b1);
  }
  for(let j=0;j<NA;j++){ idx.push(nose,j,(j+1)%NA); const o=(R-1)*NA; idx.push(tail,o+(j+1)%NA,o+j); }
  // orient outward
  const tris=trisFromIndexed(pos,idx);
  if(massProps(tris).V<0){ for(let k=0;k<idx.length;k+=3){const t=idx[k+1];idx[k+1]=idx[k+2];idx[k+2]=t;} }
  const g=new THREE.BufferGeometry();
  g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));
  g.setAttribute('color',new THREE.Float32BufferAttribute(col,3));
  g.setIndex(idx); g.computeVertexNormals();
  return {geo:g, tris:trisFromIndexed(pos,idx)};
}

function billBasis(p){
  const th=p.billAng*Math.PI/180;
  const d=new THREE.Vector3(-Math.cos(th),0,-Math.sin(th));
  const n=new THREE.Vector3(-Math.sin(th),0,Math.cos(th));
  const root=new THREE.Vector3(p.rootX,0,p.rootZ);
  const M=new THREE.Matrix4().makeBasis(d,new THREE.Vector3(0,1,0),n).setPosition(root);
  return {d,n,root,M,th};
}
/* half-width |y| of a superellipse section (radii top/bot/w) at height z; 0 outside */
function seHalfWidth(top,bot,w,se,z){ const r=z>=0?top:bot; if(!(r>0)||!(w>0)) return 0; const q=Math.abs(z)/r; if(q>=1) return 0; return w*Math.pow(1-Math.pow(q,se),1/se); }
function bodyHalfWidthAt(p,x,z){ if(!(x>0)||!(x<p.L)) return 0; const [a,b,w]=radii(x/p.L,p); return seHalfWidth(a,b,w,p.se,z); }
/* B1: the tab is sized from the body section along its length (u in [-TAB,-1.5]; the last 1.5 mm is the slot mouth) */
function tabHalfWidth(p){
  const th=p.billAng*Math.PI/180, dx=-Math.cos(th), dz=-Math.sin(th), nx=-Math.sin(th), nz=Math.cos(th), T=p.billT/2;
  let m=Infinity;
  for(let k=0;k<=24;k++){ const u=-TAB+(TAB-1.5)*k/24;
    for(const s of [-1,0,1]) m=Math.min(m,bodyHalfWidthAt(p,p.rootX+dx*u+nx*s*T,p.rootZ+dz*u+nz*s*T)); }
  return clamp(Math.min(7,0.8*m,p.billW/2-0.5),1,7);
}
function dedupeCollinear(pts){ // B11: drop exactly-collinear interior points of a closed outline
  const out=[]; const n=pts.length;
  for(let i=0;i<n;i++){ const a=pts[(i-1+n)%n], b=pts[i], c=pts[(i+1)%n];
    const cr=(b[0]-a[0])*(c[1]-b[1])-(b[1]-a[1])*(c[0]-b[0]);
    if(Math.abs(cr)>1e-9 || Math.hypot(c[0]-a[0],c[1]-a[1])<1e-9) out.push(b); }
  return out;
}
function billOutline(p){ // returns array of [u,v] (closed) + params
  const R=p.billW/2, hwRoot=Math.min(9,R), tabHW=tabHalfWidth(p), c=Math.max(p.billLen-R,1);
  const right=[];
  for(let k=0;k<=24;k++){const u=c*k/24; right.push([u,hwRoot+(R-hwRoot)*Math.sin(k/24*Math.PI/2)]);}
  let pts=[[-TAB,-tabHW],[0,-tabHW]];
  right.forEach(([u,h])=>pts.push([u,-h]));
  for(let k=1;k<24;k++){const a=-Math.PI/2+Math.PI*k/24; pts.push([c+R*Math.cos(a),R*Math.sin(a)]);}
  right.slice().reverse().forEach(([u,h])=>pts.push([u,h]));
  pts.push([0,tabHW],[-TAB,tabHW]);
  pts=pts.filter((q,i)=>i===0||Math.hypot(q[0]-pts[i-1][0],q[1]-pts[i-1][1])>1e-9);
  pts=dedupeCollinear(pts);
  return {pts,R,c,tabHW,tip:c+R};   // B5: tip (exposed length) can exceed billLen for short wide bills
}
function buildBill(p){
  const o=billOutline(p), shape=new THREE.Shape();
  o.pts.forEach(([u,v],i)=> i? shape.lineTo(u,v) : shape.moveTo(u,v));
  shape.closePath();
  const holeOK = p.tieU>=1.6 && p.tieU<=o.tip-2.2;
  if(holeOK){ // B11: explicit 24-gon (absarc leaves a near-duplicate closing point -> zero-area triangles)
    const h=new THREE.Path(); for(let k=0;k<24;k++){ const a=-2*Math.PI*k/24, x=p.tieU+1.1*Math.cos(a), y=1.1*Math.sin(a); k?h.lineTo(x,y):h.moveTo(x,y); } h.closePath(); shape.holes.push(h); }
  const g=new THREE.ExtrudeGeometry(shape,{depth:p.billT,bevelEnabled:false,curveSegments:24,steps:1});
  g.translate(0,0,-p.billT/2);
  const B=billBasis(p); g.applyMatrix4(B.M); g.computeVertexNormals();
  const pa=g.attributes.position.array; let tris=new Float32Array(pa.length);
  if(g.index){const ix=g.index.array; tris=new Float32Array(ix.length*3); for(let k=0;k<ix.length;k++){tris[k*3]=pa[ix[k]*3];tris[k*3+1]=pa[ix[k]*3+1];tris[k*3+2]=pa[ix[k]*3+2];}}
  else tris.set(pa);
  if(massProps(tris).V<0) flipTris(tris);
  return {geo:g,tris,outline:o,holeOK,B};
}

function trisFromIndexed(pos,idx){const t=new Float32Array(idx.length*3);for(let k=0;k<idx.length;k++){t[k*3]=pos[idx[k]*3];t[k*3+1]=pos[idx[k]*3+1];t[k*3+2]=pos[idx[k]*3+2];}return t}
function flipTris(t){for(let k=0;k<t.length;k+=9)for(let a=0;a<3;a++){const x=t[k+3+a];t[k+3+a]=t[k+6+a];t[k+6+a]=x;}}
function massProps(t){
  let V=0,cx=0,cy=0,cz=0,A=0;
  for(let k=0;k<t.length;k+=9){
    const ax=t[k],ay=t[k+1],az=t[k+2],bx=t[k+3],by=t[k+4],bz=t[k+5],qx=t[k+6],qy=t[k+7],qz=t[k+8];
    const v=(ax*(by*qz-bz*qy)-ay*(bx*qz-bz*qx)+az*(bx*qy-by*qx))/6;
    V+=v; cx+=v*(ax+bx+qx)/4; cy+=v*(ay+by+qy)/4; cz+=v*(az+bz+qz)/4;
    const ux=bx-ax,uy=by-ay,uz=bz-az,wx=qx-ax,wy=qy-ay,wz=qz-az;
    A+=0.5*Math.hypot(uy*wz-uz*wy,uz*wx-ux*wz,ux*wy-uy*wx);
  }
  return {V,A,C:[cx/V,cy/V,cz/V]};
}

/* ============================== production geometry (pure) ==============================
   Two-half mold model built analytically from the lofted superellipse grid (no CSG):
   - canonical half = material on y<=0 (lure's LEFT, body_L); body_R is its mirror (+Y)
   - outer skin = grid columns j=16..48 of the 64-column body loft (y forced to 0 on j=16/48)
   - cavity = inner loft (top-wall-flange, bot-wall-flange, halfW-wall) between solid nose / tail plugs
   - parting face (y=0) = earcut of profile outline with holes (cavity opening, pins / holes)
   - bill slot = through-pocket of depth tabHW+0.1: skin triangles are clipped in the XZ plane
     (the half is a height field y=-Y(x,z)), with exact vertical walls and a floor at y=-d   */
const NSB=110, NAB=64;
function stationTs(){ const ts=[]; for(let i=0;i<NSB;i++) ts.push((1-Math.cos(Math.PI*i/(NSB-1)))/2); return ts; }
function halfRingYZ(rad,se,c){ // c=0..32 -> loft column j=16+c (y<=0), returns [y,z]
  const j=16+c, a=2*Math.PI*j/NAB, co=Math.cos(a), s=Math.sin(a);
  let y=rad[2]*sgnpow(co,2/se), z=(s>=0?rad[0]:rad[1])*sgnpow(s,2/se);
  if(c===0||c===32) y=0; if(c===16) z=0; if(y>0) y=0; return [y,z];
}
function polyArea2(P){ let a=0; for(let i=0;i<P.length;i++){const p=P[i],q=P[(i+1)%P.length]; a+=p[0]*q[1]-q[0]*p[1];} return a/2; }
function ptSegDist(px,pz,a,b){ const ex=b[0]-a[0], ez=b[1]-a[1], l2=ex*ex+ez*ez||1; const t=clamp(((px-a[0])*ex+(pz-a[1])*ez)/l2,0,1); return Math.hypot(px-a[0]-ex*t,pz-a[1]-ez*t); }
function ptPolyDist(px,pz,P){ let m=Infinity, inside=true; for(let i=0;i<P.length;i++){ const a=P[i],b=P[(i+1)%P.length]; m=Math.min(m,ptSegDist(px,pz,a,b)); if((b[0]-a[0])*(pz-a[1])-(b[1]-a[1])*(px-a[0])<0) inside=false; } return inside?-m:m; } // convex CCW

/* bill slot footprint on the parting plane (XZ) */
function billSlot(p,tabHW){
  const th=p.billAng*Math.PI/180, dx=-Math.cos(th), dz=-Math.sin(th), nx=-Math.sin(th), nz=Math.cos(th);
  const h=(p.billT+PROD.slotFitT)/2, u0=-TAB-PROD.slotEndClr;
  let uExit=0; for(let u=0;u<=60;u+=0.25){ uExit=u; if(bodyHalfWidthAt(p,p.rootX+dx*u,p.rootZ+dz*u)<=0) break; }
  const u1=uExit+3, P=(u,w)=>[p.rootX+dx*u+nx*w,p.rootZ+dz*u+nz*w];
  let rect=[P(u0,-h),P(u1,-h),P(u1,h),P(u0,h)]; if(polyArea2(rect)<0) rect.reverse();
  const rearPts=[P(u0,-h),P(u0,h)];
  return {rect,d:tabHW+PROD.slotSideClr,h,u0,u1,uExit,rearX:Math.max(rearPts[0][0],rearPts[1][0]),rearPts,width:2*h,depth:tabHW+PROD.slotSideClr,len:TAB+PROD.slotEndClr};
}
/* longest run of stations where an inner loft fits (radii > wall+0.3) inside [xFront,xBack] */
function cavityRange(p,wall,flange,xFront,xBack){
  const ts=stationTs(), R=NSB-2; let best=null, cur=null;
  const inner=r=>{const q=radii(ts[r+1],p); return [q[0]-wall-flange,q[1]-wall-flange,q[2]-wall];};
  for(let r=0;r<R;r++){ const x=ts[r+1]*p.L, q=inner(r), ok=x>=xFront&&x<=xBack&&q[0]>=0.3&&q[1]>=0.3&&q[2]>=0.3;
    if(ok){ if(!cur) cur={r0:r,r1:r}; else cur.r1=r; } else if(cur){ if(!best||cur.r1-cur.r0>best.r1-best.r0) best=cur; cur=null; } }
  if(cur&&(!best||cur.r1-cur.r0>best.r1-best.r0)) best=cur;
  if(!best||best.r1-best.r0<2) return null;
  best.x0=ts[best.r0+1]*p.L; best.x1=ts[best.r1+1]*p.L; best.inner=inner; best.wall=wall; best.flange=flange;
  return best;
}
/* closed inner loft (full rings) -> volume / centroid; used for printed-shell mass and the cavity */
function innerLoftProps(p,cav){
  if(!cav) return {V:0,C:[p.L/2,0,0],A:0};
  const ts=stationTs(), pos=[], idx=[], NA=NAB;
  for(let r=cav.r0;r<=cav.r1;r++){ const q=cav.inner(r), x=ts[r+1]*p.L;
    for(let j=0;j<NA;j++){ const a=2*Math.PI*j/NA, c=Math.cos(a), s=Math.sin(a); pos.push(x,q[2]*sgnpow(c,2/p.se),(s>=0?q[0]:q[1])*sgnpow(s,2/p.se)); } }
  const nR=cav.r1-cav.r0+1;
  for(let i=0;i<nR-1;i++) for(let j=0;j<NA;j++){ const a0=i*NA+j,a1=i*NA+(j+1)%NA,b0=a0+NA,b1=a1+NA; idx.push(a0,b0,a1,a1,b0,b1); }
  const c0=pos.length/3; pos.push(cav.x0,0,0); const c1=c0+1; pos.push(cav.x1,0,0);
  for(let j=0;j<NA;j++){ idx.push(c0,j,(j+1)%NA); const o=(nR-1)*NA; idx.push(c1,o+(j+1)%NA,o+j); }
  const t=trisFromIndexed(pos,idx); const m=massProps(t); if(m.V<0){ flipTris(t); return massProps(t); } return m;
}

/* Mesh builder with a keyed vertex registry; every triangle is oriented against a desired outward direction. */
function meshBuilder(){
  const pos=[], idx=[], keys=new Map(), groups={};
  const v=(key,x,y,z)=>{ let i=keys.get(key); if(i===undefined){ i=pos.length/3; pos.push(x,y,z); keys.set(key,i); } return i; };
  const tri=(a,b,c,dir,grp)=>{
    if(a===b||b===c||a===c) return;
    const ax=pos[a*3],ay=pos[a*3+1],az=pos[a*3+2], ux=pos[b*3]-ax,uy=pos[b*3+1]-ay,uz=pos[b*3+2]-az, wx=pos[c*3]-ax,wy=pos[c*3+1]-ay,wz=pos[c*3+2]-az;
    const nx=uy*wz-uz*wy, ny=uz*wx-ux*wz, nz=ux*wy-uy*wx;
    if(nx*dir[0]+ny*dir[1]+nz*dir[2]<0) idx.push(a,c,b); else idx.push(a,b,c);
    if(grp){ (groups[grp]=groups[grp]||[]).push(idx.length/3-1); }
  };
  return {pos,idx,groups,v,tri};
}
function meshTris(m,skipGroup){ const skip=new Set(skipGroup?(m.groups[skipGroup]||[]):[]); const out=[];
  for(let t=0;t<m.idx.length/3;t++){ if(skip.has(t)) continue; for(let k=0;k<3;k++){ const i=m.idx[t*3+k]; out.push(m.pos[i*3],m.pos[i*3+1],m.pos[i*3+2]); } }
  return new Float32Array(out); }
/* edge-manifold check: every undirected edge must be used by exactly 2 triangles, once in each direction */
function meshCheck(pos,idx){
  const E=new Map(); let bad=0, dirBad=0, degenerate=0;
  for(let t=0;t<idx.length;t+=3){ for(let k=0;k<3;k++){ const a=idx[t+k], b=idx[t+(k+1)%3]; const key=a<b?a*1e7+b:b*1e7+a; const e=E.get(key)||[0,0]; e[a<b?0:1]++; E.set(key,e); } }
  E.forEach(e=>{ if(e[0]+e[1]!==2) bad++; else if(e[0]!==1) dirBad++; });
  return {edges:E.size,nonManifold:bad,flipped:dirBad,watertight:bad===0&&dirBad===0};
}

/* canonical half (material y<=0). cfg: {slot|null, cav|null, feats:[{kind:'boss'|'pocket',cx,cz,r,depth,draftDeg}]} */
function buildHalfCanonical(p,cfg){
  const ts=stationTs(), R=NSB-2, M=meshBuilder(), BND=16, CON=32;
  let nid=0; const mk=(x,z,Y,tags,pe)=>({id:nid++,x,z,Y,tags,pe:pe||null});
  const info={slotOK:!!cfg.slot,slotMsg:''};
  const G=[]; for(let r=0;r<R;r++){ const t=ts[r+1], rad=radii(t,p), x=t*p.L, row=[];
    for(let c=0;c<=32;c++){ const [y,z]=halfRingYZ(rad,p.se,c); row.push(mk(x,z,-y,(c===0||c===32)?BND:0)); } G.push(row); }
  const nose=mk(0,0,0,BND), tail=mk(p.L,0,0,BND);
  [nose,tail].concat(...G).forEach(v=>v.grid=true);
  // parent grid edge of a segment (both ends on the same original grid edge) or null
  const segEdge=(a,b)=>{ if(a.grid&&b.grid) return {a:a.id<b.id?a:b,b:a.id<b.id?b:a,key:Math.min(a.id,b.id)+'_'+Math.max(a.id,b.id)};
    if(a.grid&&b.pe&&(b.pe.a===a||b.pe.b===a)) return b.pe; if(b.grid&&a.pe&&(a.pe.a===b||a.pe.b===b)) return a.pe;
    if(a.pe&&b.pe&&a.pe.key===b.pe.key) return a.pe; return null; };
  const tris=[];
  for(let c=0;c<32;c++) tris.push([nose,G[0][c+1],G[0][c]]);
  for(let r=0;r<R-1;r++) for(let c=0;c<32;c++){ const A=G[r][c],B=G[r][c+1],C=G[r+1][c],D=G[r+1][c+1]; tris.push([A,B,C],[B,D,C]); }
  for(let c=0;c<32;c++) tris.push([G[R-1][c],G[R-1][c+1],tail]);
  let boundary=[nose]; for(let r=0;r<R;r++) boundary.push(G[r][32]); boundary.push(tail); for(let r=R-1;r>=0;r--) boundary.push(G[r][0]);

  // ---- 3D lifts. class '0': y=0, 'd': y=-d (slot floor / contour), 'Y': y=-Y (skin)
  let d=0;
  const lift=(v,cls)=>{ if(cls==='Y'){ if(v.Y===0) cls='0'; else if(v.tags&CON) cls='d'; }
    const y=cls==='0'?0:cls==='d'?-d:-v.Y; return M.v(v.id+cls,v.x,y,v.z); };
  const skinPolys=[], floorPolys=[]; let notch=null, tfix=null;

  if(cfg.slot){
    const S=cfg.slot; d=S.d; let rect=S.rect.map(q=>q.slice());
    // keep grid vertices off the slot edge lines (perturb outward by a micron if needed)
    const near=()=>{ for(const T of tris) for(const v of T) for(let k=0;k<4;k++){ const a=rect[k],b=rect[(k+1)%4], ex=b[0]-a[0], ez=b[1]-a[1], l=Math.hypot(ex,ez); if(Math.abs((ex*(v.z-a[1])-ez*(v.x-a[0]))/l)<1e-7) return true; } return false; };
    for(let it=0;it<5&&near();it++){ const cx=(rect[0][0]+rect[2][0])/2, cz=(rect[0][1]+rect[2][1])/2; rect=rect.map(q=>[q[0]+(q[0]-cx)*1e-6+1.3e-6,q[1]+(q[1]-cz)*1e-6+0.7e-6]); }
    const lines=rect.map((a,k)=>{const b=rect[(k+1)%4], ex=b[0]-a[0], ez=b[1]-a[1], l=Math.hypot(ex,ez); return {ax:a[0],az:a[1],ex:ex/l,ez:ez/l,len:l};});
    const sd=(v,k)=>{const l=lines[k]; return l.ex*(v.z-l.az)-l.ez*(v.x-l.ax);};   // >0 inside
    const sl=(v,k)=>{const l=lines[k]; return (v.x-l.ax)*l.ex+(v.z-l.az)*l.ez;};
    const XC=new Map();
    const X=(a,b,k)=>{ const key=(a.id<b.id?a.id+'_'+b.id:b.id+'_'+a.id)+'_'+k; let v=XC.get(key); if(v) return v;
      const [u,w]=a.id<b.id?[a,b]:[b,a], du=sd(u,k), dw=sd(w,k), t=du/(du-dw), x=u.x+(w.x-u.x)*t, z=u.z+(w.z-u.z)*t;
      let Y=0; if(!(u.tags&w.tags&BND)){ Y=bodyHalfWidthAt(p,x,z); if(!(Y>0)) Y=Math.max(u.Y+(w.Y-u.Y)*t,1e-6); } // chord can leave a concave outline
      v=mk(x,z,Y,(u.tags&w.tags&~CON)|(1<<k),segEdge(u,w)); XC.set(key,v); return v; };
    const Xc=(a,b)=>{ const key=(a.id<b.id?a.id+'_'+b.id:b.id+'_'+a.id)+'_c'; let v=XC.get(key); if(v) return v;
      const [u,w]=a.id<b.id?[a,b]:[b,a], fu=u.Y-d, fw=w.Y-d, t=fu/(fu-fw);
      v=mk(u.x+(w.x-u.x)*t,u.z+(w.z-u.z)*t,d,(u.tags&w.tags)|CON,segEdge(u,w)); XC.set(key,v); return v; };
    const clip=(poly,k,s)=>{ const out=[], n=poly.length; for(let i=0;i<n;i++){ const a=poly[i], b=poly[(i+1)%n], da=s*sd(a,k), db=s*sd(b,k);
      if(da>0){ out.push(a); if(db<0) out.push(X(a,b,k)); } else if(db>0) out.push(X(a,b,k)); } return out; };
    const clipF=poly=>{ const out=[], n=poly.length; for(let i=0;i<n;i++){ const a=poly[i], b=poly[(i+1)%n], fa=a.Y-d, fb=b.Y-d;
      if(fa>=0){ out.push(a); if(fb<0&&fa>0) out.push(Xc(a,b)); } else if(fb>0) out.push(Xc(a,b)); } return out; };
    const xs=rect.map(q=>q[0]), zs=rect.map(q=>q[1]), bb=[Math.min(...xs),Math.max(...xs),Math.min(...zs),Math.max(...zs)];
    for(const T of tris){
      if(Math.max(T[0].x,T[1].x,T[2].x)<bb[0]||Math.min(T[0].x,T[1].x,T[2].x)>bb[1]||Math.max(T[0].z,T[1].z,T[2].z)<bb[2]||Math.min(T[0].z,T[1].z,T[2].z)>bb[3]){ skinPolys.push(T); continue; }
      let out=false; for(let k=0;k<4&&!out;k++) if(T.every(v=>sd(v,k)<0)) out=true;
      if(out){ skinPolys.push(T); continue; }
      let rest=T;
      for(let k=0;k<4&&rest.length>=3;k++){ const o=clip(rest,k,-1); if(o.length>=3) skinPolys.push(o); rest=clip(rest,k,1); }
      if(rest.length>=3){ const kept=clipF(rest); if(kept.length>=3){ skinPolys.push(kept); floorPolys.push(kept); } }
    }
    // collect vertices on each slot line, then remove T-junctions along those lines
    const all=new Map(); [skinPolys,floorPolys].forEach(L=>L.forEach(P=>P.forEach(v=>all.set(v.id,v))));
    const lineV=[0,1,2,3].map(k=>[...all.values()].filter(v=>v.tags&(1<<k)).sort((a,b)=>sl(a,k)-sl(b,k)));
    const edgeV=new Map(); all.forEach(v=>{ if(v.pe){ (edgeV.get(v.pe.key)||edgeV.set(v.pe.key,[]).get(v.pe.key)).push(v); } });
    const ep=(E,v)=>{ const ex=E.b.x-E.a.x, ez=E.b.z-E.a.z; return ((v.x-E.a.x)*ex+(v.z-E.a.z)*ez)/(ex*ex+ez*ez); };
    tfix=(P,noLines)=>{ const out=[]; for(let i=0;i<P.length;i++){ const a=P[i], b=P[(i+1)%P.length]; out.push(a); const com=a.tags&b.tags&15;
      const E=segEdge(a,b);
      if(E&&edgeV.has(E.key)){ const ta=ep(E,a), tb=ep(E,b), lo=Math.min(ta,tb), hi=Math.max(ta,tb);
        const mid=edgeV.get(E.key).filter(v=>v!==a&&v!==b&&ep(E,v)>lo+1e-12&&ep(E,v)<hi-1e-12).sort((u,w)=>ep(E,u)-ep(E,w)); if(ta>tb) mid.reverse(); out.push(...mid); }
      else if(!noLines) for(let k=0;k<4;k++) if(com&(1<<k)){ const sa=sl(a,k), sb=sl(b,k), lo=Math.min(sa,sb), hi=Math.max(sa,sb);
        const mid=lineV[k].filter(v=>v!==a&&v!==b&&sl(v,k)>lo+1e-9&&sl(v,k)<hi-1e-9); if(sa>sb) mid.reverse(); out.push(...mid); } } return out; };
    for(let i=0;i<skinPolys.length;i++) skinPolys[i]=tfix(skinPolys[i]);
    for(let i=0;i<floorPolys.length;i++) floorPolys[i]=tfix(floorPolys[i]);
    // notch in the parting-face outline: boundary minus slot, walking the slot clockwise
    const inRect=v=>[0,1,2,3].every(k=>sd(v,k)>0);
    const segIn=(a,b)=>{ let A=a,B=b; for(let k=0;k<4;k++){ const da=sd(A,k), db=sd(B,k); if(da<=0&&db<=0) return null;
        if(da<0){ A=X(A,B,k); } else if(db<0){ B=X(A,B,k); } } return [A,B]; };
    const nb=[], ev=[]; const n=boundary.length;
    for(let i=0;i<n;i++){ const a=boundary[i], b=boundary[(i+1)%n]; if(!inRect(a)) nb.push(a);
      const s=segIn(a,b); if(s){ if(s[0]!==a){ nb.push(s[0]); ev.push(['in',nb.length-1,s[0]]); } if(s[1]!==b){ nb.push(s[1]); ev.push(['out',nb.length-1,s[1]]); } } }
    const ins=ev.filter(e=>e[0]==='in'), outs=ev.filter(e=>e[0]==='out');
    if(cfg.debug) info.dbgB={boundary:boundary.map(v=>({id:v.id,x:v.x,z:v.z,inR:inRect(v),sd:[0,1,2,3].map(k=>sd(v,k))})),ev:ev.map(e=>[e[0],e[2].id,e[2].x,e[2].z,e[2].tags])};
    const corner=m=>[...all.values()].find(v=>(v.tags&(1<<m))&&(v.tags&(1<<((m+3)%4))));
    let ok=ins.length===1&&outs.length===1;
    if(ok){
      const P1=ins[0][2], P2=outs[0][2], k1=[0,1,2,3].find(k=>P1.tags&(1<<k)), k2=[0,1,2,3].find(k=>P2.tags&(1<<k));
      const path=[P1]; let m=k1; const sameBack=k1===k2&&sl(P2,k1)<sl(P1,k1);
      if(!sameBack){ for(let g=0;g<5;g++){ const cv=corner(m); if(!cv){ ok=false; break; } path.push(cv); m=(m+3)%4; if(m===k2) break; } }
      path.push(P2);
      if(ok){ const at=ins[0][1]; nb.splice(at+1,0,...path.slice(1,-1)); notch={path,lines,lineV,sl}; boundary=nb; }
    }
    if(!ok){ info.slotOK=false; info.slotMsg='bill slot does not cross the body outline exactly once (root too far outside or inside the body)'; skinPolys.length=0; floorPolys.length=0; notch=null; d=0; tfix=null;
      for(const T of tris) skinPolys.push(T); boundary=[nose]; for(let r=0;r<R;r++) boundary.push(G[r][32]); boundary.push(tail); for(let r=R-1;r>=0;r--) boundary.push(G[r][0]); }
  } else for(const T of tris) skinPolys.push(T);

  // ---- emit skin + slot floor (convex pieces; >3 vertices -> centroid fan, no zero-area triangles)
  let cid=0;
  const emitPoly=(P,cls,dir,grp)=>{
    if(P.length===3){ M.tri(lift(P[0],cls),lift(P[1],cls),lift(P[2],cls),dir,grp); return; }
    let cx=0,cz=0; P.forEach(v=>{cx+=v.x;cz+=v.z}); cx/=P.length; cz/=P.length;
    let yc=cls==='d'?-d:-bodyHalfWidthAt(p,cx,cz); if(cls!=='d'&&!(yc<0)) yc=-P.reduce((s,v)=>s+v.Y,0)/P.length;
    const ci=M.v('c'+(cid++),cx,yc,cz);
    for(let i=0;i<P.length;i++) M.tri(ci,lift(P[i],cls),lift(P[(i+1)%P.length],cls),dir,grp);
  };
  if(cfg.debug) info.dbg={skinPolys,floorPolys};
  skinPolys.forEach(P=>emitPoly(P,'Y',[0,-1,0],'skin'));
  floorPolys.forEach(P=>emitPoly(P,'d',[0,1,0],'slot'));
  // slot walls: vertical faces along the notch path, bottom follows floor (Y>=d) or skin (Y<d)
  if(notch){
    for(let i=0;i<notch.path.length-1;i++){
      const Q0=notch.path[i], Q1=notch.path[i+1], k=[0,1,2,3].find(k=>(Q0.tags&Q1.tags)&(1<<k)); if(k===undefined) continue;
      const s0=notch.sl(Q0,k), s1=notch.sl(Q1,k), lo=Math.min(s0,s1), hi=Math.max(s0,s1);
      const mids=notch.lineV[k].filter(v=>v!==Q0&&v!==Q1&&notch.sl(v,k)>lo+1e-9&&notch.sl(v,k)<hi-1e-9); if(s0<s1) mids.reverse();
      const bot=v=>(v.tags&CON)||v.Y>=d?['d',-d]:v.Y===0?['0',0]:['Y',-v.Y];
      const ring=[[Q0,'0',0],[Q1,'0',0]]; const b1=bot(Q1); if(b1[0]!=='0') ring.push([Q1,...b1]);
      mids.forEach(v=>ring.push([v,...bot(v)])); const b0=bot(Q0); if(b0[0]!=='0') ring.push([Q0,...b0]);
      const pts2=ring.map(([v,,y])=>new THREE.Vector2(notch.sl(v,k),y)), ids=ring.map(([v,c])=>lift(v,c));
      const L=notch.lines[k], dir=[-L.ez,0,L.ex];
      THREE.ShapeUtils.triangulateShape(pts2,[]).forEach(f=>M.tri(ids[f[0]],ids[f[1]],ids[f[2]],dir,'slot'));
    }
  }
  // ---- cavity (inner loft) with solid nose / tail plugs
  const cav=cfg.cav; let holeCav=null;
  if(cav){
    const IV=r=>{ const q=cav.inner(r), x=ts[r+1]*p.L; return Array.from({length:33},(_,c)=>{const [y,z]=halfRingYZ(q,p.se,c); return M.v('i'+r+'_'+c,x,y,z);}); };
    const rows=[]; for(let r=cav.r0;r<=cav.r1;r++) rows.push(IV(r));
    for(let i=0;i<rows.length-1;i++) for(let c=0;c<32;c++){ const A=rows[i][c],B=rows[i][c+1],C=rows[i+1][c],D=rows[i+1][c+1]; M.tri(A,B,C,[0,1,0],'cavity'); M.tri(B,D,C,[0,1,0],'cavity'); }
    const f=rows[0], l=rows[rows.length-1];
    for(let c=1;c<32;c++){ M.tri(f[0],f[c],f[c+1],[1,0,0],'cavity'); M.tri(l[0],l[c],l[c+1],[-1,0,0],'cavity'); }
    holeCav=[]; rows.forEach(rw=>holeCav.push(rw[0])); for(let i=rows.length-1;i>=0;i--) holeCav.push(rows[i][32]);
  }
  // ---- internal features (alignment pins = bosses on L, holes = pockets on R)
  const featHoles=[];
  (cfg.feats||[]).forEach((F,fi)=>{
    const N=20, sg=F.kind==='boss'?1:-1, r2=Math.max(0.2,F.r-F.depth*Math.tan((F.draftDeg||0)*Math.PI/180)), yb=sg*F.depth;
    const top=[], bot=[];
    for(let k=0;k<N;k++){ const a=2*Math.PI*k/N, c=Math.cos(a), s=Math.sin(a);
      top.push(M.v(`f${fi}t${k}`,F.cx+F.r*c,0,F.cz+F.r*s)); bot.push(M.v(`f${fi}b${k}`,F.cx+r2*c,yb,F.cz+r2*s)); }
    for(let k=0;k<N;k++){ const k2=(k+1)%N, a=2*Math.PI*(k+0.5)/N, dir=[sg*Math.cos(a),0,sg*Math.sin(a)];
      M.tri(top[k],top[k2],bot[k2],dir,'feat'); M.tri(top[k],bot[k2],bot[k],dir,'feat'); }
    for(let k=1;k<N-1;k++) M.tri(bot[0],bot[k],bot[k+1],[0,1,0],'feat');
    featHoles.push(top.map(i=>[M.pos[i*3],M.pos[i*3+2],i]));
  });
  // ---- parting face y=0: outline (with slot notch) minus cavity opening minus feature footprints
  if(tfix) boundary=tfix(boundary,true);
  const contour=boundary.map(v=>[v.x,v.z,lift(v,'0')]);
  const holes=[]; if(holeCav) holes.push(holeCav.map(i=>[M.pos[i*3],M.pos[i*3+2],i])); featHoles.forEach(h=>holes.push(h));
  const all2=contour.concat(...holes);
  const faces=THREE.ShapeUtils.triangulateShape(contour.map(q=>new THREE.Vector2(q[0],q[1])),holes.map(h=>h.map(q=>new THREE.Vector2(q[0],q[1]))));
  let pa=0; faces.forEach(f=>{ const a=all2[f[0]],b=all2[f[1]],c=all2[f[2]]; pa+=Math.abs((b[0]-a[0])*(c[1]-a[1])-(b[1]-a[1])*(c[0]-a[0]))/2; M.tri(a[2],b[2],c[2],[0,1,0],'parting'); });
  const expA=Math.abs(polyArea2(contour))-holes.reduce((s,h)=>s+Math.abs(polyArea2(h)),0);
  info.partingArea=pa; info.partingAreaErr=Math.abs(pa-expA);
  info.notchPath=notch?notch.path.map(v=>[v.x,v.z]):null;
  return {pos:M.pos,idx:M.idx,groups:M.groups,info};
}
function mirrorMesh(m){ const pos=m.pos.slice(); for(let i=1;i<pos.length;i+=3) pos[i]=-pos[i]||0; const idx=[]; for(let t=0;t<m.idx.length;t+=3) idx.push(m.idx[t],m.idx[t+2],m.idx[t+1]); return {pos,idx,groups:m.groups,info:m.info}; }
/* L half + R half (both without pins) welded along y=0 with the parting faces removed = one hollow shell */
function mergeShell(c){
  const skip=new Set(c.groups.parting||[]), n=c.pos.length/3, pos=c.pos.slice(), idx=[], map=[];
  for(let i=0;i<n;i++){ if(c.pos[i*3+1]===0) map[i]=i; else { map[i]=pos.length/3; pos.push(c.pos[i*3],-c.pos[i*3+1],c.pos[i*3+2]); } }
  for(let t=0;t<c.idx.length/3;t++){ if(skip.has(t)) continue; const a=c.idx[t*3],b=c.idx[t*3+1],cc=c.idx[t*3+2]; idx.push(a,b,cc); idx.push(map[a],map[cc],map[b]); }
  return {pos,idx,groups:{}};
}
function meshProps(m){ return massProps(trisFromIndexed(m.pos,m.idx)); }

/* pin sites in the solid nose / tail plugs; the plugs grow until a Ø2.1 hole with a 0.7 mm floor fits */
function pinSiteSearch(p,slot,cav,which){
  const rH=PROD.holeD/2, need=PROD.pinH+PROD.holeExtra+PROD.minFloor, ringR=[rH,rH+PROD.pinMargin];
  const ok=(cx,cz)=>{ if(bodyHalfWidthAt(p,cx,cz)<need) return false;
    for(const rr of ringR) for(let k=0;k<12;k++){ const a=Math.PI*k/6; if(bodyHalfWidthAt(p,cx+rr*Math.cos(a),cz+rr*Math.sin(a))<need) return false; }
    if(slot&&ptPolyDist(cx,cz,slot.rect)<rH+0.8) return false;
    if(which==='nose'&&cx+rH+0.8>cav.x0) return false;
    if(which==='tail'&&(cx-rH-0.8<cav.x1||cx+rH+1.5>p.L-Math.max(p.tailX,0.5))) return false;
    return true; };
  const x0=which==='nose'?0.5:cav.x1, x1=which==='nose'?cav.x0:p.L, score=(x,z)=>bodyHalfWidthAt(p,x,z)-0.05*Math.abs(z);
  const cand=[];   // coarse 1 mm grid ranked by section thickness, then the first feasible one refined on 0.25 mm
  for(let x=x0;x<=x1;x+=1){ const [a,b]=radii(clamp(x/p.L,0,1),p); for(let z=-b;z<=a;z+=1){ const sc=score(x,z); if(sc>=need) cand.push({x,z,sc}); } }
  cand.sort((u,w)=>w.sc-u.sc);
  for(const c of cand){ if(!ok(c.x,c.z)) continue; let best=c;
    for(let dx=-0.75;dx<=0.75;dx+=0.25) for(let dz=-0.75;dz<=0.75;dz+=0.25){ const x=c.x+dx, z=c.z+dz, sc=score(x,z); if(sc>best.sc&&ok(x,z)) best={x,z,sc}; }
    return best; }
  return null;
}
/* full production model for the current parameters. full=false -> canonical (no pins) only, enough for mass */
const PROD_GEOM_KEYS=['L','top','bot','halfW','fat','taper','se','tailR','billLen','billW','billAng','billT','rootX','rootZ','tailX','wallMm','flangeMm','draftDeg','pins'];
const _pgCache=new Map();
function productionGeometry(p,full){
  const key=PROD_GEOM_KEYS.map(k=>p[k]).join('|')+(full?'|F':'');
  if(_pgCache.has(key)) return _pgCache.get(key);
  const r=productionGeometryRaw(p,full); if(_pgCache.size>12) _pgCache.clear(); _pgCache.set(key,r); return r;
}
function productionGeometryRaw(p,full){
  const wall=p.wallMm, flange=p.flangeMm, o=billOutline(p);
  let slot=billSlot(p,o.tabHW); if(slot.uExit<=0&&bodyHalfWidthAt(p,p.rootX,p.rootZ)<=0&&!(bodyHalfWidthAt(p,(slot.rearPts[0][0]+slot.rearPts[1][0])/2,(slot.rearPts[0][1]+slot.rearPts[1][1])/2)>0)) slot=null;
  let xFront=slot?slot.rearX+wall+0.6:0, xBack=p.L-Math.max(p.tailX,0.5)-4;
  let cav=cavityRange(p,wall,flange,xFront,xBack), pins=[];
  if(cav&&p.pins==='on'){
    let a=null; for(let g=0;g<10&&cav&&!(a=pinSiteSearch(p,slot,cav,'nose'));g++){ xFront+=1; cav=cavityRange(p,wall,flange,xFront,xBack); }
    let b=null; for(let g=0;g<14&&cav&&!(b=pinSiteSearch(p,slot,cav,'tail'));g++){ xBack-=1; cav=cavityRange(p,wall,flange,xFront,xBack); }
    if(cav){ a=pinSiteSearch(p,slot,cav,'nose'); b=pinSiteSearch(p,slot,cav,'tail'); }
    [a,b].forEach(s=>{ if(s) pins.push({x:s.x,z:s.z}); });
  }
  const canon=buildHalfCanonical(p,{slot,cav,feats:[]});
  const cp=meshProps(canon);
  const out={slot,cav,pins,canon,wall,flange,tabHW:o.tabHW,
    Vshell:2*cp.V, Cshell:[cp.C[0],0,cp.C[2]], Ashell:2*cp.A, check:meshCheck(canon.pos,canon.idx), info:canon.info};
  if(full){
    const boss=pins.map(q=>({kind:'boss',cx:q.x,cz:q.z,r:PROD.pinD/2,depth:PROD.pinH,draftDeg:p.draftDeg}));
    const hole=pins.map(q=>({kind:'pocket',cx:q.x,cz:q.z,r:PROD.holeD/2,depth:PROD.pinH+PROD.holeExtra,draftDeg:p.draftDeg}));
    out.L=pins.length?buildHalfCanonical(p,{slot,cav,feats:boss}):canon;
    out.R=mirrorMesh(pins.length?buildHalfCanonical(p,{slot,cav,feats:hole}):canon);
    out.shell=mergeShell(canon);
    out.checkL=meshCheck(out.L.pos,out.L.idx); out.checkR=meshCheck(out.R.pos,out.R.idx); out.checkShell=meshCheck(out.shell.pos,out.shell.idx);
    out.VL=meshProps(out.L).V; out.VR=meshProps(out.R).V; out.VshellMesh=meshProps(out.shell).V;
  }
  return out;
}

/* ============================== physics ============================== */
/* ---------- hardware library (generic codes, no brand part numbers) ---------- */
const HOOK_COST={'6':0.05,'4':0.06,'2':0.08,'1':0.09,'1/0':0.11,'2/0':0.14}, STR_COST={std:1,x2:1.15,x3:1.3,x4:1.5};
const RING_COST={'3':0.010,'4':0.012,'5':0.015,'6':0.02};
function hookCapKg(p,size){ const h=HOOKS[size]; if(!h) return 0; return {std:2.5,x2:4,x3:6,x4:9}[p.hookStr]*Math.sqrt(h.l/25)*(p.hookType==='single'?1.3:1); }
function ringCapKg(ring){ return {'3':4,'4':6,'5':10,'6':14}[ring]||8; }
function wireRatedKg(g){ return 0.5*620*Math.PI*g*g/4/9.81; }   // SS304 ~620 MPa, 50 % for twisted eyes
function harnessPath(p,B,bellyZ){
  const a=B.root.clone().addScaledVector(B.d,-TAB+2);
  return [[a.x,0,a.z],[p.bellyX,0,bellyZ],[p.L-Math.max(p.tailX,0.5),0,0]];
}
/* every purchased / made part of one lure; overrides (BOM editor) replace any field */
function hardwareRows(p,ctx,ovr){
  ovr=ovr||{}; const rows=[]; const STRN={std:'STD',x2:'2X',x3:'3X',x4:'4X'};
  const add=r=>{ const o=ovr[r.role]||{}; rows.push(Object.assign(r,o,{role:r.role})); };
  const ring=RINGS[p.ring]||RINGS['5'];
  [['hookB','belly',p.hookB],['hookT','tail',p.hookT]].forEach(([role,where,size])=>{
    if(size==='none'||!HOOKS[size]) return; const h=HOOKS[size], single=p.hookType==='single';
    add({role,cat:'Hook',partNo:`${single?'SGL':'TRB'}-${size}-${STRN[p.hookStr]}-BN`,desc:`${single?'Inline single':'Treble'} hook, ${where}`,spec:`High-carbon steel, ${HSTR[p.hookStr].n.toLowerCase()}`,
      size:size.includes('/')?size:'#'+size,finish:'Black nickel',ratedKg:+hookCapKg(p,size).toFixed(1),mass_g:+(h.m*HSTR[p.hookStr].f*HTYPE[p.hookType].f).toFixed(3),
      supplier:'TBD (hook OEM)',unitCostUSD:+(HOOK_COST[size]*STR_COST[p.hookStr]*(single?0.8:1)).toFixed(3),qty:1,inLure:true,pos:where});
  });
  const nH=(p.hookB!=='none'?1:0)+(p.hookT!=='none'?1:0);
  if(nH) add({role:'ring',cat:'Split ring',partNo:`SPR-${p.ring}-SS-BN`,desc:'Split ring, hook hangers',spec:'Stainless spring steel, flat wire',size:ring.n,finish:'Black nickel',
    ratedKg:ringCapKg(p.ring),mass_g:ring.m,supplier:'TBD (ring OEM)',unitCostUSD:RING_COST[p.ring]||0.015,qty:nH,inLure:true});
  const tr=String(Math.max(3,(+p.ring)-1)), tring=RINGS[tr];
  add({role:'tieRing',cat:'Split ring',partNo:`SPR-${tr}-SS-BN`,desc:'Split ring, line tie',spec:'Stainless spring steel, flat wire',size:tring.n,finish:'Black nickel',
    ratedKg:ringCapKg(tr),mass_g:tring.m,supplier:'TBD (ring OEM)',unitCostUSD:RING_COST[tr],qty:1,inLure:true});
  const g=+p.wireGauge, path=ctx.harness; let len=0; for(let i=1;i<path.length;i++) len+=Math.hypot(path[i][0]-path[i-1][0],path[i][2]-path[i-1][2]);
  len+=3*(Math.PI*3+6);   // three Ø3 eyes + 6 mm twist each
  add({role:'wire',cat:'Wire',partNo:`WIR-SS304-${g.toFixed(1)}`,desc:'Through-wire harness (tab anchor → belly → tail)',spec:'SS304 spring-temper wire, 3 twisted eyes',
    size:`Ø${g.toFixed(1)} × ${Math.round(len)} mm`,finish:'Bright',ratedKg:+wireRatedKg(g).toFixed(1),mass_g:+(7.93e-3*Math.PI*g*g/4*len).toFixed(3),
    supplier:'TBD (wire former)',unitCostUSD:+(0.03+0.0004*len*g).toFixed(3),qty:1,inLure:true,lenMm:len});
  if(p.ballN>0){ const b=BALLAST[p.ballMat], m1=b.rho*(4/3)*Math.PI*Math.pow(p.ballD/2,3)/1000;
    add({role:'ballast',cat:'Ballast',partNo:`BAL-${p.ballMat.slice(0,2).toUpperCase()}-${p.ballD.toFixed(1)}`,desc:'Ballast ball',spec:b.n,size:`Ø${p.ballD} mm`,finish:p.ballMat==='steel'?'Zinc / bare':'Bare',
      ratedKg:0,mass_g:+m1.toFixed(3),supplier:'TBD',unitCostUSD:+(p.ballMat==='tungsten'?0.09*m1:p.ballMat==='steel'?0.004:0.01).toFixed(3),qty:p.ballN,inLure:true}); }
  add({role:'eyes',cat:'Eye',partNo:`EYE-3D-${ctx.eyeD.toFixed(1)}`,desc:'3D epoxy eye (pair = 2 pcs)',spec:'Holographic 3D eye, adhesive back',size:`Ø${ctx.eyeD.toFixed(1)} mm`,finish:'Gold / black pupil',
    ratedKg:0,mass_g:0.03,supplier:'TBD',unitCostUSD:0.012,qty:2,inLure:true});
  return rows;
}
const rowMass=r=>(+r.mass_g||0)*(+r.qty||0);

/* prod: geometry-derived body volumes (see bodyVolumes). ovr: BOM overrides. */
function analyse(p, body, bill, prod, ovr){
  const bm=massProps(body.tris), lm=massProps(bill.tris), o=bill.outline;
  const tabVol=TAB*2*o.tabHW*p.billT;
  const bmat=BILL_MATS[p.billMat], ball=BALLAST[p.ballMat], water=WATERS[p.water];
  let mat, mBody, cBody;
  if(p.prodMode==='inject'){ mat=INJ_MAT; mBody=mat.rho*prod.Vshell/1000; cBody=prod.Cshell; }
  else { mat=BODY_MATS[p.bodyMat];
    if(mat.wood){ mBody=mat.rho*bm.V/1000; cBody=bm.C; }
    else { // B4: exact printed shell = outer loft - inner loft (wall p.wall), infill inside
      const Vs=Math.max(bm.V-prod.Vin,1e-9), cS=[0,1,2].map(i=>(bm.V*bm.C[i]-prod.Vin*prod.Cin[i])/Vs);
      const mS=mat.rho*Vs/1000, mI=mat.rho*p.infill/100*prod.Vin/1000; mBody=mS+mI; cBody=[0,1,2].map(i=>(mS*cS[i]+mI*prod.Cin[i])/Math.max(mBody,1e-9)); } }
  const mCoat=1.1*bm.A*p.coat/1000;
  const mBill=bmat.rho*lm.V/1000;                       // B3: the tab is real material inside the body
  const bellyZ=-radii(clamp(p.bellyX/p.L,0,1),p)[1];
  const tailHX=p.L-Math.max(p.tailX,0.5), tailHZ=0;
  const B=bill.B, tie=B.root.clone().addScaledVector(B.d,p.tieU);
  const hB=hookInfo(p,p.hookB), hT=hookInfo(p,p.hookT);
  const hangCG=(h,x,z)=>h?[x,0,z-h.ringD-0.55*h.l]:[x,0,z];
  const te=0.12, [etop,,ew]=radii(te,p), ez=etop*0.28, eyeR=Math.max(1.4,etop*0.17);
  const pts={
    tie:[tie.x,0,tie.z], belly:[p.bellyX,0,bellyZ], tail:[tailHX,0,tailHZ],
    bellyHook:hangCG(hB,p.bellyX,bellyZ), tailHook:hangCG(hT,tailHX,tailHZ), ball:[p.ballX,0,p.ballZ], eye:[te*p.L,0,ez], root:[B.root.x,0,B.root.z]
  };
  const harness=harnessPath(p,B,bellyZ);
  const hw=hardwareRows(p,{harness,eyeD:Math.round(eyeR*4)/2},ovr);
  const row=r=>hw.find(q=>q.role===r);
  const ringRow=row('ring'), ringM=ringRow?+ringRow.mass_g:0, wireRow=row('wire'), tieRow=row('tieRing'), ballRow=row('ballast'), eyeRow=row('eyes');
  const hookM=r=>{ const q=row(r); return q?+q.mass_g*(+q.qty||1)+ringM:0; };
  let wl=0, wc=[0,0,0]; for(let i=1;i<harness.length;i++){ const a=harness[i-1], b=harness[i], l=Math.hypot(b[0]-a[0],b[2]-a[2]); wl+=l; for(let k=0;k<3;k++) wc[k]+=l*(a[k]+b[k])/2; }
  wc=wc.map(v=>v/Math.max(wl,1e-9));
  const mBall=ballRow?rowMass(ballRow):0;
  const parts=[
    {n:'Body ('+mat.n.replace(/ \(.*\)/,'')+(p.prodMode==='inject'?', hollow':'')+')',m:mBody,c:cBody},
    {n:'Paint + epoxy',m:mCoat,c:bm.C},
    {n:'Bill ('+bmat.n.replace(/ \(.*\)/,'')+', incl. tab)',m:mBill,c:lm.C},
    {n:`Ballast ${p.ballN}× ${p.ballD} mm ${ball.n.toLowerCase()}`,m:mBall,c:pts.ball},
    {n:hB?`Belly: ${hB.label} ${HSTR[p.hookStr].n.replace(' wire','')} + ring`:'Belly hook (none)',m:hB?hookM('hookB'):0,c:pts.bellyHook},
    {n:hT?`Tail: ${hT.label} ${HSTR[p.hookStr].n.replace(' wire','')} + ring`:'Tail hook (none)',m:hT?hookM('hookT'):0,c:pts.tailHook},
    {n:'Line-tie split ring',m:tieRow?rowMass(tieRow):0,c:pts.tie},
    {n:`Through-wire Ø${(+p.wireGauge).toFixed(1)} SS304 (${Math.round(wireRow.lenMm||0)} mm)`,m:rowMass(wireRow),c:wc},
    {n:'3D eyes ×2',m:eyeRow?rowMass(eyeRow):0,c:pts.eye}
  ];
  const M=parts.reduce((s,q)=>s+q.m,0);
  const CG=[0,1,2].map(i=>parts.reduce((s,q)=>s+q.m*q.c[i],0)/M);
  const Vbill=Math.max(lm.V-tabVol,0);
  const disp=[ {v:bm.V,c:bm.C},{v:Vbill,c:lm.C},{v:bm.A*p.coat,c:bm.C},           // B2: coat volume displaces water
    {v:(hB?hookM('hookB'):0)/7.85*1000,c:pts.bellyHook},{v:(hT?hookM('hookT'):0)/7.85*1000,c:pts.tailHook},{v:(tieRow?rowMass(tieRow):0)/7.85*1000,c:pts.tie} ];
  const Vd=disp.reduce((s,q)=>s+q.v,0);
  const CB=[0,1,2].map(i=>disp.reduce((s,q)=>s+q.v*q.c[i],0)/Vd);
  const net=Vd/1000*water.rho - M;
  // depth rule of thumb (B5: uses the real exposed bill length o.tip)
  const tip=o.tip;
  const aF = p.billAng<=35 ? 1 : Math.max(0,1-Math.pow((p.billAng-35)/45,1.5));
  const wF = clamp(Math.pow(p.billW/26,0.25),0.7,1.2);
  const sizeF = clamp(Math.pow(26.6/(bm.V/1000),0.08),0.85,1.15);
  const depthBase = 0.08*tip*aF*wF*sizeF*(net<0?1.05:1);
  const depth = depthBase*LINES[p.line].f;
  // B6: every ballast ball must be inside the body (0.6 mm skin)
  const r=p.ballD/2, ballX=i=>p.ballX+(i-(p.ballN-1)/2)*p.ballD*1.02;
  let ballInside=true;
  for(let i=0;i<p.ballN;i++){ const x=ballX(i); if(x-r<0.6||x+r>p.L-0.6){ballInside=false;break}
    for(const xx of [x-r*0.7,x,x+r*0.7]){ const [bt,bb,bw]=radii(clamp(xx/p.L,0,1),p), rr=xx===x?r:r*0.71;
      if(p.ballZ+rr>bt-0.6||p.ballZ-rr<-bb+0.6||seHalfWidth(bt,bb,bw,p.se,p.ballZ)<rr+0.6){ballInside=false;break} } if(!ballInside) break; }
  // hook point clearances (side view)
  const dist=(a,b)=>Math.hypot(a[0]-b[0],a[2]-b[2]);
  const hooks={belly:hB,tail:hT, tangle:null, lineFoul:null, small:null};
  if(hB&&hT){ const d=dist(pts.belly,pts.tail); hooks.hangerGap=d;
    hooks.tangle = d<hB.r ? 'e' : d<hB.r+0.35*hT.r ? 'w' : null; }
  if(hB){ const d=dist(pts.belly,pts.tie); hooks.tieGap=d; hooks.lineFoul = d<hB.r ? 'e' : d<hB.r+4 ? 'w' : null;
    hooks.small = hB.l < 0.55*(p.top+p.bot) ? 'w' : null; }
  // vertical speed on a pause (terminal velocity, plan-view drag)
  const planA=(0.75*p.L*2*p.halfW + tip*p.billW*Math.cos(B.th))*1e-6;
  const vPause=Math.sqrt(2*Math.abs(net)*9.81e-3/(1000*water.rho*1.2*planA))*Math.sign(net);
  return {bm,lm,Vbill,M,CG,CB,Vd,net,depth,depthBase,aF,parts,pts,water,ballInside,ballX,mat,bmat,hooks,vPause,hw,harness,tip,mBody,mBill,mCoat,eyeR,prod};
}
/* volumes the mass model needs, per build mode (pure) */
function bodyVolumes(p,body){
  if(p.prodMode==='inject'){ const g=productionGeometry(p,false); return {mode:'inject',Vshell:g.Vshell,Cshell:g.Cshell,geom:g}; }
  if(BODY_MATS[p.bodyMat].wood) return {mode:'wood'};
  const cav=cavityRange(p,p.wall,0,0,p.L), ip=innerLoftProps(p,cav); return {mode:'print',Vin:ip.V,Cin:ip.C,cav};
}
function buoyClass(net){ return net>0.3?'F':net<-0.3?'S':'SP'; }

/* ============================== swim & dive models ============================== */
function swimParams(p,A,v){
  const sp=v==null?p.speed:v, ratio=p.billW/(2*p.halfW), Lm=p.L/1000;
  const f=clamp(sp/(1.85*Lm)*Math.pow(ratio,-0.2),0.5,18);
  const ampF=smooth(0.12,0.5,sp)*(sp>1.6?clamp(1.6/sp,0.75,1):1);
  const yaw=clamp(4+14*(ratio-0.7),2,22)*ampF;
  const roll=clamp(4+10*(p.se-2)+6*smooth(0.25,0.4,(p.top+p.bot)/p.L),2,28)*ampF*(A.CB[2]-A.CG[2]<1?1.6:1);
  const pitch=A.aF<0.15?0:clamp(40-0.6*p.billAng,5,40);
  return {f,yaw,roll,pitch};
}
/* reel: line recovered per handle turn = gear ratio × spool circumference */
function linePerTurn(p){ return parseFloat(p.gear)*Math.PI*p.spoolD/1000; }   // metres
function lineSpeed(p){ return linePerTurn(p)*p.tps; }                          // m/s
function speedProfile(p){
  const v0=lineSpeed(p), tp=p.tps, ps=p.pauseS;
  switch(p.style){
    case 'stopgo': { const go=p.goTurns/tp, c=go+ps; return t=>(t%c)<go?[v0,'reeling']:[0,'pause']; }
    case 'burnkill': { const go=3/(1.8*tp), c=go+ps; return t=>(t%c)<go?[1.8*v0,'burn']:[0,'kill / pause']; }
    case 'rip': { const c=1.85+0.5*ps; return t=>{const u=t%c; return u<1.5?[0.6*v0,'slow reel']:u<1.85?[0.6*v0+1.5,'rod rip']:[0,'slack']}; }
    case 'pump': { const drop=Math.max(0.6,ps), c=1.0+drop; return t=>(t%c)<1.0?[1.1+0.2*v0,'rod sweep']:[0.1,'drop back']; }
    default: return ()=>[v0,'reeling'];
  }
}
function diveSim(p,A){
  const C=p.castDist, h=p.rodH, prof=speedProfile(p), dt=0.04;
  const base=A.aF<0.15?0.05:A.depth;
  const X=[],Z=[],V=[],Lb=[],E=[]; const labels=[];
  let x=C, z=0, t=0, maxZ=0, maxAt=C, inZone=0, contact=0, pv=0, events=0;
  while(x>0 && t<900){
    const [v,lab]=prof(t);
    let li=labels.indexOf(lab); if(li<0){labels.push(lab); li=labels.length-1}
    const sF=clamp(0.72+0.3*v/0.8,0.6,1.08), Dm=base*sF;
    const Deff=Dm*(1-Math.exp(-x/(1.0*Dm+h+0.5)));
    const lam=0.8*Dm+1.2;
    const moving=smooth(0.05,0.35,v);
    z+=(Deff-z)/lam*v*dt*moving - A.vPause*dt*(1-moving);
    if(z<0) z=0;
    if(z>=p.bottomD){ z=p.bottomD; contact+=v*dt; }
    const ev=Math.abs(v-pv)>0.25 && t>0.5; if(ev) events++;
    X.push(x); Z.push(z); V.push(v); Lb.push(li); E.push(ev?1:0);
    if(z>maxZ){maxZ=z;maxAt=x}
    if(Math.abs(z-p.target)<=0.6) inZone+=dt;
    x-=v*dt; t+=dt; pv=v;
  }
  const pts=X.map((xx,i)=>[xx,Z[i]]);
  return {dt,n:X.length,X,Z,V,Lb,E,labels,pts,maxZ,maxAt,inZonePct:100*inZone/Math.max(t,0.01),contact,T:t,time:t,events,v0:lineSpeed(p)};
}
/* strike / hook-up model (rule of thumb, for comparing designs) */
const BRIGHT=['firetiger','chartreuse','redhead'], NATURAL=['haruan','ghost','blackgold'];
function interestAt(p,A,z,v,S){
  const depthOK=Math.exp(-Math.pow((z-p.target)/1.3,2));
  const speedOK= v<0.05?0.7 : v<0.25?0.75 : v<=1.3?1 : v<=1.8?0.75:0.55;
  const actionOK=clamp(0.6+S.yaw/25,0.6,1.2);
  const cl=p.clarity||'tea';
  const colorOK= (cl!=='clear' && BRIGHT.includes(p.pattern)) ? 1.15 : (cl==='clear' && NATURAL.includes(p.pattern)) ? 1.1 : 1;
  return depthOK*speedOK*actionOK*colorOK;
}
function hookOdds(p,A,ctx){
  const H=A.hooks, R=[]; let o=0.72;
  if(!H.belly && !H.tail) return {p:0,reasons:[['-','no hooks fitted']]};
  const main=H.belly||H.tail;
  if(main.gap<7){o*=0.65;R.push(['-',`small hook gap (${f1(main.gap)} mm) on a bony toman mouth`])}
  else if(main.gap<10){o*=0.85;R.push(['-',`hook gap ${f1(main.gap)} mm is a bit small for toman`])}
  else R.push(['+',`${f1(main.gap)} mm hook gap suits a big mouth`]);
  if(H.small){o*=0.8;R.push(['-','body shields the hook points'])}
  if(H.tangle==='e'||H.lineFoul==='e'){o*=0.5;R.push(['-','fouled hooks (tangled or caught on the line)'])}
  else if(H.tangle==='w'||H.lineFoul==='w'){o*=0.88;R.push(['-','hooks sometimes foul'])}
  if(H.belly&&H.tail){o*=1.06;R.push(['+','two hooks in play'])}
  if(p.hookType==='single'){o*=0.85;R.push(['-','singles hook up slightly less (but hold better)'])}
  if(ctx.trigger){o*=1.12;R.push(['+','reaction strike on a speed change or pause'])}
  if(ctx.v>1.3){o*=0.85;R.push(['-','fast retrieve → short strikes'])}
  return {p:clamp(o,0,0.97),reasons:R};
}
function fightOutcome(p,A,W){
  const H=A.hooks, main=H.belly||H.tail, r=()=>0.8+0.4*Math.random();
  const hookCap=hookCapKg(p,main.size), ringCap=ringCapKg(p.ring);
  if(W>ringCap*r()) return {ok:false,t:'Split ring opened',why:`A #${p.ring} ring is rated about ${ringCap} kg. Go up a ring size.`};
  if(W>hookCap*r()) return {ok:false,t:'Hook straightened',why:`${HSTR[p.hookStr].n} ${main.label}s hold about ${f1(hookCap)} kg. Use 4X strong or a bigger size.`};
  if(W>wireRatedKg(+p.wireGauge)*r()) return {ok:false,t:'Harness pulled out',why:`The Ø${p.wireGauge} mm through-wire eye opened. Use a heavier gauge.`};
  let thrown=0.14*((p.hookType!=='single'&&p.L>=90)?1.25:1)*(p.hookType==='single'?0.75:1)*(H.small?1.3:1);
  if(Math.random()<thrown) return {ok:false,t:'Thrown on a jump',why:'The fish used the lure body for leverage and shook the hooks free. Singles or slightly bigger hooks help.'};
  return {ok:true,t:'Landed!',why:`Hooks and rings held. Rated about ${f1(Math.min(hookCap,ringCap))} kg with this hardware.`};
}


/* ============================== release model (pure: state in, data out) ============================== */
const fx=(v,n)=>(Math.round(v*Math.pow(10,n))/Math.pow(10,n)).toFixed(n);
function skuOf(meta,L,cls,cw){ return `UL-${meta.family}${Math.round(L)}${cls}-${cw.code}`; }
/* st = {P,PAINT,META,CW,BOMOVR,COST,name}. Production figures always use injection mode in fresh water (28 °C spec). */
function releaseModel(st){
  const p=Object.assign({},st.P,{prodMode:'inject',water:'fresh'}); p.speed=lineSpeed(p);
  const body=buildBody(p), bill=buildBill(p), geom=productionGeometry(p,true);
  const A=analyse(p,body,bill,{Vshell:geom.Vshell,Cshell:geom.Cshell},st.BOMOVR);
  const cls=buoyClass(A.net), rel={p,body,bill,geom,A,cls,st,meta:st.META,cw:st.CW,cost:st.COST,name:st.name||'',
    modelCode:st.META.family+Math.round(p.L), sku:skuOf(st.META,p.L,cls,st.CW),
    swim:swimParams(p,A), S05:swimParams(p,A,0.5), S10:swimParams(p,A,1.0)};
  rel.pkg=validatePkg(st.PKG); rel.eye=eyeSpec(p);
  rel.bom=bomRows(rel); rel.costing=costing(rel); rel.qc=qcCriteria(rel); rel.dfm=dfmChecks(rel); rel.sections=sectionStations(rel);
  rel.pack=packagingModel(rel); rel.gate=releaseGate(rel);
  return rel;
}
/* 3D eye stickers: same placement as the 3D view (12 % of L, 28 % of the back height), on the flank surface */
function eyeSpec(p){ const te=0.12, [top,,w]=radii(te,p), z=top*0.28, er=Math.max(1.4,top*0.17), d=Math.round(er*4)/2;
  const y=w*Math.pow(Math.max(0,1-Math.pow(z/top,p.se)),1/p.se); return {x:te*p.L,y,z,d,recessD:d+0.3,recessDepth:0.3}; }
const BALLFIX={pocket:'Glued in moulded pocket (2K epoxy), no movement',rattle:'Loose rattle chamber, balls free to move'};
function ballastPocket(p){ const n=p.ballN, d=p.ballD; if(!n) return null; const len=n*d*1.02+(p.ballFix==='rattle'?Math.max(4,d):0.4);
  return {fix:p.ballFix||'pocket',text:BALLFIX[p.ballFix||'pocket'],dia:+(d+(p.ballFix==='rattle'?0.6:0.2)).toFixed(1),len:+len.toFixed(1),x:p.ballX,z:p.ballZ}; }
/* lure envelope incl. hooks (hanging at rest) -> blister, card, inner box and carton */
function lureEnvelope(rel){
  const {p,A,bill}=rel, bc=billSideCorners(p,bill.B,A.tip), H=A.hooks;
  let x0=Math.min(0,...bc.map(v=>v.x)), x1=p.L, z1=Math.max(...profileData(p).tops), z0=Math.min(-p.bot,...bc.map(v=>v.z)), w=Math.max(2*p.halfW,p.billW);
  [[H.belly,A.pts.belly],[H.tail,A.pts.tail]].forEach(([h,q])=>{ if(!h) return; x1=Math.max(x1,q[0]+h.gap+1); z0=Math.min(z0,q[2]-h.ringD-h.l); w=Math.max(w,(p.hookType==='single'?1:2)*h.gap+2); });
  return {L:x1-x0,H:z1-z0,W:w};
}
function packagingModel(rel){
  const k=rel.pkg, env=lureEnvelope(rel), bl={L:env.L+5,H:env.H+5,D:env.W+5}, chk=[];
  const header=30, side=6, ends=8;
  const fitH=bl.L+header+2*ends<=k.cardH, fitW=bl.H+2*side<=k.cardW;
  chk.push([fitH&&fitW?'o':'e',`Blister ${fx(bl.L,0)} × ${fx(bl.H,0)} × ${fx(bl.D,0)} mm on card ${k.cardW} × ${k.cardH} mm: ${fitH&&fitW?'fits':'does NOT fit'} (needs ≥ ${fx(bl.H+2*side,0)} × ${fx(bl.L+header+2*ends,0)} mm incl. ${header} mm hang header).`]);
  const ean=ean13Status(k.ean13); chk.push([ean.ok===false?'e':ean.ok===null?'w':'o',`EAN-13: ${ean.ok===null?'not set':ean.full+' ('+ean.msg+')'}`]);
  if(k.cartonQty%k.innerQty) chk.push(['w',`Carton qty ${k.cartonQty} is not a multiple of the inner qty ${k.innerQty}.`]);
  const cardG=k.cardW*k.cardH*1e-6*350, blG=2*(bl.L*bl.H+bl.L*bl.D+bl.H*bl.D)*0.3*1.38e-3, unitG=rel.A.M+cardG+blG;
  const inner={W:k.cardW+4,H:k.cardH+4,D:Math.ceil(k.innerQty*(bl.D+1)+4)};
  const nIn=Math.ceil(k.cartonQty/k.innerQty); let best=null;
  for(let a=1;a<=nIn;a++) for(let b=1;b<=nIn;b++){ const c=Math.ceil(nIn/(a*b)); if(a*b*c<nIn) continue; const d=[a*inner.W+10,b*inner.D+10,c*inner.H+10], v=d[0]*d[1]*d[2], score=v*(1+0.002*(Math.max(...d)-Math.min(...d)));
    if(!best||score<best.score) best={score,grid:[a,b,c],dims:d}; }
  const gross=(k.cartonQty*unitG+nIn*35+600)/1000;
  if(best&&Math.max(...best.dims)>600) chk.push(['w',`Carton side ${fx(Math.max(...best.dims),0)} mm > 600 mm; reduce the carton qty.`]);
  if(gross>20) chk.push(['w',`Carton gross ${fx(gross,1)} kg > 20 kg handling limit.`]);
  const name=rel.name||rel.modelCode, cls={F:'Floating',SP:'Suspending',S:'Sinking'}[rel.cls], clsBM={F:'Terapung',SP:'Melayang',S:'Tenggelam'}[rel.cls], dep=fx(rel.A.depth,1);
  const en=k.cardEN||`${name} · ${fx(p_L(rel),0)} mm ${fx(rel.A.M,1)} g · ${cls} · dives to ${dep} m`, bm=k.cardBM||`${name} · ${fx(p_L(rel),0)} mm ${fx(rel.A.M,1)} g · ${clsBM} · selam hingga ${dep} m`;
  return {env,blister:bl,card:{W:k.cardW,H:k.cardH,g:cardG},unitG,inner,innerQty:k.innerQty,cartonQty:k.cartonQty,nInner:nIn,carton:best,grossKg:gross,ean,copyEN:en,copyBM:bm,checks:chk,sku:rel.sku};
