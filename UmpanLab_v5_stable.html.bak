<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Umpan Lab — Crankbait Designer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f3efe6; --paper:#fbf9f4; --ink:#1c2826; --mute:#5f6763; --line:#ddd6c8;
  --accent:#d4621c; --accent-d:#b4500f; --teal:#1f6f6a; --red:#c62f2f; --blue:#2a62c9; --ok:#26733f; --warn:#e0a526; --warn-ink:#7f5300;
  --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; --sans:'Space Grotesk',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
  --panel-h:250px;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;height:100%}
body{display:flex;flex-direction:column;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;overflow:hidden}
:focus{outline:none}
:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
select,input[type=text],button{font:inherit;font-size:13px}
select,input[type=text]{background:#fff;border:1px solid var(--line);border-radius:7px;padding:5px 8px;color:var(--ink)}
button,.btn{border:1px solid var(--ink);background:var(--ink);color:#fff;border-radius:7px;padding:6px 11px;cursor:pointer;font-weight:500;line-height:1.2}
button.ghost,.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
button.ghost:hover,.btn.ghost:hover{border-color:var(--ink)}
button.danger{background:var(--red);border-color:var(--red)}
button:disabled{opacity:.4;cursor:not-allowed}
.hgroup{display:flex;gap:6px;align-items:center}

/* ---------- app bar: one row ---------- */
.appbar{display:grid;grid-template-columns:auto minmax(170px,1fr) auto auto;align-items:center;gap:14px;height:52px;padding:0 14px;border-bottom:1px solid var(--line);background:var(--paper);position:relative;z-index:20}
.brand{display:flex;align-items:baseline;gap:8px;white-space:nowrap}
.brand b{font-size:19px;letter-spacing:-.02em}
.brand b span{color:var(--accent-d)}
.brand b i{font-style:normal}.brand .bs{display:none}
.brand small{color:var(--mute);font-size:11.5px}
.doc{display:flex;align-items:center;gap:8px;min-width:0}
.doc input{flex:1 1 220px;min-width:90px;max-width:300px;font-weight:600;border-color:transparent;background:transparent;text-overflow:ellipsis}
.badge .brev{display:none}
.dirty .dl{margin-left:3px}
.doc input:hover,.doc input:focus{border-color:var(--line);background:#fff}
.rev{font-family:var(--mono);font-size:12px;white-space:nowrap}
.badge{border-radius:20px;padding:2px 9px;font-size:11px;font-weight:600;background:#e6dfd1;color:var(--ink);white-space:nowrap}
.badge.s-Released{background:var(--ok);color:#fff}.badge.s-Golden{background:#f2c514}.badge.s-T0,.badge.s-T1{background:#d7e8e6}
.dirty{font-size:11.5px;color:var(--warn-ink);white-space:nowrap}
.modes{display:flex;gap:2px;height:100%;align-items:stretch}
.modes button{background:transparent;border:none;border-radius:0;color:var(--mute);padding:0 13px;font-size:13.5px;font-weight:600;letter-spacing:.01em}
.modes button:hover{color:var(--ink)}
.modes button[aria-selected=true]{color:var(--ink);box-shadow:inset 0 -3px var(--accent-d)}
.actions{display:flex;gap:6px;align-items:center}
details.menu{position:relative}
details.menu>summary{list-style:none;cursor:pointer;border:1px solid var(--line);border-radius:7px;padding:6px 11px;font-size:13px;font-weight:500;white-space:nowrap;user-select:none}
details.menu>summary::-webkit-details-marker{display:none}
details.menu>summary:hover,details.menu[open]>summary{border-color:var(--ink)}
.pop{position:absolute;right:0;top:calc(100% + 6px);background:var(--paper);border:1px solid var(--line);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.16);padding:6px;min-width:250px;max-width:calc(100vw - 16px);z-index:30;display:flex;flex-direction:column;gap:1px}
.pop .mh{font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--mute);padding:7px 8px 3px;font-weight:600}
.pop button{background:transparent;color:var(--ink);border:none;text-align:left;padding:6px 8px;border-radius:6px;font-weight:500}
.pop button:hover,.pop button:focus-visible{background:#ece6da}
.pop button small{display:block;color:var(--mute);font-size:11px;font-weight:400}
.pop hr{border:none;border-top:1px solid var(--line);margin:4px 0}
.pop .mrow{display:flex;gap:6px;padding:2px 8px 4px}
.pop .mrow select{flex:1;min-width:0}
.pop .mrow button{border:1px solid var(--line)}

/* ---------- spec strip ---------- */
.specstrip{display:flex;align-items:center;gap:6px;height:36px;padding:0 14px;border-bottom:1px solid var(--line);background:#f8f5ee;font-family:var(--mono);font-size:12.5px;white-space:nowrap;overflow-x:auto;overflow-y:hidden;flex:none}
.chip{display:inline-block;border:1px solid var(--line);background:#fff;border-radius:20px;padding:2px 10px;color:var(--ink)}
.chip em{font-style:normal;color:var(--mute);font-size:11px}
.chip.cls-F{border-color:#a9cfc9}.chip.cls-SP{border-color:#e7c77a}.chip.cls-S{border-color:#efb1b1}
.specstrip .grow{flex:1}
button.chip{font-family:var(--mono);font-size:12.5px;font-weight:600;cursor:pointer}
button.chip.ok{background:#f1faf3;border-color:#bfe0c9;color:var(--ok)}
button.chip.warn{background:#fff6dd;border-color:#e7c77a;color:var(--warn-ink)}
button.chip.err{background:#fff0f0;border-color:#efb1b1;color:#9e1f1f}

/* ---------- workspace ---------- */
main{display:grid;grid-template-columns:300px minmax(0,1fr) 320px;flex:1;min-height:0}
body[data-mode=release] main{grid-template-columns:300px minmax(0,1fr)}
body[data-mode=release] #stats{display:none}
body[data-mode=design] [data-show]:not([data-show~=design]),
body[data-mode=analyse] [data-show]:not([data-show~=analyse]),
body[data-mode=simulate] [data-show]:not([data-show~=simulate]),
body[data-mode=release] [data-show]:not([data-show~=release]){display:none}
aside{overflow:auto;padding:10px 14px 14px;background:var(--paper);min-height:0}
#left{border-right:1px solid var(--line)}
#stats{border-left:1px solid var(--line)}
.ntabs{display:none}

/* parameter accordion */
.grp{border-bottom:1px solid var(--line)}
.grp>h2{margin:0;display:flex;align-items:center;gap:6px}
.grp>h2 button.acc{flex:1;display:flex;align-items:center;gap:6px;background:none;border:none;color:var(--teal);padding:9px 0;font-size:12.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;text-align:left;border-radius:4px}
.grp>h2 button.acc::before{content:"▸";color:var(--mute);font-size:11px;width:10px}
.grp>h2 button.acc[aria-expanded=true]::before{content:"▾"}
.grp>h2 .acc .n{margin-left:auto;font:400 11px var(--mono);color:var(--mute);text-transform:none;letter-spacing:0;white-space:nowrap}
.grp>h2 button.acc{white-space:nowrap;min-width:0}
.advt{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--mute);cursor:pointer;white-space:nowrap}
.advt input{margin:0;accent-color:var(--teal)}
.gbody{padding:0 0 10px}
.grp:not(.adv-on) .prow.adv{display:none}
.prow{display:grid;grid-template-columns:minmax(0,1fr) 62px 36px;gap:1px 6px;align-items:center;margin:7px 0 2px}
.prow>label{font-size:12.5px;color:#2b3532;cursor:default;line-height:1.25;user-select:none}
.prow>label[data-reset]{cursor:pointer}
.prow .u{font:11px var(--mono);color:var(--mute);white-space:nowrap;overflow:hidden}
.prow input[type=number]{width:62px;font-family:var(--mono);font-size:12px;border:1px solid var(--line);border-radius:5px;padding:3px 4px;text-align:right;background:#fff;color:var(--ink)}
.prow input[type=range]{color:var(--ink);grid-column:1/-1;width:100%;accent-color:var(--accent-d);margin:1px 0 0;height:18px}
.prow .hint{grid-column:1/-1;font-size:11px;color:var(--mute);margin-top:-1px}
.prow.sel{grid-template-columns:minmax(0,1fr) 158px}
.prow.sel select,.prow.sel input[type=text]{width:100%;padding:4px 6px;min-width:0}
.prow.col{grid-template-columns:minmax(0,1fr) 62px}
.prow.col input[type=color]{width:62px;height:24px;border:1px solid var(--line);border-radius:5px;padding:0;background:none}
.prow.chk{grid-template-columns:1fr}
.prow.chk label{display:flex;gap:6px;align-items:center;cursor:pointer}
.prow.dim>label{opacity:.5}
.prow input:disabled,.prow select:disabled,.prow textarea:disabled,.rt input:disabled,.rt textarea:disabled,.costin input:disabled{background:var(--paper);color:var(--mute);border-color:var(--line);cursor:not-allowed}
#simctl .prow.sel,.prow.sel.stk{grid-template-columns:1fr;gap:3px}
#cwCx{min-width:150px}
.note{font-size:11.5px;color:var(--mute);line-height:1.4;margin:6px 0}
.note.mono{font-family:var(--mono);font-size:11px}
.psub{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--teal);margin:14px 0 2px;padding-top:8px;border-top:1px dashed var(--line)}
.psub:first-child{border-top:none;margin-top:4px;padding-top:0}
label.stack{display:flex;flex-direction:column;gap:3px;font-size:12.5px;color:#2b3532;margin:7px 0 2px}
label.stack textarea{font:inherit;font-size:12px;border:1px solid var(--line);border-radius:7px;padding:5px 7px;resize:vertical}
.lockbar{background:#e8f4ec;border:1px solid #bfe0c9;color:#1d5e2f;border-radius:8px;padding:5px 9px;font-size:12px;margin:6px 0}
body:not(.locked) .lockbar.side{display:none}

/* centre: viewport / splitter / panel */
.center{display:grid;grid-template-rows:minmax(120px,1fr) 7px var(--panel-h);min-width:0;min-height:0}
body[data-mode=release] .center{grid-template-rows:minmax(0,1fr)}
#view{position:relative;min-height:0;overflow:hidden;background:radial-gradient(ellipse at 50% 35%,#fdfbf6 0%,#e9e3d6 100%)}
#view canvas{display:block}
.viewbar{position:absolute;left:10px;top:10px;display:flex;gap:6px;align-items:center;flex-wrap:nowrap;max-width:calc(100% - 20px)}
.vchip{background:rgba(255,255,255,.88);border:1px solid var(--line);border-radius:20px;padding:4px 10px;font-size:12px;display:flex;gap:5px;align-items:center;cursor:pointer;white-space:nowrap;color:var(--ink)}
.vchip input{margin:0;accent-color:var(--teal)}
.seg{display:flex;background:rgba(255,255,255,.88);border:1px solid var(--line);border-radius:20px;overflow:hidden}
.seg button{background:transparent;border:none;color:var(--ink);border-radius:0;padding:4px 10px;font-size:12px;font-weight:500}
.seg button[aria-pressed=true]{background:var(--ink);color:#fff}
.legend{position:absolute;left:10px;bottom:10px;font-size:11px;background:rgba(255,255,255,.85);border:1px solid var(--line);border-radius:20px;padding:3px 10px;display:flex;gap:10px;white-space:nowrap}
#view.uw .legend{display:none}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:-1px}
#swimInfo{position:absolute;right:10px;top:10px;font-family:var(--mono);font-size:11px;line-height:1.45;background:rgba(255,255,255,.9);border:1px solid var(--line);border-radius:8px;padding:4px 9px;white-space:nowrap}
#swimInfo .hs{display:none}
.transport{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);display:flex;gap:6px;align-items:center;background:rgba(251,249,244,.93);border:1px solid var(--line);border-radius:24px;padding:4px 6px;box-shadow:0 4px 14px rgba(0,0,0,.12);white-space:nowrap}
.transport select{border-radius:20px;padding:3px 6px;font-size:12px}
.transport .vchip{background:transparent;border-color:transparent;padding:3px 6px}
.transport button{border-radius:20px;padding:5px 12px;font-size:12.5px}
.transport .st{display:none}
.playbtn{background:var(--accent-d);border-color:var(--accent-d);min-width:84px}
.toasts{position:absolute;left:10px;bottom:58px;display:flex;flex-direction:column-reverse;gap:6px;width:260px;pointer-events:none}
.stoast{pointer-events:auto;background:rgba(251,249,244,.96);border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:9px;padding:6px 10px;font-size:12px;line-height:1.4;box-shadow:0 4px 14px rgba(0,0,0,.14);transition:opacity .4s}
.stoast .t{font-weight:700;font-size:13.5px}
.stoast .m{font-family:var(--mono);font-size:11px;color:var(--mute)}
.stoast .d{margin-top:3px}
.stoast.mini .d{display:none}
.stoast.mini{padding:4px 10px}
.stoast.fade{opacity:0}
.bar{height:6px;border-radius:4px;background:#e6dfd1;overflow:hidden;margin:3px 0 5px}
.bar i{display:block;height:100%;background:var(--accent-d)}
.splitter{background:var(--line);cursor:row-resize;position:relative;touch-action:none}
.splitter::after{content:"";position:absolute;left:50%;top:2px;width:44px;height:3px;margin-left:-22px;border-radius:2px;background:#b5ab98}
.splitter:hover,.splitter:focus-visible{background:#cfc6b4}
.panel{background:var(--paper);padding:8px 12px;min-height:0;display:flex;flex-direction:column;overflow:hidden}
.pane{flex:1;min-height:0;display:flex;flex-direction:column}
.pane h4,h3{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--teal);margin:0 0 4px;display:flex;align-items:center;gap:6px}
h3{margin:14px 0 6px}
h3:first-child{margin-top:4px}
#side{flex:1;width:100%;min-height:0}
.simgrid{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:14px;flex:1;min-height:0}
#dive{width:100%;height:100%;min-height:0}
.simres{font-size:12px;color:#2b3532;line-height:1.5;overflow:auto}
.simres b{font-family:var(--mono);font-weight:500}

/* right panels */
.status{border-radius:12px;padding:12px 14px;color:#fff;margin-bottom:10px}
.status .big{font-size:22px;font-weight:700;letter-spacing:-.02em}
.status .sub{font-family:var(--mono);font-size:12.5px;margin-top:2px}
.status.warn{color:var(--ink)}
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:6px}
.kpi{background:#fff;border:1px solid var(--line);border-radius:10px;padding:7px 9px;position:relative;min-width:0}
.kpi .l{font-size:10.5px;color:var(--mute);text-transform:uppercase;letter-spacing:.04em;display:flex;align-items:center;justify-content:space-between;gap:4px;white-space:nowrap}
.kpi .v{font-family:var(--mono);font-size:16px;font-weight:500;margin-top:2px}
.kpi .v.sm{font-size:13.5px}
.kpi .s{font-size:11px;color:var(--mute)}
.kpi .tg{font-size:11px;margin-top:2px;font-family:var(--mono)}
.kpi .tg.ok{color:var(--ok)}.kpi .tg.w{color:var(--warn-ink)}.kpi .tg.e{color:#9e1f1f}
.kpi.wide{grid-column:1/-1}
.tag{font:600 9px var(--mono);letter-spacing:.04em;border-radius:4px;padding:1px 4px;flex:none}
.tag.calc,.tagi.calc{background:#dcefeb;color:#14524e}
.tag.est,.tagi.est{background:#f8e3b0;color:var(--ink)}
.tag.model,.tagi.model{background:#e3e1dc;color:#3d4441}
.tagi{font:600 9.5px var(--mono);letter-spacing:.05em;border-radius:4px;padding:1px 4px;text-transform:none}
.taglegend{font-size:10.5px;color:var(--mute);display:flex;gap:8px;flex-wrap:wrap;margin:2px 0 8px}
.c-ok{color:var(--ok)}.c-w{color:var(--warn-ink)}.c-e{color:#9e1f1f}
table{width:100%;border-collapse:collapse;font-size:12.5px}
td,th{padding:4px 2px;border-bottom:1px dashed var(--line)}
th{text-align:left;font-weight:600;color:var(--mute);font-size:11.5px;border-bottom:1px solid var(--line)}
td:last-child{text-align:right;font-family:var(--mono)}
tr.tot td{font-weight:600;border-bottom:none}
#cgTable td:last-child,#hookTable td:nth-child(n+2),#hookTable th:nth-child(n+2){white-space:nowrap;text-align:right;font-family:var(--mono);padding-left:6px}
ul.checks{list-style:none;padding:0;margin:0}
ul.checks li{font-size:12.5px;padding:6px 9px;border-radius:8px;margin-bottom:5px;line-height:1.35;border:1px solid var(--line);background:#fff}
ul.checks li.w{border-color:#e7c77a;background:#fff8e8}
ul.checks li.e{border-color:#efb1b1;background:#fff0f0}
ul.checks li.o{border-color:#bfe0c9;background:#f1faf3}
ul.checks li::before{font-weight:700;margin-right:5px}
ul.checks li.e::before{content:"✕";color:#9e1f1f}ul.checks li.w::before{content:"!";color:var(--warn-ink)}ul.checks li.o::before{content:"✓";color:var(--ok)}
ul.checks li.i{background:#f6f4ef}ul.checks li.i::before{content:"i";color:var(--mute);font-family:var(--mono)}
ul.checks .src{font:600 9.5px var(--mono);background:#e3e1dc;border-radius:4px;padding:0 4px;color:#3d4441}
details.passed>summary{cursor:pointer;font-size:12px;color:var(--ok);padding:3px 0;list-style:none}
details.passed>summary::before{content:"▸ "}details.passed[open]>summary::before{content:"▾ "}
#checksSec.flash{animation:flash 1.2s}
@keyframes flash{0%{background:#fff3c4}100%{background:transparent}}
ol.slog{list-style:none;padding:0;margin:0;font-size:12px;max-height:none}
ol.slog li{border-bottom:1px dashed var(--line);padding:5px 0}
ol.slog li .m{font-family:var(--mono);font-size:11px;color:var(--mute)}
ol.slog details summary{cursor:pointer;font-size:11.5px;color:var(--teal)}
ol.slog ul{margin:3px 0;padding-left:16px}

/* release (Stage A content re-housed) */
#pRel{overflow:auto}
body[data-mode=release] #pRel{display:block}
.rel{width:100%;font-size:12px}
.relbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;position:sticky;top:0;background:var(--paper);padding:2px 0 8px;z-index:2}
.relbar .sku,.mono{font-family:var(--mono)}
.relbar .sku{font-weight:600;font-size:13px}
.relgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:10px;padding-bottom:8px}
.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:8px 10px;min-width:0}
.card.wide{grid-column:1/-1}
.card.w2{grid-column:span 2}
.card h5{margin:0 0 6px;font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--teal)}
.card h5 .note{text-transform:none;letter-spacing:0;font-weight:400}
.rt{width:100%;border-collapse:collapse;font-size:11.5px}
.rt th{text-align:left;font-weight:600;color:var(--mute);border-bottom:1px solid var(--line);padding:3px 4px;white-space:nowrap}
.rt td{padding:2px 4px;border-bottom:1px dashed var(--line);text-align:left;font-family:var(--sans)}
.rt td.n,.rt th.n{text-align:right;font-family:var(--mono);white-space:nowrap}
.rt input{width:100%;font:inherit;font-size:11.5px;border:1px solid transparent;background:transparent;padding:1px 3px;border-radius:4px;color:var(--ink)}
.rt input:hover,.rt input:focus{border-color:var(--line);background:#fff}
.rt input.ovr{background:#fff6e0;border-color:#e7c77a}
.rt tr.pass td{background:#f1faf3}.rt tr.fail td{background:#fff0f0}.rt td.bad{color:var(--red);font-weight:600}
.rt tr.tot td{font-weight:600;border-bottom:none}
.costin{display:grid;grid-template-columns:1fr 84px;gap:3px 8px;align-items:center;margin-bottom:6px;font-size:11.5px}
.costin input{width:84px;font-family:var(--mono);font-size:11.5px;border:1px solid var(--line);border-radius:5px;padding:2px 4px;text-align:right}
.costin input[type=text]{width:100%;text-align:left;font-family:var(--sans)}
.costin{grid-template-columns:1fr minmax(84px,auto)}
.drawprev{border:1px solid var(--line);border-radius:6px;overflow:hidden;background:#fff}
.stack{display:flex;flex-direction:column;gap:10px;min-width:0}
.relgrid>.card.w2{align-self:start}
.card h5 .seg{display:inline-flex;margin-left:8px;vertical-align:middle;border-color:var(--line)}
.card h5 .seg button{padding:2px 9px;font-size:11px;text-transform:none;letter-spacing:0}
.card.gatebad{border-color:#efb1b1;background:#fffafa}
#gateCard.flash{animation:flash 1.2s}
ul.gate{margin:2px 0 6px;padding-left:18px;font-size:12px;color:#9e1f1f}
.nfp{background:#fff0f0;border:1px solid #efb1b1;color:#9e1f1f;border-radius:8px;padding:5px 9px;font-size:12px;font-weight:700;margin:6px 0}
.bomwrap{overflow-x:auto}
.rt.bom{table-layout:fixed;min-width:860px}
.rt.bom td,.rt.bom th{padding:2px 3px;vertical-align:top;overflow-wrap:anywhere}
.rt.bom th{white-space:normal;font-size:11px}
.rt.bom textarea{width:100%;font:inherit;font-size:11.5px;line-height:1.3;border:1px solid transparent;background:transparent;padding:1px 3px;border-radius:4px;color:var(--ink);resize:none;overflow:hidden;display:block;min-height:20px}
.rt.bom textarea:hover,.rt.bom textarea:focus{border-color:var(--line);background:#fff}
.rt.bom textarea.ovr{background:#fff6e0;border-color:#e7c77a}
.rt.bom input{text-align:right;font-family:var(--mono);font-size:11px;padding:1px 2px}
.costin.pk{grid-template-columns:1fr 130px}.costin.pk input{width:130px}
.drawprev svg{display:block;width:100%;height:auto}
ul.clog{list-style:none;padding:0;margin:4px 0 0;font-size:11.5px;max-height:150px;overflow:auto}
ul.clog li{padding:3px 0;border-bottom:1px dashed var(--line)}
body.locked .grp.spec>h2 .acc .n::after{content:" · locked";color:var(--ok)}

/* toast + modals */
#toast{position:fixed;right:16px;bottom:16px;background:var(--ink);color:#fff;padding:9px 16px;border-radius:9px;font-size:13px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:50;max-width:min(460px,calc(100vw - 32px))}
#toast.show{opacity:1}
.modal{position:fixed;inset:0;background:rgba(20,25,24,.45);display:none;align-items:center;justify-content:center;z-index:60}
.modal.show{display:flex}
.modal .box{background:var(--paper);border-radius:12px;padding:18px;width:min(560px,92vw);max-height:80vh;display:flex;flex-direction:column;gap:10px;box-shadow:0 20px 60px rgba(0,0,0,.25)}
.modal .box.sm{width:min(420px,92vw)}
.modal h2{margin:0;font-size:17px}
.modal textarea{width:100%;height:280px;font-family:var(--mono);font-size:11.5px;border:1px solid var(--line);border-radius:8px;padding:8px}

/* ---------- medium: keep the bar on one row ---------- */
@media (max-width:1360px){ .brand small{display:none} }
@media (max-width:1240px){ main{grid-template-columns:280px minmax(0,1fr) 300px} body[data-mode=release] main{grid-template-columns:280px minmax(0,1fr)} .modes button{padding:0 10px} .doc .dirty{max-width:70px;overflow:hidden;text-overflow:ellipsis} }

/* ---------- narrow (<1100 px): sticky viewport + Params | Results | Checks ---------- */
@media (max-width:1099px){
  html,body{height:auto}
  body{display:block;overflow:auto}
  .appbar{grid-template-columns:auto minmax(0,1fr) auto;grid-template-rows:46px 40px;height:auto;gap:4px 8px;padding:0 10px}
  .modes{grid-column:1/-1;grid-row:2;justify-content:space-between;border-top:1px solid var(--line)}
  .modes button{flex:1;padding:0 4px}
  .doc{overflow:hidden}
  .doc .rev{display:none}
  .doc .dirty .dl{display:none}
  .badge .brev{display:inline}
  #sIssues{order:-1}
  .specstrip .grow{display:none}
  .actions{gap:4px}
  .actions>button,details.menu>summary{padding:6px 8px}
  .specstrip{padding:0 10px}
  main{display:flex;flex-direction:column}
  .center{display:contents}
  #view{order:1;position:sticky;top:0;height:40vh;z-index:5;border-bottom:1px solid var(--line)}
  .splitter{display:none}
  .ntabs{order:2;display:flex;position:sticky;top:40vh;z-index:5;background:var(--paper);border-bottom:1px solid var(--line)}
  .ntabs button{flex:1;background:transparent;border:none;border-radius:0;color:var(--mute);padding:10px 4px;font-weight:600}
  .ntabs button[aria-selected=true]{color:var(--ink);box-shadow:inset 0 -3px var(--accent-d)}
  #left{order:3;border:none}
  .panel{order:5;height:auto;min-height:260px;overflow:visible}
  #pSide{height:240px;flex:none}
  #pSim .simgrid{grid-template-columns:1fr}
  #dive{height:200px}
  #stats{order:4;border:none}
  aside{overflow:visible}
  body[data-ntab=params] .panel,body[data-ntab=params] #stats{display:none}
  body[data-ntab=results] #left,body[data-ntab=results] #checksSec{display:none}
  body[data-ntab=checks] #left,body[data-ntab=checks] .panel{display:none}
  body[data-ntab=checks] #stats>:not(#checksSec){display:none}
  body[data-ntab=checks] #stats>#checksSec{display:block!important}
  body[data-mode=release] .ntabs{display:none}
  body[data-mode=release] #left{display:block}
  body[data-mode=release] .panel{display:flex}
  body[data-mode=release] #view{display:none}
  .viewbar{flex-wrap:wrap}
  .legend{display:none}
  .toasts{width:220px;bottom:52px}
  .transport{bottom:6px}
  #swimInfo{top:auto;bottom:48px;right:6px;font-size:10px;padding:2px 7px;line-height:1.3}
  #swimInfo .hl{display:none} #swimInfo .hs{display:inline}
}
@media (max-width:560px){
  .brand small{display:none}
  .brand b{font-size:17px}
  .brand .bf{display:none}.brand .bs{display:inline}
  .doc input{max-width:none}
  .seg button{padding:4px 7px}
  .relgrid{grid-template-columns:1fr}
  .card.w2{grid-column:auto}
  .transport .vchip .lt{display:none}
  .transport .vchip .st{display:inline}
  .transport{gap:3px;padding:3px 4px}
  .transport button{padding:5px 9px}
  .playbtn{min-width:70px}
  .doc{gap:4px}
  .doc input{flex:1 1 40px;min-width:40px;padding:5px 2px}
  .doc .badge{font-size:10px;padding:2px 5px;flex:none}
  .doc .dirty{flex:none}
  .appbar{gap:4px 6px}
  .toasts{width:auto;max-width:180px}
  .stoast{font-size:11px;padding:4px 8px}.stoast .t{font-size:12px}
}
@media (prefers-reduced-motion:reduce){ *{transition:none!important;animation:none!important} }
</style>
</head>
<body data-mode="design" data-ntab="params">
<header class="appbar">
  <div class="brand"><b><i class="bf">Umpan<span>Lab</span></i><i class="bs" aria-hidden="true">U<span>L</span></i></b><small>crankbait designer · mm / g</small></div>
  <div class="doc">
    <input type="text" id="dname" placeholder="Design name" aria-label="Design name" spellcheck="false" maxlength="60">
    <span class="rev" id="barRev" title="Revision">Rev A</span>
    <span class="badge" id="barStatus" title="Release status"><span class="brev" id="barStatusRev">A · </span><span id="barStatusTxt">Concept</span></span>
    <span class="dirty" id="dirty" role="status" aria-live="polite"></span>
  </div>
  <nav class="modes" role="tablist" aria-label="Workspace">
    <button role="tab" id="tab-design" data-mode="design" aria-selected="true" aria-controls="app">Design</button>
    <button role="tab" id="tab-analyse" data-mode="analyse" aria-selected="false" aria-controls="app" tabindex="-1">Analyse</button>
    <button role="tab" id="tab-simulate" data-mode="simulate" aria-selected="false" aria-controls="app" tabindex="-1">Simulate</button>
    <button role="tab" id="tab-release" data-mode="release" aria-selected="false" aria-controls="app" tabindex="-1">Release</button>
  </nav>
  <div class="actions">
    <button class="ghost" id="saveBtn" title="Save in this browser (logs the spec diff)">Save</button>
    <details class="menu" id="fileMenu"><summary aria-haspopup="menu">File ▾</summary>
      <div class="pop" role="menu" aria-label="File">
        <div class="mh">New from preset</div>
        <div id="presetList" role="group" aria-label="Presets"></div>
        <hr><div class="mh">Saved in this browser</div>
        <div class="mrow"><select id="mine" aria-label="Open a saved design"><option value="">My designs…</option></select><button class="ghost" id="delBtn" title="Delete the selected saved design">Delete…</button></div>
        <hr><button role="menuitem" id="importBtn">Import design JSON…<small>v1 and v2 files; every field is validated</small></button>
      </div>
    </details>
    <details class="menu" id="exportMenu"><summary aria-haspopup="menu">Export ▾</summary>
      <div class="pop" role="menu" aria-label="Export">
        <div class="mh">Prototype (print / wood)</div>
        <button role="menuitem" id="zipBtn">STL pack (.zip)<small>assembly, body, bill, slot cutter, 1:1 SVG, design JSON</small></button>
        <button role="menuitem" id="svgBtn">1:1 template (.svg)<small>side, top and flat bill pattern; print at 100 %</small></button>
        <button role="menuitem" id="jsonBtn">Design file (.json)<small>v2: spec / sim / meta, re-importable</small></button>
        <hr><div class="mh">Factory release (injection)</div>
        <button role="menuitem" data-x="pack">Release pack (.zip)<small>mold halves, drawing, tech pack, BOM, QC, costing</small></button>
        <button role="menuitem" data-x="pdf">Tech pack (.pdf)</button>
        <button role="menuitem" data-x="html">Tech pack (.html)</button>
        <button role="menuitem" data-x="svg">Drawing (.svg)</button>
        <button role="menuitem" data-x="bom">Bill of materials (.csv)</button>
      </div>
    </details>
    <input type="file" id="importFile" accept=".json,application/json" hidden aria-label="Import design JSON file">
  </div>
</header>
<div class="specstrip" id="specstrip" role="region" aria-label="Specification summary">
  <span class="chip" id="sLen" title="Body length">—</span>
  <span class="chip" id="sMass" title="Weight ready to fish (CALC)">—</span>
  <span class="chip" id="sClass" title="Buoyancy class and net buoyancy (CALC)">—</span>
  <span class="chip" id="sDive" title="Estimated dive depth on a cast (EST)">—</span>
  <span class="chip" id="sHooks" title="Hooks">—</span>
  <span class="chip" id="sBuild" title="Build mode">—</span>
  <span class="grow"></span>
  <button class="chip" id="sIssues" aria-live="polite" title="Show the checks">—</button>
</div>

<main id="app" role="tabpanel" aria-labelledby="tab-design">
  <aside id="left" aria-label="Inputs">
    <div id="controls" data-show="design analyse" role="region" aria-label="Design parameters"></div>
    <div id="simctl" data-show="simulate" role="region" aria-label="Retrieve and conditions"></div>
    <div id="relctl" data-show="release" role="region" aria-label="Identity, revision and colourway"></div>
  </aside>

  <section class="center">
    <div id="view" data-show="design analyse simulate">
      <div class="viewbar" role="toolbar" aria-label="View">
        <div class="seg" role="group" aria-label="Camera"><button id="v3d" aria-pressed="true">3D</button><button id="vSide" aria-pressed="false">Side</button><button id="vTop" aria-pressed="false">Top</button><button id="vFit" title="Fit the whole lure in the view (keeps the angle)">Fit</button></div>
        <label class="vchip" data-show="design analyse"><input type="checkbox" id="showMarkers" checked> CG / CB</label>
        <label class="vchip" data-show="design analyse"><input type="checkbox" id="showGrid" checked> Grid</label>
        <label class="vchip" data-show="design analyse"><input type="checkbox" id="xray"> X-ray</label>
      </div>
      <div id="swimInfo" data-show="simulate" role="status" hidden></div>
      <div class="toasts" id="strikeToasts" data-show="simulate" aria-live="polite" aria-label="Strike events"></div>
      <div class="transport" data-show="simulate" role="toolbar" aria-label="Swim controls">
        <button class="playbtn" id="swimBtn" aria-pressed="false" title="Swim (Space)">▶ Swim</button>
        <select id="slowmo" aria-label="Playback speed"><option value="0.2">0.2×</option><option value="0.5" selected>0.5×</option><option value="1">1× real</option></select>
        <label class="vchip" title="Underwater scene"><input type="checkbox" id="uw" checked> <span class="lt">Underwater</span><span class="st" aria-hidden="true">UW</span><span class="sr">scene</span></label>
        <label class="vchip" title="Fish active"><input type="checkbox" id="autoFish" checked> Fish<span class="sr"> active</span></label>
        <button class="ghost" id="strikeBtn" title="Force a fish to strike (game model)">Strike</button>
      </div>
      <div class="legend" data-show="design analyse" aria-hidden="true">
        <span><span class="dot" style="background:var(--red)"></span>CG</span><span><span class="dot" style="background:var(--blue)"></span>CB</span><span><span class="dot" style="background:#222"></span>tie / hangers</span><span><span class="dot" style="background:#9aa3a8"></span>ballast</span>
      </div>
    </div>
    <div class="splitter" id="splitter" data-show="design analyse simulate" role="separator" aria-orientation="horizontal" aria-label="Resize the bottom panel" aria-controls="panel" tabindex="0" aria-valuemin="160" aria-valuemax="600" aria-valuenow="250"></div>
    <div class="panel" id="panel">
      <div class="pane" id="pSide" data-show="design analyse"><h4>Side profile &amp; hook swing <span class="tagi calc">CALC</span></h4><svg id="side" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Side profile with hook swing circles"></svg></div>
      <div class="pane" id="pSim" data-show="simulate">
        <h4>Dive curve <span class="tagi est">EST</span></h4>
        <div class="simgrid">
          <svg id="dive" viewBox="0 0 640 200" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Dive curve: depth against distance"></svg>
          <div class="simres" id="simRes" aria-live="polite"></div>
        </div>
      </div>
      <div class="pane" id="pRel" data-show="release"><div class="rel" id="relRoot"></div><input type="file" id="qcFile" accept=".csv,text/csv,text/plain" hidden aria-label="Import measured tank-test CSV"></div>
    </div>
  </section>

  <aside id="stats" aria-label="Results">
    <div data-show="design">
      <div class="status" id="statusBox"><div class="big" id="stBig" aria-live="polite">—</div><div class="sub" id="stSub"></div></div>
    </div>
    <section id="checksSec" data-show="design" aria-labelledby="chkH">
      <h3 id="chkH">Checks <span class="note" id="chkCount"></span></h3>
      <div id="checks" aria-live="polite" aria-atomic="true"></div>
    </section>
    <div data-show="design">
      <h3>Performance</h3>
      <div class="taglegend"><span><span class="tagi calc">CALC</span> computed</span><span><span class="tagi est">EST</span> rule-of-thumb</span><span><span class="tagi model">MODEL</span> game model</span></div>
      <div class="kpis">
        <div class="kpi"><div class="l"><span>Total weight</span><span class="tag calc">CALC</span></div><div class="v" id="kMass">—</div><div class="s" id="kMassS">ready to fish · QC ±0.3</div></div>
        <div class="kpi"><div class="l"><span>Displacement</span><span class="tag calc">CALC</span></div><div class="v" id="kDisp">—</div><div class="s" id="kWater">fresh water</div></div>
        <div class="kpi"><div class="l"><span>Self-righting</span><span class="tag calc">CALC</span></div><div class="v" id="kStab">—</div><div class="tg" id="tStab"></div></div>
        <div class="kpi"><div class="l"><span>At rest</span><span class="tag calc">CALC</span></div><div class="v sm" id="kRest">—</div><div class="s" id="kRestS"></div></div>
        <div class="kpi"><div class="l"><span>Depth · cast</span><span class="tag est">EST</span></div><div class="v" id="kDepth">—</div><div class="tg" id="tDepth"></div></div>
        <div class="kpi"><div class="l"><span>Depth · troll</span><span class="tag est">EST</span></div><div class="v" id="kTroll">—</div><div class="s" id="kLine"></div></div>
        <div class="kpi"><div class="l"><span>On a pause</span><span class="tag est">EST</span></div><div class="v sm" id="kPause">—</div><div class="s" id="kPauseS">vertical speed</div></div>
        <div class="kpi"><div class="l"><span>Swim</span><span class="tag est">EST</span></div><div class="v sm" id="kSwim">—</div><div class="s" id="kSwimS"></div></div>
        <div class="kpi wide"><div class="l"><span>Expected action</span><span class="tag est">EST</span></div><div class="v sm" id="kAction">—</div><div class="s" id="kActionS"></div></div>
      </div>
      <p class="note">EST figures are rule-of-thumb estimates calibrated on typical floating crankbaits. Confirm them in a tank. The buoyancy maths assumes a sealed body, fully under water.</p>
    </div>

    <div data-show="analyse">
      <h3>Mass &amp; balance <span class="tagi calc">CALC</span></h3>
      <table id="massTable"></table>
      <h3>Centre of gravity / buoyancy <span class="tagi calc">CALC</span></h3>
      <table id="cgTable"></table>
      <h3>Hook clearance <span class="tagi calc">CALC</span></h3>
      <table id="hookTable"></table>
      <h3>DFM · injection mold <span class="tagi calc">CALC</span></h3>
      <ul class="checks" id="dfmList" aria-live="polite"><li class="note">Computing…</li></ul>
    </div>

    <div data-show="simulate">
      <h3>Retrieve results</h3>
      <div class="kpis">
        <div class="kpi"><div class="l"><span>Max depth</span><span class="tag est">EST</span></div><div class="v" id="sMax">—</div><div class="tg" id="sMaxT"></div></div>
        <div class="kpi"><div class="l"><span>In target zone</span><span class="tag est">EST</span></div><div class="v" id="sZone">—</div><div class="s" id="sZoneS"></div></div>
        <div class="kpi"><div class="l"><span>Reel speed</span><span class="tag calc">CALC</span></div><div class="v" id="kReel">—</div><div class="s" id="kReelS"></div></div>
        <div class="kpi"><div class="l"><span>Swim at speed</span><span class="tag est">EST</span></div><div class="v sm" id="sSwim">—</div><div class="s" id="sSwimS"></div></div>
        <div class="kpi wide"><div class="l"><span>Hook-up odds per toman strike</span><span class="tag model">MODEL</span></div><div class="v" id="kOdds">—</div><div class="s" id="kOddsS"></div></div>
      </div>
      <h3>Strike session <span class="tagi model">MODEL</span></h3>
      <p class="note" id="sessStats">No strikes yet. Press ▶ Swim (or Space), then Strike.</p>
      <ol class="slog" id="sessionLog" aria-live="polite"></ol>
      <p class="note">The fish game is an illustrative model for comparing designs (hook size, clearance, strength). It is not a catch-rate prediction.</p>
    </div>
  </aside>

  <nav class="ntabs" role="tablist" aria-label="Panels">
    <button role="tab" data-ntab="params" aria-selected="true">Params</button>
    <button role="tab" data-ntab="results" aria-selected="false">Results</button>
    <button role="tab" data-ntab="checks" aria-selected="false">Checks <span id="ntabIssues"></span></button>
  </nav>
</main>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mTitle"><div class="box">
  <h2 id="mTitle">Design JSON</h2>
  <div class="note" id="mNote"></div>
  <textarea id="mText" readonly aria-label="File contents"></textarea>
  <div class="hgroup" style="justify-content:flex-end"><button class="ghost" id="mCopy">Copy</button><button id="mClose">Close</button></div>
</div></div>
<div class="modal" id="confirmDlg" role="alertdialog" aria-modal="true" aria-labelledby="cTitle" aria-describedby="cText"><div class="box sm">
  <h2 id="cTitle">Delete design?</h2>
  <p class="note" id="cText" style="font-size:13px;color:var(--ink)"></p>
  <div class="hgroup" style="justify-content:flex-end"><button class="ghost" id="cCancel">Cancel</button><button class="danger" id="cOk">Delete</button></div>
</div></div>
<div id="toast" role="status" aria-live="polite"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script>
"use strict";
/* ============================== data ============================== */
const BODY_MATS = {
  pla:{n:'PLA (3D print)',rho:1.24}, petg:{n:'PETG (3D print)',rho:1.27}, abs:{n:'ABS (3D print)',rho:1.04},
  asa:{n:'ASA (3D print)',rho:1.07}, resin:{n:'Resin (SLA)',rho:1.15},
  jelutong:{n:'Jelutong wood',rho:0.45,wood:true}, cedar:{n:'Cedar wood',rho:0.38,wood:true}, balsa:{n:'Balsa wood',rho:0.16,wood:true}
};
const BILL_MATS = { pc:{n:'Polycarbonate',rho:1.20}, fr4:{n:'FR4 circuit board',rho:1.85}, pla:{n:'PLA (printed)',rho:1.24,printed:true}, petg:{n:'PETG (printed)',rho:1.27,printed:true} };
const BALLAST = { steel:{n:'Steel',rho:7.85}, tungsten:{n:'Tungsten',rho:19.3}, lead:{n:'Lead',rho:11.34}, brass:{n:'Brass',rho:8.5} };
const LINES = {
  pe1:{n:'PE 1 braid',f:1.15}, pe15:{n:'PE 1.5 braid',f:1.10}, pe2:{n:'PE 2 braid',f:1.05}, pe3:{n:'PE 3 braid',f:0.95},
  pe4:{n:'PE 4 braid',f:0.86}, pe5:{n:'PE 5 braid',f:0.78}, mono12:{n:'Mono 12 lb',f:0.95}, mono20:{n:'Mono 20 lb',f:0.82}
};
const WATERS = { fresh:{n:'Fresh (lake / river)',rho:1.000}, brackish:{n:'Brackish (estuary)',rho:1.012}, salt:{n:'Sea water',rho:1.025} };
const PATTERNS = {
  firetiger:{n:'Firetiger',back:'#2f6b2a',side:'#e8d21d',belly:'#ff7a1a',bars:true,headOn:false,head:'#c4161c'},
  redhead:{n:'Red head',back:'#f4f4ef',side:'#ffffff',belly:'#f2f1ea',bars:false,headOn:true,head:'#c4161c'},
  blackgold:{n:'Black gold',back:'#161616',side:'#c9a227',belly:'#eadcae',bars:false,headOn:false,head:'#c4161c'},
  chartreuse:{n:'Chartreuse shad',back:'#56751a',side:'#d6f03c',belly:'#fffbe0',bars:false,headOn:false,head:'#c4161c'},
  haruan:{n:'Haruan natural',back:'#33321f',side:'#7a6d4e',belly:'#d8cfb5',bars:true,headOn:false,head:'#c4161c'},
  ghost:{n:'Ghost white',back:'#dcd9cf',side:'#f6f4ee',belly:'#ffffff',bars:false,headOn:false,head:'#c4161c'}
};
// hook data: weight (g) for a 3X-strong treble, overall length (mm) eye→bend
const HOOKS = { '6':{m:0.50,l:15}, '4':{m:0.72,l:18}, '2':{m:1.10,l:22}, '1':{m:1.45,l:25}, '1/0':{m:1.90,l:28}, '2/0':{m:2.45,l:32} };
const HSIZES = [['6','#6'],['4','#4'],['2','#2'],['1','#1'],['1/0','1/0'],['2/0','2/0'],['none','None']];
const HSTR = { std:{n:'Standard wire',f:0.75}, x2:{n:'2X strong',f:0.88}, x3:{n:'3X strong',f:1.0}, x4:{n:'4X strong',f:1.12} };
const HTYPE = { treble:{n:'Treble',f:1.0}, single:{n:'Inline single',f:0.5} };
const RINGS = { '3':{n:'#3 (6 mm)',m:0.12,d:6}, '4':{n:'#4 (7 mm)',m:0.20,d:7}, '5':{n:'#5 (8 mm)',m:0.35,d:8}, '6':{n:'#6 (9.5 mm)',m:0.50,d:9.5} };
function hookInfo(p,size){
  if(size==='none'||!HOOKS[size]) return null;
  const h=HOOKS[size], ring=RINGS[p.ring]||RINGS['5'];
  const mHook=h.m*HSTR[p.hookStr].f*HTYPE[p.hookType].f;
  return {size, l:h.l, gap:h.l*0.42, ringD:ring.d, m:mHook+ring.m, r:ring.d+h.l, label:`${size.includes('/')?size:'#'+size} ${p.hookType==='single'?'single':'treble'}`};
}
